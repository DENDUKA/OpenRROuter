# PostgreSQL password for the local postgres container
POSTGRES_PASSWORD=postgres
S2S_API_GATEWAY_TOKEN=dev-s2s-token-gateway-CHANGE-ME
S2S_WEBAPP_TOKEN=dev-s2s-token-webapp-CHANGE-ME

# Initial admin credentials (AuthService seeds on first start if configured)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=StrongPassword123!
