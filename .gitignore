# --- .NET ---
bin/
obj/
e2e.local.json
.dotnet/
.nuget/
.appdata/
.userprofile/
.msbuild/
NuGet/
**/NuGet/
*.binlog
*.log
TestResults/

# Per-developer VS/Rider state (active debug profile, *.sln.DotSettings.user и т.п.).
*.user
*.suo

# Вывод dotnet publish, если кто-то соберёт его внутрь дерева.
publish/
*.nupkg

# --- Playwright (tests/OpenRussiaRouter.E2ETests) ---
# E2E opt-in, но прогон оставляет отчёты и трейсы рядом с тестами.
playwright-report/
playwright/.cache/
test-results/
.playwright/

# --- Node / docs-site (VitePress) ---
# docs-site — единственный npm-проект в репозитории. Всё ниже пересоздаётся
# `npm install` / `npm run docs:build`, а образ доков и так собирается из исходников
# (docs-site/Dockerfile), поэтому в git ничего из этого не нужно.
# `**/` обязателен: шаблон со слэшем внутри якорится к каталогу самого .gitignore,
# то есть голый `.vitepress/dist/` закрыл бы только корневой путь, а не docs-site/.
node_modules/
**/.vitepress/dist/
**/.vitepress/cache/
**/.vitepress/.temp/

# --- Секреты и локальные оверрайды ---
# `.env.example` намеренно НЕ подпадает: игнорируется только точное имя `.env`.
# Общего `*.local.json` здесь нет умышленно — под него попадает отслеживаемый
# `.claude/settings.local.json`. Локальные конфиги перечисляем поимённо (см. e2e.local.json выше).
.env
.env.local

# --- IDE / редакторы ---
# Без ведущего слэша — чтобы ловились и во вложенных каталогах, а не только в корне.
.vs/
.idea/
/.kilo
/.claude/worktrees

# --- Прочее ---
/graphify-out/cache
/src/graphify-out/cache
/tools

# --- Мусор от merge/rebase и редакторские бэкапы ---
*.orig
*.rej
*.bak
*~

# --- OS ---
.DS_Store
Thumbs.db
