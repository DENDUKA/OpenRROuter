# Copy to .env next to compose.yml and fill in. NEVER commit the real .env.
# Generate strong values, e.g.:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-32
#                                openssl rand -hex 24

# ==== OpenRussiaRouter (.NET stack) ====
POSTGRES_PASSWORD=
S2S_API_GATEWAY_TOKEN=
S2S_WEBAPP_TOKEN=

# NOTE: AuthService does NOT read these — the only admin is admin@example.com,
# seeded by migration auth/002_seed_default_admin.sql (default pass StrongPassword123!).
# Kept here only as documentation of the intended admin identity.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# Control token: ControlPlane <-> f9router node registration (same value both sides)
ORR_NODE_CONTROL_TOKEN=

# ==== f9router (Inc64/F9Router fork) ====
F9_JWT_SECRET=
F9_INITIAL_PASSWORD=
F9_API_KEY_SECRET=
F9_MACHINE_ID_SALT=
# Public origin the f9router dashboard/cookies use. For IP-only dev over HTTP:
#   http://<server-ip>:20128 . For a domain behind TLS: https://router.example.com
F9_PUBLIC_URL=http://localhost:20128

# ==== Seq (logs) ====
SEQ_ADMIN_PASSWORD=

# ==== Email (Brevo SMTP) ====
# SMTP login shown on Brevo's SMTP page (e.g. a734bb001@smtp-brevo.com) — NOT your account
# email. Password = a Brevo *SMTP key* (Transactional -> Email -> SMTP -> Generate a new SMTP
# key), shared with the VPN bot for now. Leave blank to disable sending (app still runs).
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
# Transport: leave blank/"smtp" where outbound SMTP works (e.g. dev box). Set "brevoApi" on
# hosts that block outbound SMTP ports (the prod box blocks 25/465/587/2525) — then mail goes
# via Brevo's HTTP API over 443 and needs BREVO_API_KEY (Brevo -> SMTP & API -> API Keys,
# format xkeysib-… — NOT the SMTP key above).
EMAIL_TRANSPORT=
BREVO_API_KEY=

# ==== Public domain / TLS (prod only — Caddy reverse proxy; compose.prod.yml) ====
# Apex domain with an A record → this host. Caddy gets a Let's Encrypt cert for it.
# Required by compose.prod.yml; unused by the dev compose.yml.
ORR_PUBLIC_DOMAIN=
# Let's Encrypt account email (cert-expiry notices). Falls back to a default if blank.
ACME_EMAIL=

# ==== Payments (Rollypay СБП — prod only) ====
# Fill ApiKey + SigningSecret from the касса UI (Интеграция), register the webhook
# https://<ORR_PUBLIC_DOMAIN>/webhook/rollypay there, THEN set PAYMENTS_ACTIVE_PROVIDER=rollypay.
# Blank ActiveProvider = payments disabled (fail-safe: outbound calls throw, webhooks 401).
PAYMENTS_ACTIVE_PROVIDER=
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
# Sandbox: same касса and same keys, `test: true` on every payment — stub СБП, no money moves,
# webhooks still fire and are signed normally. Leave false here: a test payment costs nothing but
# is still credited as real balance, so the WebApp refuses to start with it on in Production.
ROLLYPAY_TEST_MODE=false

# ==== Product analytics (prod compose; auth-service + billing-service) ====
# HMAC pepper used to pseudonymize distinct_id. MUST stay stable for a given box across
# restarts — rotating it invalidates every existing pseudonym and orphans the funnels.
# Generate once per box:  openssl rand -hex 32
PRODUCT_ANALYTICS_IDENTITY_SALT=

# ==== Monitoring (prod compose; Prometheus + Grafana) ====
# Both bind to 127.0.0.1 only — reach Grafana over an SSH tunnel:
#   ssh -i .deploy/orr_prod_vps_access -L 3001:127.0.0.1:3001 root@<host>  ->  http://localhost:3001
# Grafana holds read access to the billing DB; never publish it on 0.0.0.0.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ==== Grafana alerting → email relay (prod compose) ====
# Grafana can't send email directly here (outbound SMTP is blocked), so alerts POST to the
# WebApp's /internal/alerts/grafana, which relays over Brevo's HTTP API. This token gates that
# endpoint and is shared between the grafana contact point and the WebApp. Generate once:
#   openssl rand -hex 24
ALERT_WEBHOOK_TOKEN=
# Where alert emails are delivered.
ALERT_EMAIL_TO=orrouter@gmail.com
