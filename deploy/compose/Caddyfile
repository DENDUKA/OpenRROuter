# Caddyfile — reverse proxy + automatic HTTPS for the ORR prod box (201.51.6.246).
# deploy-prod.sh / update-prod.sh copy this to /opt/orr/Caddyfile next to compose.yml.
# Domain + ACME email come from /opt/orr/.env (see .env.example) via the caddy service:
#
#   RWT_PUBLIC_DOMAIN   apex domain, A record → 201.51.6.246
#   ACME_EMAIL          Let's Encrypt account email (expiry notices)
#
# Caddy obtains + renews Let's Encrypt certs automatically; they persist in the caddy_data
# volume. Ports 80 and 443 must be reachable (Docker publishes them, bypassing ufw), and the
# domain MUST resolve to this box BEFORE first start (ACME HTTP-01 challenge needs both).
{
	email {$ACME_EMAIL:nusferatus64@gmail.com}
}

# User cabinet + admin + payment webhook (POST /webhook/rollypay).
# Grafana dashboards are served under /grafana/ — the @grafana matcher routes those
# requests to grafana:3000 (running with GF_SERVER_SERVE_FROM_SUB_PATH=true so it
# generates correct self-referential URLs). Anything else falls through to webapp.
{$RWT_PUBLIC_DOMAIN} {
	encode zstd gzip

	@grafana path /grafana /grafana/*
	reverse_proxy @grafana grafana:3000

	# VitePress-документация — https://rawrter.com/docs/.
	# docs-контейнер собран с base='/docs/' и держит файлы в /usr/share/nginx/html/docs,
	# поэтому префикс /docs НЕ-strip'ается: nginx разрешает URI как есть.
	@docs path /docs /docs/*
	reverse_proxy @docs docs:80

	reverse_proxy webapp:8080
}

# Typo-guard alt domain → 301 to the canonical domain (path + query preserved).
# Caddy auto-provisions a Let's Encrypt cert for these names too.
openrussianrouter.com, www.openrussianrouter.com, openrussiarouter.com, www.openrussiarouter.com {
	redir https://rawrter.com{uri} permanent
}

# OpenAI-compatible LLM API. The hostname is a LITERAL and deliberately still on the OLD
# domain: every customer has https://api.openrussiarouter.com baked into their client's
# base_url, so the API surface did not move with the 2026-08 site rename (RNM-002).
# Do NOT write api.{$RWT_PUBLIC_DOMAIN} here — that resolves to api.rawrter.com, leaves the
# real API hostname without a site block at all, and kills every customer integration on the
# next deploy. Do NOT add api.rawrter.com either: it has no A record, so Caddy would
# fail-loop on ACME HTTP-01 for a name that is not supposed to exist.
# Requires the A record api.openrussiarouter.com → 201.51.6.246 (added 2026-06-24).
api.openrussiarouter.com {
	encode zstd gzip
	reverse_proxy api-gateway:8080
}
