# Caddyfile — reverse proxy + automatic HTTPS for the ORR prod box (201.51.6.246).
# deploy-prod.sh / update-prod.sh copy this to /opt/orr/Caddyfile next to compose.yml.
# Domain + ACME email come from /opt/orr/.env (see .env.example) via the caddy service:
#
#   RWT_PUBLIC_DOMAIN   apex domain, A record → 201.51.6.246
#   ACME_EMAIL          Let's Encrypt account email (expiry notices)
#
# Caddy obtains + renews Let's Encrypt certs automatically; they persist in the caddy_data
# volume. Ports 80 and 443 must be reachable (Docker publishes them, bypassing ufw), and the
# domain MUST resolve to this box BEFORE first start (ACME HTTP-01 challenge needs both).
{
	email {$ACME_EMAIL:nusferatus64@gmail.com}
}

# User cabinet + admin + payment webhook (POST /webhook/rollypay).
# Grafana dashboards are served under /grafana/ — the @grafana matcher routes those
# requests to grafana:3000 (running with GF_SERVER_SERVE_FROM_SUB_PATH=true so it
# generates correct self-referential URLs). Anything else falls through to webapp.
{$RWT_PUBLIC_DOMAIN} {
	encode zstd gzip

	@grafana path /grafana /grafana/*
	reverse_proxy @grafana grafana:3000

	# VitePress-документация — https://rawrter.com/docs/.
	# docs-контейнер собран с base='/docs/' и держит файлы в /usr/share/nginx/html/docs,
	# поэтому префикс /docs НЕ-strip'ается: nginx разрешает URI как есть.
	@docs path /docs /docs/*
	reverse_proxy @docs docs:80

	reverse_proxy webapp:8080
}

# Everything that is not the canonical apex → 301 to it (path + query preserved): the
# pre-rename domain and its www, the typo-guard domain and its www, and the canonical
# domain's own www. Caddy auto-provisions a Let's Encrypt cert for each of these names,
# so every name listed here needs an A record → 201.51.6.246; a name with an A record but
# NOT listed here is worse than either (it resolves to the box and then fails the TLS
# handshake, because Caddy has no certificate for a host it does not serve).
# Keep the openrussiarouter redirects: Search Console / Вебмастер "change of address"
# needs live 301s, and dropping them throws away the indexed history.
www.rawrter.com, openrussianrouter.com, www.openrussianrouter.com, openrussiarouter.com, www.openrussiarouter.com {
	redir https://rawrter.com{uri} permanent
}

# OpenAI-compatible LLM API, served on BOTH hostnames. Both are LITERALS on purpose.
#
# api.openrussiarouter.com is the contract: every customer has it baked into their client's
# base_url, so the API surface did not move with the 2026-08 site rename (RNM-002) and this
# name must never be dropped. api.rawrter.com is the brand-aligned alias — documentation and
# examples print the rawrter one since RNM-007, but legacy clients keep using the old name.
#
# Do NOT collapse either into api.{$RWT_PUBLIC_DOMAIN}: that expands to the rawrter name only
# and leaves the contract hostname without a site block at all, killing every customer
# integration on the next deploy.
#
# Each name needs its own A record → 201.51.6.246 before Caddy can complete the ACME HTTP-01
# challenge (api.openrussiarouter.com since 2026-06-24, api.rawrter.com since 2026-08-14);
# adding a name here without the record makes Caddy fail-loop on cert issuance for it.
api.openrussiarouter.com, api.rawrter.com {
	encode zstd gzip
	reverse_proxy api-gateway:8080
}
