{
  "ConnectionStrings": {
    "GatewayDb": "Host=localhost;Port=5432;Database=orr_gateway;Username=orr;Password=orr"
  },
  "GrpcServices": {
    "CallDeadlineSeconds": 30
  },
  "ServiceAuth": {
    "BillingCaller": "apigateway",
    "BillingToken": "test-s2s-token-12345"
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
