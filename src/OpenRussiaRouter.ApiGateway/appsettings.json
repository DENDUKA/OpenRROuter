{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UsageOutbox": {
    "Enabled": true,
    "BatchSize": 50,
    "PollIntervalSeconds": 5,
    "BaseBackoffSeconds": 2,
    "MaxBackoffSeconds": 300,
    "MaxAttempts": 20
  },
  "AllowedHosts": "*"
}
