    "BatchSize": 50,
    "PollInterval": "00:00:02",
    "MaxAttempts": 10,
    "BaseBackoff": "00:00:05",
    "LeaseDuration": "00:01:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
