{
  "GrpcServices": {
    "CallDeadlineSeconds": 30
  },
  "ServiceAuth": {
    "BillingCaller": "apigateway",
    "BillingToken": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
