{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BillingDb": "Pooling=true;MinPoolSize=5;MaxPoolSize=50;Connection Idle Lifetime=300"
  },
  "Payments": {
    "MinTopUpUsd": 1.0,
    "MaxTopUpUsd": 10000.0,
    "AutoReverseChargeback": false
  },
  "ExchangeRates": {
    "Source": "cbr",
    "MarkupPercent": 0,
    "Fallback": {
      "RubPerUsd": 95.0,
      "RubPerEur": 103.0
    }
  },
  "ServiceAuth": {
    "Tokens": {
      "apigateway": "",
      "webappadmin": ""
    },
    "MethodPolicies": {
      "RecordUsage": [ "apigateway" ],
      "CreateVirtualTopUp": [ "webappadmin" ],
      "UpsertApiKeyLimitSettings": [ "webappadmin" ],
      "UpsertModelPrice": [ "webappadmin" ],
      "UpsertModels": [ "webappadmin" ],
      "UpsertTag": [ "webappadmin" ],
      "DeleteTag": [ "webappadmin" ],
      "CreatePayment": [ "webappadmin" ],
      "AttachProviderRef": [ "webappadmin" ],
      "ConfirmPaymentByProvider": [ "webappadmin" ],
      "ApplyPaymentEvent": [ "webappadmin" ],
      "AcquireStalePayments": [ "webappadmin" ],
      "UpsertModelProvider": [ "webappadmin" ],
      "DeleteModelProvider": [ "webappadmin" ],
      "GrantStartBalance": [ "webappadmin" ],
      "GrantFirstTopUpBonus": [ "webappadmin" ],
      "SetPlatformSetting": [ "webappadmin" ]
    }
  },
  "ProductAnalytics": {
    "Enabled": false,
    "Provider": "Postgres",
    "HostUrl": "",
    "ProjectToken": "",
    "ConnectionString": "",
    "IdentitySalt": "",
    "Environment": "production",
    "QueueCapacity": 10000,
    "BatchSize": 100
  },
  "SiteVisits": {
    "Compaction": {
      "Enabled": true,
      "IntervalMinutes": 5,
      "SessionGapMinutes": 30,
      "SafetyLagMinutes": 5,
      "VisitorBatchSize": 500,
      "MaxIterationsPerRun": 20,
      "MaxPagesPerSession": 200,
      "SplitOnUtcDayBoundary": true
    }
  },
  "AllowedHosts": "*"
}
