{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5005",
        "Protocols": "Http2"
      }
    }
  },
  "GrpcServices": {
    "ControlPlane": "http://localhost:5003",
    "CallDeadlineSeconds": 30
  },
  "Collector": {
    "NodePollInterval": "00:01:00",
    "NodeListRefreshInterval": "00:01:00",
    "PerNodeTimeout": "00:00:10"
  }
}
