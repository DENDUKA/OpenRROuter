{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GrpcServices": {
    "Billing": "http://localhost:5002",
    "ControlPlane": "http://localhost:5003",
    "CallDeadlineSeconds": 30
  },
  "Collector": {
    "NodePollInterval": "00:01:00",
    "NodeListRefreshInterval": "00:01:00",
    "ActiveModelsRefreshInterval": "00:05:00",
    "PerNodeTimeout": "00:00:10"
  },
  "OpenRouter": {
    "Enabled": true,
    "BaseUrl": "https://openrouter.ai/",
    "RefreshInterval": "00:30:00"
  }
}
