{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ContentLimits": {
    "MaxLogoBytes": 262144,
    "MaxImageBytes": 1048576,
    "MaxImagesPerTool": 30,
    "MaxMarkdownChars": 65536,
    "MaxTaglineChars": 300
  },
  "ServiceAuth": {
    "Tokens": {
      "webappadmin": ""
    },
    "MethodPolicies": {
      "ListToolsForAdmin": [ "webappadmin" ],
      "GetToolForAdmin": [ "webappadmin" ],
      "UpsertTool": [ "webappadmin" ],
      "DeleteTool": [ "webappadmin" ],
      "SetToolPublished": [ "webappadmin" ],
      "ListToolImages": [ "webappadmin" ],
      "UploadToolImage": [ "webappadmin" ],
      "DeleteToolImage": [ "webappadmin" ],
      "UpsertToolCategory": [ "webappadmin" ],
      "DeleteToolCategory": [ "webappadmin" ]
    }
  },
  "ConnectionStrings": {
    "ContentDb": "Pooling=true;MinPoolSize=5;MaxPoolSize=50;Connection Idle Lifetime=300"
  },
  "AllowedHosts": "*"
}
