{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RouterHealthChecks": {
    "Enabled": true,
    "Interval": "00:00:30",
    "Timeout": "00:00:05",
    "HealthPath": "/healthz",
    "NodeTokenHeader": "X-ORR-Node-Token",
    "NodeTokens": {}
  },
  "RouterNodeProviderCache": {
    "Enabled": true,
    "Ttl": "00:00:30"
  },
  "RouterLeaseCleanup": {
    "Enabled": true,
    "Interval": "00:00:30"
  },
  "ConnectionStrings": {
    "ControlPlaneDb": ""
  }
}
