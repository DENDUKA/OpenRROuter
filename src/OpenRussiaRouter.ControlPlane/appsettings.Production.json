{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "OpenRussiaRouter": "Information"
    }
  },
  "DetailedErrors": false,
  "RouterHealthChecks": {
    "Interval": "00:01:00",
    "Timeout": "00:00:10"
  },
  "RouterNodeProviderCache": {
    "Enabled": true,
    "Ttl": "00:00:30"
  },
  "RouterLeaseCleanup": {
    "Interval": "00:01:00"
  }
}
