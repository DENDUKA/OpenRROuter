{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RouterHealthChecks": {
    "Enabled": true,
    "Interval": "00:00:30",
    "Timeout": "00:00:05",
    "HealthPath": "/healthz",
    "NodeTokenHeader": "X-ORR-Node-Token",
    "NodeTokens": {}
  },
  "RouterLeaseCleanup": {
    "Enabled": true,
    "Interval": "00:00:30"
  },
  "ConnectionStrings": {
    "ControlPlaneDb": "Pooling=true;MinPoolSize=5;MaxPoolSize=50;ConnectionIdleTimeout=300"
  },
  "GrpcServices": {
    "Auth": "http://localhost:5001"
  },
  "AllowedHosts": "*"
}
