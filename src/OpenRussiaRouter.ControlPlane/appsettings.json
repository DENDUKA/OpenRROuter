{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RouterHealthChecks": {
    "Enabled": true,
    "Interval": "00:00:30",
    "Timeout": "00:00:05",
    "HealthPath": "/healthz",
    "NodeTokenHeader": "X-ORR-Node-Token"
  },
  "RouterNodeProviderCache": {
    "Enabled": true,
    "Ttl": "00:00:30"
  },
  "RouterLeaseCleanup": {
    "Enabled": true,
    "Interval": "00:00:30"
  },
  "GrpcServices": {
    "Collector": "http://localhost:5005"
  },
  "CapabilityReplica": {
    "Enabled": true,
    "RefreshInterval": "00:01:00"
  },
  "ConnectionStrings": {
    "ControlPlaneDb": "Pooling=true;MinPoolSize=5;MaxPoolSize=50;ConnectionIdleTimeout=300"
  },
"AllowedHosts": "*"
}
