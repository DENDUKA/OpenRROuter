@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject ISessionStorage SessionStorage

<div class="app-shell @(_hideNav ? "app-shell--no-sidebar" : "")">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="topbar">
        <a href="" class="topbar-brand">
            <span class="logo-mark">9R</span>
            <span class="topbar-brand-name">OpenRussiaRouter</span>
        </a>

        <nav class="topbar-nav" aria-label="Product navigation">
            <NavLink class="topbar-link" href="models">Models</NavLink>
            <a class="topbar-link" href="/pricing">Pricing</a>
            <a class="topbar-link" href="/docs">Docs</a>
        </nav>

        <div class="topbar-actions">
            @if (AuthState.IsAuthenticated)
            {
                <div class="user-menu @(_menuOpen ? "user-menu--open" : "")">
                    @if (_menuOpen)
                    {
                        <div class="dropdown-backdrop" @onclick="CloseMenu" aria-hidden="true"></div>
                    }
                    <button class="user-menu-trigger" @onclick="ToggleMenu"
                            aria-expanded="@_menuOpen" aria-haspopup="menu">
                        <span class="user-avatar">@_avatarLetter</span>
                        <span class="user-display-name">@_displayName</span>
                        <svg class="user-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                    @if (_menuOpen)
                    {
                        <div class="user-dropdown" role="menu">
                            <NavLink class="dropdown-item" href="workspace" role="menuitem" @onclick="CloseMenu">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                                    <rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                                    <rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                                    <rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                                </svg>
                                Workspace
                            </NavLink>
                            <div class="dropdown-separator" role="separator"></div>
                            <NavLink class="dropdown-item" href="cabinet/usage" role="menuitem" @onclick="CloseMenu">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M2 12V8M6 12V5M10 12V9M14 12V3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                Activity
                            </NavLink>
                            <NavLink class="dropdown-item" href="cabinet/logs" role="menuitem" @onclick="CloseMenu">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M2 4h12M2 8h8M2 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                Logs
                            </NavLink>
                            <NavLink class="dropdown-item" href="cabinet/settings" role="menuitem" @onclick="CloseMenu">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M8 10a2 2 0 100-4 2 2 0 000 4z" stroke="currentColor" stroke-width="1.5" />
                                    <path d="M13.3 6.7l-.9-.2a5.1 5.1 0 00-.4-.9l.5-.8a.6.6 0 00-.1-.8L11.1 3.5a.6.6 0 00-.8-.1l-.8.5a5.1 5.1 0 00-.9-.4l-.2-.9A.6.6 0 008 2H7.4a.6.6 0 00-.6.5l-.2.9a5.1 5.1 0 00-.9.4l-.8-.5a.6.6 0 00-.8.1L3.6 4.7a.6.6 0 00-.1.8l.5.8c-.2.3-.3.6-.4.9l-.9.2A.6.6 0 002 8v.7c0 .3.2.5.5.6l.9.2c.1.3.2.6.4.9l-.5.8a.6.6 0 00.1.8l1.3 1.3c.2.2.6.2.8.1l.8-.5c.3.2.6.3.9.4l.2.9c.1.3.3.5.6.5H8.6c.3 0 .5-.2.6-.5l.2-.9c.3-.1.6-.2.9-.4l.8.5c.2.2.6.1.8-.1l1.3-1.3a.6.6 0 00.1-.8l-.5-.8c.2-.3.3-.6.4-.9l.9-.2c.3-.1.5-.3.5-.6V8a.6.6 0 00-.5-.6z" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                                Settings
                            </NavLink>
                            <div class="dropdown-separator" role="separator"></div>
                            <NavLink class="dropdown-item dropdown-item--danger" href="logout" role="menuitem">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M6 14H3a1 1 0 01-1-1V3a1 1 0 011-1h3M10 11l3-3-3-3M13 8H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Exit
                            </NavLink>
                        </div>
                    }
                </div>
            }
            else
            {
                <NavLink class="topbar-link" href="login" Match="NavLinkMatch.All">Login</NavLink>
            }
        </div>
    </header>

    @if (!_hideNav)
    {
        <NavMenu />
    }

    <main class="main-pane" id="main-content" tabindex="-1">
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">×</button>
</div>

@code {
    private bool _menuOpen;
    private bool _hideNav;

    private string _displayName => AuthState.CurrentSession?.DisplayName ?? "User";
    private string _avatarLetter => _displayName.Length > 0 ? _displayName[0].ToString().ToUpper() : "U";

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private bool IsNavHidden() => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("workspace", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionStorage.LoadSessionAsync();
        if (session is not null) AuthState.SetSession(session);

        _hideNav = IsNavHidden();
        AuthState.SessionChanged += OnSessionChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnSessionChanged()
    {
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _menuOpen = false;
        _hideNav = IsNavHidden();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthState.SessionChanged -= OnSessionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
