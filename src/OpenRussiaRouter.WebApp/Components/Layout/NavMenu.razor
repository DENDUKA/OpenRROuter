@inject AuthState AuthState
@inject NavigationManager Navigation

<div class="nav-header">
    <span class="nav-wordmark">OPENCODE</span>
</div>

<input type="checkbox" title="Navigation menu" class="nav-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.nav-toggler').click()">
    <nav class="nav-menu">
        <div class="nav-section-label">[+] Pages</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span aria-hidden="true">[+]</span> Home
            </NavLink>
        </div>

        @if (AuthState.IsAuthenticated)
        {
            @if (AuthState.CurrentSession?.IsAdmin == true)
            {
                <div class="nav-section-label">[-] Admin</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                        <span aria-hidden="true">[+]</span> Dashboard
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/users">
                        <span aria-hidden="true">[+]</span> Users
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/nodes">
                        <span aria-hidden="true">[+]</span> Router Nodes
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/models">
                        <span aria-hidden="true">[+]</span> Models
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/anomalies">
                        <span aria-hidden="true">[+]</span> Anomalies
                    </NavLink>
                </div>
            }
            else
            {
                <div class="nav-section-label">[-] Cabinet</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="cabinet" Match="NavLinkMatch.All">
                        <span aria-hidden="true">[+]</span> Account
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="cabinet/keys">
                        <span aria-hidden="true">[+]</span> API Keys
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="cabinet/usage">
                        <span aria-hidden="true">[+]</span> Usage
                    </NavLink>
                </div>
            }

            <div class="nav-divider"></div>

            <div class="nav-item">
                <NavLink class="nav-link" href="logout">
                    <span aria-hidden="true">[x]</span> Logout
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-section-label">[-] Auth</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="login">
                    <span aria-hidden="true">[+]</span> Login
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="invite/demo">
                    <span aria-hidden="true">[+]</span> Register
                </NavLink>
            </div>
        }

        <div class="nav-divider"></div>

        <div class="nav-section-label">[*] Links</div>

        <div class="nav-item">
            <a class="nav-link" href="https://github.com" target="_blank">
                <span aria-hidden="true">[^]</span> GitHub
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/docs">
                <span aria-hidden="true">[?]</span> Docs
            </a>
        </div>
    </nav>
</div>