@inject AuthState AuthState
@inject NavigationManager Navigation

<div class="nav-header">
    <a href="" class="nav-wordmark">OPENCODE</a>

    <div class="nav-links">
        @if (AuthState.IsAuthenticated)
        {
            @if (AuthState.CurrentSession?.IsAdmin == true)
            {
                <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink class="nav-link" href="admin/users">Users</NavLink>
                <NavLink class="nav-link" href="admin/nodes">Nodes</NavLink>
                <NavLink class="nav-link" href="admin/models">Models</NavLink>
                <NavLink class="nav-link" href="admin/anomalies">Anomalies</NavLink>
            }
            else
            {
                <NavLink class="nav-link" href="cabinet" Match="NavLinkMatch.All">Account</NavLink>
                <NavLink class="nav-link" href="cabinet/keys">API Keys</NavLink>
                <NavLink class="nav-link" href="cabinet/usage">Usage</NavLink>
            }

            <div class="nav-divider"></div>

            <NavLink class="btn btn-sm btn-outline-on-dark" href="logout">Logout</NavLink>
        }
        else
        {
            <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">Login</NavLink>
            <NavLink class="btn btn-sm btn-primary" href="invite/demo">Register</NavLink>
        }
    </div>
</div>