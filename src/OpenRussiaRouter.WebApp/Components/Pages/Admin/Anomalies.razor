@page "/admin/anomalies"
@inject BillingClient BillingClient
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject ISessionStorage SessionStorage

<PageTitle>Billing Anomalies - OpenRussiaRouter Admin</PageTitle>

<div class="page-header">
    <div class="header-label">Admin</div>
    <h1>Billing Anomalies</h1>
</div>

<div class="content">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ErrorMessage
        </div>
    }

    <div class="panel">
        <div class="panel-header">
            All Anomalies
        </div>
        <div class="panel-body">
            @if (AnomalyList is null)
            {
                <p>Loading...</p>
            }
            else if (AnomalyList.Count == 0)
            {
                <p class="text-muted">No anomalies detected.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Request ID</th>
                            <th>Type</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var anomaly in AnomalyList)
                        {
                            <tr>
                                <td>@anomaly.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td><small>@anomaly.RequestId</small></td>
                                <td><span class="badge badge-warning">@anomaly.Type</span></td>
                                <td>@anomaly.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-section);
    }

    .header-label {
        font-size: 14px;
        color: var(--color-mute);
        margin-bottom: var(--spacing-sm);
    }

    .content {
        max-width: 960px;
    }

    .panel {
        border: 1px solid var(--color-hairline);
    }

    .panel-header {
        padding: var(--spacing-md) 0;
        border-bottom: 1px solid var(--color-hairline);
        font-size: 16px;
        font-weight: 700;
    }

    .panel-body {
        padding: var(--spacing-lg) 0;
    }

    .panel-marker {
        color: var(--color-mute);
        margin-right: var(--spacing-sm);
    }
</style>

@code {
    private IReadOnlyList<AnomalyInfo>? AnomalyList { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionStorage.LoadSessionAsync();
        if (session is not null)
        {
            AuthState.SetSession(session);
        }

        if (!AuthState.IsAuthenticated || AuthState.CurrentSession?.IsAdmin != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadAnomalies();
    }

    private async Task LoadAnomalies()
    {
        try
        {
            AnomalyList = await BillingClient.ListAnomaliesAsync();
        }
        catch
        {
            ErrorMessage = "Failed to load anomalies.";
        }
    }
}
