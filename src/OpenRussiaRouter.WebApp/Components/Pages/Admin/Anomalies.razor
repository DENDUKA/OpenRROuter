@page "/admin/anomalies"
@layout AdminLayout
@inject BillingClient BillingClient
@inject AuthState AuthState

<PageTitle>Anomalies - Admin</PageTitle>

<div class="adm-section-head">
    <h2>Anomalies</h2>
    <p>Review suspicious usage and operational anomalies.</p>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="adm-card">
    <div class="adm-card-header">All Anomalies</div>
    <div class="adm-card-body">
        @if (_anomalies is null)
        {
            <p class="text-muted">Loading…</p>
        }
        else if (_anomalies.Count == 0)
        {
            <p class="text-muted">No anomalies detected.</p>
        }
        else
        {
            <table class="table">
                <thead><tr>
                    <th>Date</th><th>Request ID</th><th>Type</th><th>Message</th>
                </tr></thead>
                <tbody>
                    @foreach (var anomaly in _anomalies)
                    {
                        <tr>
                            <td>@anomaly.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td><small>@anomaly.RequestId</small></td>
                            <td><span class="badge badge-warning">@anomaly.Type</span></td>
                            <td>@anomaly.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IReadOnlyList<AnomalyInfo>? _anomalies;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _anomalies = await BillingClient.ListAnomaliesAsync(); }
        catch { _error = "Failed to load anomalies."; }
    }
}
