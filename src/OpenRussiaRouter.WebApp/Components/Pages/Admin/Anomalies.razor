@page "/admin/anomalies"
@inject BillingClient BillingClient
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Billing Anomalies - OpenRussiaRouter Admin</PageTitle>

<h1>Billing Anomalies</h1>

<div class="row mt-4">
    <div class="col-md-10">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @ErrorMessage
            </div>
        }

        <div class="card">
            <div class="card-header">
                <span>All Anomalies</span>
            </div>
            <div class="card-body">
                @if (AnomalyList is null)
                {
                    <p>Loading...</p>
                }
                else if (AnomalyList.Count == 0)
                {
                    <p class="text-muted">No anomalies detected.</p>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Request ID</th>
                                <th>Type</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var anomaly in AnomalyList)
                            {
                                <tr>
                                    <td>@anomaly.CreatedAt.ToLocalTime().ToString("g")</td>
                                    <td><small>@anomaly.RequestId</small></td>
                                    <td><span class="badge bg-warning">@anomaly.Type</span></td>
                                    <td>@anomaly.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<AnomalyInfo>? AnomalyList { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated || AuthState.CurrentSession?.IsAdmin != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadAnomalies();
    }

    private async Task LoadAnomalies()
    {
        try
        {
            AnomalyList = await BillingClient.ListAnomaliesAsync();
        }
        catch
        {
            ErrorMessage = "Failed to load anomalies.";
        }
    }
}