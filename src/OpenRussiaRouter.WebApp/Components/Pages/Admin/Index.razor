@page "/admin"
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject ISessionStorage SessionStorage

<PageTitle>Admin Dashboard - OpenRussiaRouter</PageTitle>

<h1>Admin Dashboard</h1>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Admin Account</div>
            <div class="card-body">
                <p><strong>User ID:</strong> @AuthState.CurrentSession?.UserId</p>
                <p><strong>Role:</strong> @AuthState.CurrentSession?.Role</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Users</div>
            <div class="card-body">
                <p class="text-muted">Manage application users and roles.</p>
                <a class="btn btn-primary" href="/admin/users">Open Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Router Nodes</div>
            <div class="card-body">
                <p class="text-muted">Manage OpenRussiaRouter nodes.</p>
                <a class="btn btn-primary" href="/admin/nodes">Open Router Nodes</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Models</div>
            <div class="card-body">
                <p class="text-muted">Manage model catalog and routing metadata.</p>
                <a class="btn btn-primary" href="/admin/models">Open Models</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Anomalies</div>
            <div class="card-body">
                <p class="text-muted">Review suspicious usage and operational anomalies.</p>
                <a class="btn btn-primary" href="/admin/anomalies">Open Anomalies</a>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            var session = await SessionStorage.LoadSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                AuthState.SetSession(session);
            }
        }
    }
}
