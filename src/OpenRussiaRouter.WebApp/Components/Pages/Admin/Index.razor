@page "/admin"
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject SessionStorage SessionStorage

<PageTitle>Admin Dashboard - OpenRussiaRouter</PageTitle>

<h1>Admin Dashboard</h1>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Admin Account</div>
            <div class="card-body">
                <p><strong>User ID:</strong> @AuthState.CurrentSession?.UserId</p>
                <p><strong>Role:</strong> @AuthState.CurrentSession?.Role</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Users</div>
            <div class="card-body">
                <p class="text-muted">No users yet.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Router Nodes</div>
            <div class="card-body">
                <p class="text-muted">No router nodes yet.</p>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            var session = await SessionStorage.LoadSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                AuthState.SetSession(session);
            }
        }
    }
}