@page "/admin"
@layout AdminLayout
@inject AuthState AuthState

<PageTitle>Dashboard - Admin</PageTitle>

<div class="adm-section-head">
    <h2>Dashboard</h2>
    <p>Admin account overview.</p>
</div>

<div class="adm-card">
    <div class="adm-card-header">Admin Account</div>
    <div class="adm-card-body">
        <div class="adm-info-row">
            <span class="adm-info-label">User ID</span>
            <span><code>@(AuthState.CurrentSession?.UserId.ToString() ?? "—")</code></span>
        </div>
        <div class="adm-info-row">
            <span class="adm-info-label">Role</span>
            <span>@(AuthState.CurrentSession?.Role ?? "—")</span>
        </div>
    </div>
</div>
