@page "/admin/models"
@layout AdminLayout
@inject BillingClient BillingClient
@inject AuthState AuthState

<PageTitle>Models - Admin</PageTitle>

<div class="adm-section-head">
    <h2>Models</h2>
    <p>Manage model catalog and routing metadata.</p>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success" role="status">@_success</div>
}

@if (_showEdit)
{
    <div class="adm-card">
        <div class="adm-card-header">@(_isNew ? "Add Model" : $"Edit Model: {_editing!.Id}")</div>
        <div class="adm-card-body">
            <EditForm Model="@_form" OnValidSubmit="HandleSave">
                <DataAnnotationsValidator />
                <div class="adm-form-row">
                    <div class="form-group">
                        <label for="modelId" class="form-label">Model ID</label>
                        <InputText id="modelId" class="form-control" @bind-Value="_form.Id" disabled="@(!_isNew)" />
                        <ValidationMessage For="@(() => _form.Id)" />
                    </div>
                    <div class="form-group">
                        <label for="displayName" class="form-label">Model Name</label>
                        <InputText id="displayName" class="form-control" @bind-Value="_form.DisplayName" />
                        <ValidationMessage For="@(() => _form.DisplayName)" />
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label for="inputPrice" class="form-label">Input Price (RUB/1M)</label>
                        <InputNumber id="inputPrice" class="form-control" @bind-Value="_form.InputPrice" />
                        <ValidationMessage For="@(() => _form.InputPrice)" />
                    </div>
                    <div class="form-group">
                        <label for="outputPrice" class="form-label">Output Price (RUB/1M)</label>
                        <InputNumber id="outputPrice" class="form-control" @bind-Value="_form.OutputPrice" />
                        <ValidationMessage For="@(() => _form.OutputPrice)" />
                    </div>
                </div>
                <div class="adm-btn-row">
                    <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                        @if (_isSaving) { <span class="spinner-border-sm me-2"></span> }
                        Save
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@_isSaving">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="adm-card">
    <div class="adm-card-header adm-card-header--split">
        <span>Public Models</span>
        <button class="btn btn-sm btn-primary" @onclick="ShowAdd" disabled="@_isSaving">Add Model</button>
    </div>
    <div class="adm-card-body">
        @if (_models is null)
        {
            <p class="text-muted">Loading…</p>
        }
        else if (_models.Count == 0)
        {
            <p class="text-muted">No models configured.</p>
        }
        else
        {
            <table class="table">
                <thead><tr>
                    <th>ID</th><th>Display Name</th><th>Upstream</th>
                    <th>Input / Output / Cache per 1M</th><th>Status</th><th>Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var model in _models)
                    {
                        <tr>
                            <td><code>@model.Id</code></td>
                            <td>@model.DisplayName</td>
                            <td><code>@model.UpstreamModelId</code></td>
                            <td>@model.InputPrice.ToString("N2") / @model.OutputPrice.ToString("N2") / @model.CachePrice.ToString("N2") RUB</td>
                            <td>
                                <span class="badge @(model.Enabled ? "badge-success" : "badge-secondary")">
                                    @(model.Enabled ? "Enabled" : "Disabled")
                                </span>
                            </td>
                            <td class="adm-actions-cell">
                                <button class="btn-icon" title="Edit" aria-label="Edit" @onclick="() => StartEdit(model)" disabled="@_isSaving">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IReadOnlyList<ModelInfo>? _models;
    private bool _showEdit, _isNew, _isSaving;
    private string? _error, _success;
    private ModelInfo? _editing;
    private ModelForm _form = new();

    protected override async Task OnInitializedAsync() => await LoadModels();

    private async Task LoadModels()
    {
        try { _models = await BillingClient.ListModelsAsync(); }
        catch { _error = "Failed to load models."; }
    }

    private void ShowAdd()
    {
        _error = null; _success = null; _editing = null; _isNew = true;
        _form = new() { Id = "", DisplayName = "", InputPrice = 0m, OutputPrice = 0m };
        _showEdit = true;
    }

    private void StartEdit(ModelInfo model)
    {
        _error = null; _success = null; _editing = model; _isNew = false;
        _form = new() { Id = model.Id, DisplayName = model.DisplayName, InputPrice = model.InputPrice, OutputPrice = model.OutputPrice };
        _showEdit = true;
    }

    private void CancelEdit() { _editing = null; _showEdit = false; _error = null; }

    private async Task HandleSave()
    {
        if (_isSaving) return;
        _isSaving = true; _error = null; _success = null;
        var wasNew = _isNew;
        try
        {
            var m = new ModelInfo(
                _form.Id.Trim(), _form.DisplayName.Trim(),
                _editing?.UpstreamModelId ?? _form.Id.Trim(),
                _editing?.PriceVersion ?? "v1",
                _form.InputPrice, _form.OutputPrice,
                _editing?.CachePrice ?? 0m,
                _editing?.Enabled ?? true);
            await BillingClient.UpsertModelAsync(m);
            _showEdit = false; _editing = null;
            await LoadModels();
            _success = wasNew ? "Model added." : "Model updated.";
        }
        catch (Exception ex) { _error = $"Failed to save model: {ex.Message}"; }
        finally { _isSaving = false; }
    }

    private class ModelForm
    {
        [Required]
        [RegularExpression(@"^[a-zA-Z0-9_\-\.]+$", ErrorMessage = "ID must be alphanumeric with dashes/underscores")]
        public string Id { get; set; } = "";
        [Required] public string DisplayName { get; set; } = "";
        [Range(0, 1000000)] public decimal InputPrice { get; set; }
        [Range(0, 1000000)] public decimal OutputPrice { get; set; }
    }
}
