@page "/admin/nodes"
@inject ControlPlaneClient ControlPlaneClient
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject ISessionStorage SessionStorage

<PageTitle>Router Nodes - OpenRussiaRouter Admin</PageTitle>

<div class="page-header">
    <div class="header-label">Admin</div>
    <h1>Router Nodes</h1>
</div>

<div class="content">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ErrorMessage
        </div>
    }

    @if (ShowAddModal)
    {
        <div class="panel">
            <div class="panel-header">
                Add Router Node
            </div>
            <div class="panel-body">
                <EditForm Model="@AddForm" OnValidSubmit="HandleAddNode">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="nodeName" class="form-label">Name</label>
                            <InputText id="nodeName" class="form-control" @bind-Value="AddForm.Name" />
                        </div>
                        <div class="form-group">
                            <label for="nodeUrl" class="form-label">Endpoint URL</label>
                            <InputText id="nodeUrl" class="form-control" @bind-Value="AddForm.EndpointUrl" placeholder="https://..." />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="tokenName" class="form-label">Token Secret Name</label>
                            <InputText id="tokenName" class="form-control" @bind-Value="AddForm.TokenSecretName" />
                        </div>
                        <div class="form-group">
                            <label for="capacity" class="form-label">Capacity Weight</label>
                            <InputNumber id="capacity" class="form-control" @bind-Value="AddForm.CapacityWeight" />
                        </div>
                    </div>
                    <div class="btn-row">
                        <button type="submit" class="btn btn-primary" disabled="@IsAdding">Add Node</button>
                        <button type="button" class="btn btn-secondary" @onclick="CloseAddModal">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="panel">
        <div class="panel-header d-flex justify-content-between align-items-center">
            <span>Router Node List</span>
            <button class="btn btn-sm btn-primary" @onclick="ShowAddModal_Click">
                Add Node
            </button>
        </div>
        <div class="panel-body">
            @if (NodeList is null)
            {
                <p>Loading...</p>
            }
            else if (NodeList.Count == 0)
            {
                <p class="text-muted">No router nodes configured.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Endpoint</th>
                            <th>Status</th>
                            <th>In-Flight</th>
                            <th>Last Checked</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var node in NodeList)
                        {
                            <tr>
                                <td>@node.Name</td>
                                <td><small>@node.EndpointUrl</small></td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(node.Status)">
                                        @node.Status
                                    </span>
                                </td>
                                <td>@node.InFlightRequests</td>
                                <td>@(node.LastCheckedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                                <td>
                                    @if (node.Status != "disabled")
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DisableNode(node)">Disable</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-section);
    }

    .header-label {
        font-size: 14px;
        color: var(--color-mute);
        margin-bottom: var(--spacing-sm);
    }

    .content {
        max-width: 960px;
    }

    .panel {
        border: 1px solid var(--color-hairline);
        margin-bottom: var(--spacing-lg);
    }

    .panel-header {
        padding: var(--spacing-md) 0;
        border-bottom: 1px solid var(--color-hairline);
        font-size: 16px;
        font-weight: 700;
    }

    .panel-body {
        padding: var(--spacing-lg) 0;
    }

    .panel-marker {
        color: var(--color-mute);
        margin-right: var(--spacing-sm);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-lg);
    }

    .form-group {
        margin-bottom: 0;
    }

    .btn-row {
        display: flex;
        gap: var(--spacing-md);
    }

    .d-flex {
        display: flex;
    }

    .justify-content-between {
        justify-content: space-between;
    }

    .align-items-center {
        align-items: center;
    }

    @@media (max-width: 640px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private IReadOnlyList<RouterNodeInfo>? NodeList { get; set; }
    private bool ShowAddModal { get; set; }
    private bool IsAdding { get; set; }
    private string? ErrorMessage { get; set; }
    private AddNodeForm AddForm { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionStorage.LoadSessionAsync();
        if (session is not null)
        {
            AuthState.SetSession(session);
        }

        if (!AuthState.IsAuthenticated || AuthState.CurrentSession?.IsAdmin != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadNodeList();
    }

    private async Task LoadNodeList()
    {
        try
        {
            NodeList = await ControlPlaneClient.ListRouterNodesAsync();
        }
        catch
        {
            ErrorMessage = "Failed to load router nodes.";
        }
    }

    private void ShowAddModal_Click()
    {
        AddForm = new AddNodeForm();
        ShowAddModal = true;
    }

    private void CloseAddModal()
    {
        ShowAddModal = false;
    }

    private async Task HandleAddNode()
    {
        IsAdding = true;
        ErrorMessage = null;
        try
        {
            await ControlPlaneClient.RegisterRouterNodeAsync(AddForm.Name, AddForm.EndpointUrl, AddForm.TokenSecretName, AddForm.CapacityWeight);
            ShowAddModal = false;
            await LoadNodeList();
        }
        catch
        {
            ErrorMessage = "Failed to add router node.";
        }
        finally
        {
            IsAdding = false;
        }
    }

    private async Task DisableNode(RouterNodeInfo node)
    {
        try
        {
            await ControlPlaneClient.DisableRouterNodeAsync(node.NodeId);
            await LoadNodeList();
        }
        catch
        {
            ErrorMessage = "Failed to disable router node.";
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "healthy" => "badge-success",
        "degraded" => "badge-warning",
        "unhealthy" => "badge-danger",
        "disabled" => "badge-secondary",
        _ => "badge-secondary"
    };

    private class AddNodeForm
    {
        public string Name { get; set; } = "";
        public string EndpointUrl { get; set; } = "";
        public string TokenSecretName { get; set; } = "";
        public int CapacityWeight { get; set; } = 100;
    }
}
