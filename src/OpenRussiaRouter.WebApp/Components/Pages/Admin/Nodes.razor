@page "/admin/nodes"
@layout AdminLayout
@inject ControlPlaneClient ControlPlaneClient
@inject AuthState AuthState

<PageTitle>Router Nodes - Admin</PageTitle>

<div class="adm-section-head">
    <h2>Router Nodes</h2>
    <p>Manage OpenRussiaRouter nodes.</p>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_showAddNode)
{
    <div class="adm-card">
        <div class="adm-card-header">Add Router Node</div>
        <div class="adm-card-body">
            <EditForm Model="@_form" OnValidSubmit="HandleAddNode">
                <div class="adm-form-row">
                    <div class="form-group">
                        <label for="nodeName" class="form-label">Name</label>
                        <InputText id="nodeName" class="form-control" @bind-Value="_form.Name" />
                    </div>
                    <div class="form-group">
                        <label for="nodeUrl" class="form-label">Endpoint URL</label>
                        <InputText id="nodeUrl" class="form-control" @bind-Value="_form.EndpointUrl" placeholder="https://..." />
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label for="tokenName" class="form-label">Token Secret Name</label>
                        <InputText id="tokenName" class="form-control" @bind-Value="_form.TokenSecretName" />
                    </div>
                    <div class="form-group">
                        <label for="capacity" class="form-label">Capacity Weight</label>
                        <InputNumber id="capacity" class="form-control" @bind-Value="_form.CapacityWeight" />
                    </div>
                </div>
                <div class="adm-btn-row">
                    <button type="submit" class="btn btn-primary" disabled="@_isAdding">Add Node</button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddNode">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="adm-card">
    <div class="adm-card-header adm-card-header--split">
        <span>Router Node List</span>
        <button class="btn btn-sm btn-primary" @onclick="OpenAddNode">Add Node</button>
    </div>
    <div class="adm-card-body">
        @if (_nodes is null)
        {
            <p class="text-muted">Loading…</p>
        }
        else if (_nodes.Count == 0)
        {
            <p class="text-muted">No router nodes configured.</p>
        }
        else
        {
            <table class="table">
                <thead><tr>
                    <th>Name</th><th>Endpoint</th><th>Status</th>
                    <th>In-Flight</th><th>Last Checked</th><th>Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var node in _nodes)
                    {
                        <tr>
                            <td>@node.Name</td>
                            <td><small>@node.EndpointUrl</small></td>
                            <td><span class="badge @GetStatusBadge(node.Status)">@node.Status</span></td>
                            <td>@node.InFlightRequests</td>
                            <td>@(node.LastCheckedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                            <td class="adm-actions-cell">
                                @if (node.Status != "disabled")
                                {
                                    <button class="btn-icon btn-icon-danger" title="Disable" aria-label="Disable" @onclick="() => DisableNode(node)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"/>
                                            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                        </svg>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IReadOnlyList<RouterNodeInfo>? _nodes;
    private bool _showAddNode, _isAdding;
    private string? _error;
    private NodeForm _form = new();

    protected override async Task OnInitializedAsync() => await LoadNodes();

    private async Task LoadNodes()
    {
        try { _nodes = await ControlPlaneClient.ListRouterNodesAsync(); }
        catch { _error = "Failed to load router nodes."; }
    }

    private void OpenAddNode() { _form = new(); _showAddNode = true; }
    private void CloseAddNode() { _showAddNode = false; }

    private async Task HandleAddNode()
    {
        _isAdding = true; _error = null;
        try
        {
            await ControlPlaneClient.RegisterRouterNodeAsync(_form.Name, _form.EndpointUrl, _form.TokenSecretName, _form.CapacityWeight);
            _showAddNode = false;
            await LoadNodes();
        }
        catch { _error = "Failed to add router node."; }
        finally { _isAdding = false; }
    }

    private async Task DisableNode(RouterNodeInfo node)
    {
        try { await ControlPlaneClient.DisableRouterNodeAsync(node.NodeId); await LoadNodes(); }
        catch { _error = "Failed to disable router node."; }
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "healthy" => "badge-success",
        "degraded" => "badge-warning",
        "unhealthy" => "badge-danger",
        _ => "badge-secondary"
    };

    private class NodeForm
    {
        public string Name { get; set; } = "";
        public string EndpointUrl { get; set; } = "";
        public string TokenSecretName { get; set; } = "";
        public int CapacityWeight { get; set; } = 100;
    }
}
