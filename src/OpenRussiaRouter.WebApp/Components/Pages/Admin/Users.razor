@page "/admin/users"
@layout AdminLayout
@inject AuthClient AuthClient
@inject BillingClient BillingClient
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Users - Admin</PageTitle>

<div class="adm-section-head">
    <h2>Users</h2>
    <p>Manage application users and roles.</p>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_showCreateInvite)
{
    <div class="adm-card">
        <div class="adm-card-header">Create Invite</div>
        <div class="adm-card-body">
            @if (!string.IsNullOrEmpty(_newInviteToken))
            {
                <div class="alert alert-success">
                    <strong>Invite created!</strong>
                    <p>Share this link with the user:</p>
                    <code class="adm-key-preview">@Navigation.BaseUri.TrimEnd('/')/invite/@_newInviteToken</code>
                </div>
                <button class="btn btn-primary" @onclick="CloseInvitePanel">Done</button>
            }
            else
            {
                <EditForm Model="@_inviteForm" OnValidSubmit="HandleCreateInvite">
                    <DataAnnotationsValidator />
                    <div class="adm-form-row">
                        <div class="form-group">
                            <label for="inviteEmail" class="form-label">Email</label>
                            <InputText id="inviteEmail" class="form-control" @bind-Value="_inviteForm.Email" />
                            <ValidationMessage For="@(() => _inviteForm.Email)" />
                        </div>
                        <div class="form-group">
                            <label for="inviteRole" class="form-label">Role</label>
                            <InputSelect id="inviteRole" class="form-control" @bind-Value="_inviteForm.Role">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </InputSelect>
                        </div>
                    </div>
                    <div class="adm-btn-row">
                        <button type="submit" class="btn btn-primary" disabled="@_isCreating">
                            @if (_isCreating) { <span class="spinner-border-sm me-2"></span> }
                            Create Invite
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="CloseInvitePanel">Cancel</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@if (_showTopUp && _selectedUser is not null)
{
    <div class="adm-card">
        <div class="adm-card-header">Virtual Top-Up for @_selectedUser.Email</div>
        <div class="adm-card-body">
            <div class="adm-form-row">
                <div class="form-group">
                    <label for="topUpAmount" class="form-label">Amount (RUB)</label>
                    <InputNumber id="topUpAmount" class="form-control" @bind-Value="_topUpForm.Amount" />
                </div>
                <div class="form-group">
                    <label for="topUpReason" class="form-label">Reason</label>
                    <InputText id="topUpReason" class="form-control" @bind-Value="_topUpForm.Reason" />
                </div>
            </div>
            <div class="adm-btn-row">
                <button class="btn btn-primary" @onclick="ConfirmTopUp" disabled="@_isTopingUp">Top Up</button>
                <button class="btn btn-secondary" @onclick="CancelTopUp">Cancel</button>
            </div>
        </div>
    </div>
}

<div class="adm-card">
    <div class="adm-card-header adm-card-header--split">
        <span>All Users</span>
        <button class="btn btn-sm btn-primary" @onclick="OpenCreateInvite">Create Invite</button>
    </div>
    <div class="adm-card-body">
        @if (_users is null)
        {
            <p class="text-muted">Loading…</p>
        }
        else if (_users.Count == 0)
        {
            <p class="text-muted">No users yet.</p>
        }
        else
        {
            <table class="table">
                <thead><tr>
                    <th>Email</th><th>Role</th><th>Status</th>
                    <th>Created</th><th>Balance</th><th>Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>
                                <span class="badge @(user.Status == "Active" ? "badge-success" : "badge-secondary")">@user.Status</span>
                            </td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td>@_userBalances.GetValueOrDefault(user.Id, 0).ToString("N2") RUB</td>
                            <td class="adm-actions-cell">
                                <button class="btn-icon" title="Top Up" aria-label="Top Up" @onclick="() => StartTopUp(user)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IReadOnlyList<UserInfo>? _users;
    private Dictionary<string, decimal> _userBalances = new();
    private bool _showCreateInvite, _showTopUp, _isCreating, _isTopingUp;
    private string? _newInviteToken, _error;
    private UserInfo? _selectedUser;
    private InviteForm _inviteForm = new();
    private TopUpForm _topUpForm = new();

    protected override async Task OnInitializedAsync() => await LoadUsers();

    private async Task LoadUsers()
    {
        try
        {
            _users = await AuthClient.ListUsersAsync();
            foreach (var user in _users)
            {
                try { var b = await BillingClient.GetBalanceAsync(user.Id); _userBalances[user.Id] = b.Amount; }
                catch { _userBalances[user.Id] = 0; }
            }
        }
        catch { _error = "Failed to load users."; }
    }

    private void OpenCreateInvite() { _inviteForm = new(); _newInviteToken = null; _showCreateInvite = true; }
    private void CloseInvitePanel() { _showCreateInvite = false; _newInviteToken = null; }

    private async Task HandleCreateInvite()
    {
        if (AuthState.CurrentSession is null) return;
        _isCreating = true; _error = null;
        try
        {
            var result = await AuthClient.CreateInviteAsync(_inviteForm.Email, _inviteForm.Role, AuthState.CurrentSession.UserId);
            _newInviteToken = result.RawToken;
        }
        catch { _error = "Failed to create invite."; }
        finally { _isCreating = false; }
    }

    private void StartTopUp(UserInfo user) { _selectedUser = user; _topUpForm = new() { Amount = 1000, Reason = "Virtual top-up" }; _showTopUp = true; }
    private void CancelTopUp() { _selectedUser = null; _showTopUp = false; }

    private async Task ConfirmTopUp()
    {
        if (_selectedUser is null) return;
        _isTopingUp = true;
        try
        {
            await BillingClient.CreateVirtualTopUpAsync(AuthState.CurrentSession!.UserId, _selectedUser.Id, _topUpForm.Amount, _topUpForm.Reason);
            _selectedUser = null; _showTopUp = false;
            await LoadUsers();
        }
        catch { _error = "Failed to top up balance."; }
        finally { _isTopingUp = false; }
    }

    private class InviteForm
    {
        [Required][EmailAddress] public string Email { get; set; } = "";
        [Required] public string Role { get; set; } = "User";
    }

    private class TopUpForm
    {
        public decimal Amount { get; set; }
        public string Reason { get; set; } = "";
    }
}
