@page "/cabinet/keys"
@inject AuthClient AuthClient
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject ISessionStorage SessionStorage

<PageTitle>API Keys - OpenRussiaRouter</PageTitle>

<div class="page-header">
    <div class="header-label">Cabinet</div>
    <h1>API Keys</h1>
</div>

<div class="content">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ErrorMessage
        </div>
    }

    @if (ShowCreatePanel)
    {
        <div class="panel">
            <div class="panel-header">
                New API Key
            </div>
            <div class="panel-body">
                @if (!string.IsNullOrEmpty(NewKey))
                {
                    <div class="alert alert-success">
                        <strong>Save your API key now - it won't be shown again!</strong>
                        <div class="key-display">@NewKey</div>
                    </div>
                    <button class="btn btn-primary" @onclick="CloseCreatePanel">Done</button>
                }
                else
                {
                    <EditForm Model="@CreateModel" OnValidSubmit="HandleCreate">
                        <DataAnnotationsValidator />
                        <div class="form-group">
                            <label for="keyName" class="form-label">Key Name</label>
                            <InputText id="keyName" class="form-control" @bind-Value="CreateModel.Name" />
                            <ValidationMessage For="@(() => CreateModel.Name)" />
                        </div>
                        <div class="btn-row">
                            <button type="submit" class="btn btn-primary" disabled="@IsCreating">
                                @if (IsCreating)
                                {
                                    <span class="spinner-border-sm me-2"></span>
                                }
                                Create
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreatePanel">Cancel</button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    }

    @if (ShowRevokeConfirm)
    {
        <div class="modal">
            <div class="modal-dialog">
                <div class="modal-header">
                    <div class="modal-title">Revoke API Key</div>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to revoke <strong>@KeyToRevoke?.Name</strong>?</p>
                    <p class="text-muted">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="ConfirmRevoke" disabled="@IsRevoking">
                        @if (IsRevoking)
                        {
                            <span class="spinner-border-sm"></span>
                        }
                        Revoke
                    </button>
                    <button class="btn btn-secondary" @onclick="CancelRevoke">Cancel</button>
                </div>
            </div>
        </div>
    }

    <div class="panel">
        <div class="panel-header d-flex justify-content-between align-items-center">
            <span>Your API Keys</span>
            <button class="btn btn-sm btn-primary" @onclick="ShowCreatePanel_Click">
                Create Key
            </button>
        </div>
        <div class="panel-body">
            @if (KeyList is null)
            {
                <p>Loading...</p>
            }
            else if (KeyList.Count == 0)
            {
                <p class="text-muted">No API keys yet. Create one to get started.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Prefix</th>
                            <th>Created</th>
                            <th>Last Used</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in KeyList)
                        {
                            <tr>
                                <td>@key.Name</td>
                                <td><code>@key.Prefix***</code></td>
                                <td>@key.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>@(key.LastUsed?.ToLocalTime().ToString("g") ?? "Never")</td>
                                <td>
                                    @if (key.IsActive)
                                    {
                                        <span class="badge badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Revoked</span>
                                    }
                                </td>
                                <td class="actions-cell">
                                    @if (key.IsActive)
                                    {
                                        <button class="btn-icon" title="Rename" aria-label="Rename" @onclick="() => StartRename(key)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </button>
                                        <button class="btn-icon btn-icon-danger" title="Revoke" aria-label="Revoke" @onclick="() => StartRevoke(key)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                            </svg>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@if (ShowRenameModal)
{
    <div class="modal">
        <div class="modal-dialog">
            <div class="modal-header">
                <div class="modal-title">Rename API Key</div>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="newName" class="form-label">New Name</label>
                    <InputText id="newName" class="form-control" @bind-Value="RenameModel.Name" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="ConfirmRename" disabled="@IsRenaming">Save</button>
                <button class="btn btn-secondary" @onclick="CancelRename">Cancel</button>
            </div>
        </div>
    </div>
}

<style>
    .page-header {
        margin-bottom: var(--spacing-section);
    }

    .header-label {
        font-size: 14px;
        color: var(--color-mute);
        margin-bottom: var(--spacing-sm);
    }

    .content {
        max-width: 800px;
    }

    .panel {
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        background: var(--color-canvas-card);
        margin-bottom: var(--spacing-lg);
    }

    .panel-header {
        padding: 0 var(--spacing-lg);
        border-bottom: 1px solid var(--color-hairline);
        font-size: 15px;
        font-weight: 500;
    }

    .panel-body {
        padding: var(--spacing-lg);
    }

    .panel-marker {
        color: var(--color-mute);
        margin-right: var(--spacing-sm);
    }

    .key-display {
        font-family: inherit;
        background-color: var(--color-surface-card);
        padding: var(--spacing-md) var(--spacing-lg);
        border-radius: var(--radius-sm);
        margin-top: var(--spacing-md);
        word-break: break-all;
    }

    .form-group {
        margin-bottom: var(--spacing-lg);
    }

    .btn-row {
        display: flex;
        gap: var(--spacing-md);
    }

    .actions-cell {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .d-flex {
        display: flex;
    }

    .justify-content-between {
        justify-content: space-between;
    }

    .align-items-center {
        align-items: center;
    }
</style>

@code {
    private IReadOnlyList<ApiKeyInfo>? KeyList { get; set; }
    private bool ShowCreatePanel { get; set; }
    private bool ShowRevokeConfirm { get; set; }
    private bool ShowRenameModal { get; set; }
    private bool IsCreating { get; set; }
    private bool IsRevoking { get; set; }
    private bool IsRenaming { get; set; }
    private string? NewKey { get; set; }
    private string? ErrorMessage { get; set; }
    private ApiKeyInfo? KeyToRevoke { get; set; }
    private ApiKeyInfo? KeyToRename { get; set; }
    private CreateKeyModel CreateModel { get; set; } = new();
    private RenameKeyModel RenameModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionStorage.LoadSessionAsync();
        if (session is not null)
        {
            AuthState.SetSession(session);
        }

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadKeys();
    }

    private async Task LoadKeys()
    {
        if (AuthState.CurrentSession is null) return;
        try
        {
            KeyList = await AuthClient.ListApiKeysAsync(AuthState.CurrentSession.UserId);
        }
        catch
        {
            ErrorMessage = "Failed to load API keys.";
        }
    }

    private void ShowCreatePanel_Click()
    {
        CreateModel = new CreateKeyModel();
        NewKey = null;
        ShowCreatePanel = true;
    }

    private void CloseCreatePanel()
    {
        ShowCreatePanel = false;
        NewKey = null;
        CreateModel = new CreateKeyModel();
    }

    private async Task HandleCreate()
    {
        if (AuthState.CurrentSession is null) return;
        IsCreating = true;
        ErrorMessage = null;
        try
        {
            var result = await AuthClient.CreateApiKeyAsync(AuthState.CurrentSession.UserId, CreateModel.Name);
            NewKey = result.RawKey;
            await LoadKeys();
        }
        catch
        {
            ErrorMessage = "Failed to create API key.";
        }
        finally
        {
            IsCreating = false;
        }
    }

    private void StartRevoke(ApiKeyInfo key)
    {
        KeyToRevoke = key;
        ShowRevokeConfirm = true;
    }

    private void CancelRevoke()
    {
        KeyToRevoke = null;
        ShowRevokeConfirm = false;
    }

    private async Task ConfirmRevoke()
    {
        if (AuthState.CurrentSession is null || KeyToRevoke is null) return;
        IsRevoking = true;
        try
        {
            await AuthClient.RevokeApiKeyAsync(AuthState.CurrentSession.UserId, KeyToRevoke.Id);
            KeyToRevoke = null;
            ShowRevokeConfirm = false;
            await LoadKeys();
        }
        catch
        {
            ErrorMessage = "Failed to revoke API key.";
        }
        finally
        {
            IsRevoking = false;
        }
    }

    private void StartRename(ApiKeyInfo key)
    {
        KeyToRename = key;
        RenameModel = new RenameKeyModel { Name = key.Name };
        ShowRenameModal = true;
    }

    private void CancelRename()
    {
        KeyToRename = null;
        ShowRenameModal = false;
    }

    private async Task ConfirmRename()
    {
        if (AuthState.CurrentSession is null || KeyToRename is null) return;
        IsRenaming = true;
        try
        {
            await AuthClient.RenameApiKeyAsync(AuthState.CurrentSession.UserId, KeyToRename.Id, RenameModel.Name);
            KeyToRename = null;
            ShowRenameModal = false;
            await LoadKeys();
        }
        catch
        {
            ErrorMessage = "Failed to rename API key.";
        }
        finally
        {
            IsRenaming = false;
        }
    }

    private class CreateKeyModel
    {
        [Required]
        [MinLength(1)]
        public string Name { get; set; } = "";
    }

    private class RenameKeyModel
    {
        [Required]
        [MinLength(1)]
        public string Name { get; set; } = "";
    }
}
