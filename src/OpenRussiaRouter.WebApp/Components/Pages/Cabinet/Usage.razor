@page "/cabinet/usage"
@inject AuthClient AuthClient
@inject BillingClient BillingClient
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Usage - OpenRussiaRouter</PageTitle>

<div class="page-header">
    <div class="header-label">[*] Cabinet</div>
    <h1>Usage</h1>
</div>

<div class="content">
    <div class="balance-card">
        <div class="card-label">[-] Current Balance</div>
        <div class="balance-value">
            @if (Balance is null)
            {
                <span>Loading...</span>
            }
            else
            {
                <span>@Balance.Amount.ToString("N2") RUB</span>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <span class="panel-marker">[+]</span> Recent Usage
        </div>
        <div class="panel-body">
            @if (UsageRecords is null)
            {
                <p>Loading...</p>
            }
            else if (UsageRecords.Count == 0)
            {
                <p class="text-muted">No usage records yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Model</th>
                            <th>Input</th>
                            <th>Output</th>
                            <th>Cache</th>
                            <th>Cost (RUB)</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in UsageRecords)
                        {
                            <tr>
                                <td>@record.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td><code>@record.ModelId</code></td>
                                <td>@record.InputTokens.ToString("N0")</td>
                                <td>@record.OutputTokens.ToString("N0")</td>
                                <td>@record.CacheTokens.ToString("N0")</td>
                                <td>@record.CostRub.ToString("N4")</td>
                                <td>
                                    <span class="badge @(record.Status == "completed" ? "badge-success" : "badge-warning")">
                                        @record.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-section);
    }

    .header-label {
        font-size: 14px;
        color: var(--color-mute);
        margin-bottom: var(--spacing-sm);
    }

    .content {
        max-width: 960px;
    }

    .balance-card {
        border: 1px solid var(--color-hairline);
        margin-bottom: var(--spacing-xl);
        background-color: var(--color-canvas);
    }

    .card-label {
        font-size: 14px;
        font-weight: 700;
        padding: var(--spacing-md) 0;
        border-bottom: 1px solid var(--color-hairline);
    }

    .balance-value {
        padding: var(--spacing-lg) 0;
        font-size: 24px;
        font-weight: 700;
    }

    .panel {
        border: 1px solid var(--color-hairline);
    }

    .panel-header {
        padding: var(--spacing-md) 0;
        border-bottom: 1px solid var(--color-hairline);
        font-size: 16px;
        font-weight: 700;
    }

    .panel-body {
        padding: var(--spacing-lg) 0;
    }

    .panel-marker {
        color: var(--color-mute);
        margin-right: var(--spacing-sm);
    }
</style>

@code {
    private BalanceInfo? Balance { get; set; }
    private IReadOnlyList<UsageInfo>? UsageRecords { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        if (AuthState.CurrentSession is null) return;
        try
        {
            Balance = await BillingClient.GetBalanceAsync(AuthState.CurrentSession.UserId);
            UsageRecords = await BillingClient.ListUsageAsync(AuthState.CurrentSession.UserId);
        }
        catch
        {
            ErrorMessage = "Failed to load usage data.";
        }
    }
}