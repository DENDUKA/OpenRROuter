@page "/Error"
@using System.Diagnostics

<PageTitle>Error - OpenRussiaRouter</PageTitle>

<div class="error-container">
    <div class="error-header">
        <span class="error-marker">[x]</span> Error
    </div>
    <div class="error-body">
        <h1 class="error-title">An error occurred while processing your request.</h1>

        @if (ShowRequestId)
        {
            <div class="error-info">
                <span class="info-label">Request ID:</span>
                <code>@RequestId</code>
            </div>
        }

        <div class="error-dev-note">
            <div class="dev-label">Development Mode</div>
            <p>Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.</p>
            <p>The Development environment shouldn't be enabled for deployed applications. It can result in displaying sensitive information from exceptions to end users. For local debugging, enable the <strong>Development</strong> environment by setting the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong> and restarting the app.</p>
        </div>
    </div>
</div>

<style>
    .error-container {
        max-width: 800px;
        padding: var(--spacing-section) 0;
    }

    .error-header {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-md);
        border-bottom: 1px solid var(--color-hairline);
    }

    .error-marker {
        color: var(--color-danger);
        margin-right: var(--spacing-sm);
    }

    .error-body {
        color: var(--color-ink);
    }

    .error-title {
        font-size: 16px;
        font-weight: 400;
        color: var(--color-danger);
        margin-bottom: var(--spacing-xl);
    }

    .error-info {
        margin-bottom: var(--spacing-xl);
        padding: var(--spacing-md);
        background-color: var(--color-surface-soft);
        border-radius: var(--radius-sm);
    }

    .info-label {
        font-weight: 500;
        margin-right: var(--spacing-sm);
    }

    .error-dev-note {
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-xl);
        border-top: 1px solid var(--color-hairline);
    }

    .dev-label {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: var(--spacing-md);
    }

    .error-dev-note p {
        font-size: 14px;
        color: var(--color-body);
        line-height: 1.6;
        margin-bottom: var(--spacing-md);
    }

    .error-dev-note strong {
        font-weight: 500;
    }
</style>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}