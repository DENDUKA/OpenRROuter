@page "/"

<PageTitle>Home - OpenRussiaRouter</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto text-center">
            <h1 class="display-4 mb-4">OpenRussiaRouter</h1>
            <p class="lead mb-4">B2B platform for LLM access via OpenAI-compatible API</p>

            <div class="d-flex gap-3 justify-content-center">
                <a href="/login" class="btn btn-primary btn-lg">Login</a>
                <a href="/invite/demo" class="btn btn-outline-secondary btn-lg">Register</a>
            </div>

            <div class="row mt-5">
                <div class="col-md-4">
                    <h5>API Access</h5>
                    <p class="text-muted">OpenAI-compatible API with balance in rubles</p>
                </div>
                <div class="col-md-4">
                    <h5>API Keys</h5>
                    <p class="text-muted">Create and manage your API keys</p>
                </div>
                <div class="col-md-4">
                    <h5>Usage Tracking</h5>
                    <p class="text-muted">Monitor token usage and costs</p>
                </div>
            </div>
        </div>
    </div>
</div>