@page "/invite/{Token}"
@inject AuthClient AuthClient
@inject NavigationManager Navigation
@inject ISessionStorage SessionStorage

<PageTitle>Complete Registration - OpenRussiaRouter</PageTitle>

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">OPENCODE</div>
        <div class="auth-title">Complete Registration</div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ErrorMessage
        </div>
    }

    @if (IsSuccess)
    {
        <div class="alert alert-success" role="alert">
            <p class="mb-1">Registration complete!</p>
            <p>Redirecting to login...</p>
        </div>
    }
    else
    {
        <EditForm Model="@Model" OnValidSubmit="HandleComplete">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="Model.Password" />
                <ValidationMessage For="@(() => Model.Password)" />
            </div>
            <div class="form-group">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="Model.ConfirmPassword" />
                <ValidationMessage For="@(() => Model.ConfirmPassword)" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border-sm me-2" role="status"></span>
                }
                Complete Registration
            </button>
        </EditForm>
    }
</div>

<style>
    .auth-container {
        max-width: 400px;
        margin: 0 auto;
        padding: var(--spacing-section) 0;
    }

    .auth-header {
        text-align: center;
        margin-bottom: var(--spacing-xl);
    }

    .auth-wordmark {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--color-ink);
        margin-bottom: var(--spacing-lg);
    }

    .auth-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--color-ink);
    }

    .form-group {
        margin-bottom: var(--spacing-lg);
    }

    .mb-1 {
        margin-bottom: var(--spacing-sm) !important;
    }
</style>

@code {
    [Microsoft.AspNetCore.Components.Parameter]
    public string Token { get; set; } = "";

    private InviteModel Model { get; set; } = new();
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsSuccess { get; set; }

    private async Task HandleComplete()
    {
        if (Model.Password != Model.ConfirmPassword)
        {
            ErrorMessage = "Passwords do not match.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var response = await AuthClient.CompleteInviteAsync(Token, Model.Password);
            IsSuccess = true;
            await Task.Delay(2000);
            Navigation.NavigateTo("/login");
        }
        catch (AuthException ex)
        {
            ErrorMessage = ex.ErrorCode switch
            {
                "validation_failed" => "Invalid or expired invite token.",
                _ => "Registration failed. Please try again."
            };
        }
        catch (Exception)
        {
            ErrorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private class InviteModel
    {
        [Required]
        [MinLength(8)]
        public string Password { get; set; } = "";

        [Required]
        [Compare(nameof(Password))]
        public string ConfirmPassword { get; set; } = "";
    }
}