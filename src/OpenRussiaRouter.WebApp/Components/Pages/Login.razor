@page "/login"
@inject AuthClient AuthClient
@inject NavigationManager Navigation
@inject AuthState AuthState
@inject ISessionStorage SessionStorage

<PageTitle>Login - OpenRussiaRouter</PageTitle>

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">OPENCODE</div>
        <div class="auth-title">Login</div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ErrorMessage
        </div>
    }

    <EditForm Model="@Model" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-control" @bind-Value="Model.Email" />
            <ValidationMessage For="@(() => Model.Email)" />
        </div>
        <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="Model.Password" />
            <ValidationMessage For="@(() => Model.Password)" />
        </div>
        <button type="submit" class="btn btn-primary w-100" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner-border-sm me-2" role="status"></span>
            }
            Login
        </button>
    </EditForm>
</div>

<style>
    .auth-container {
        max-width: 400px;
        margin: 0 auto;
        padding: var(--spacing-section) 0;
    }

    .auth-header {
        text-align: center;
        margin-bottom: var(--spacing-xl);
    }

    .auth-wordmark {
        font-size: 16px;
        font-weight: 500;
        letter-spacing: 2px;
        color: var(--color-ink);
        margin-bottom: var(--spacing-lg);
    }

    .auth-title {
        font-size: 38px;
        font-weight: 400;
        color: var(--color-ink);
    }

    .form-group {
        margin-bottom: var(--spacing-lg);
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private LoginModel Model { get; set; } = new();
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionStorage.LoadSessionAsync();
        if (session is not null)
        {
            AuthState.SetSession(session);
            NavigateByRole(session.Role);
        }
    }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var response = await AuthClient.LoginAsync(Model.Email, Model.Password);
            var session = new UserSession
            {
                SessionToken = response.SessionToken,
                UserId = response.UserId,
                Role = response.Role,
                Email = response.Email
            };
            await SessionStorage.SaveSessionAsync(session);
            AuthState.SetSession(session);
            NavigateByRole(response.Role);
        }
        catch (AuthException ex)
        {
            ErrorMessage = ex.ErrorCode switch
            {
                "invalid_credentials" => "Invalid email or password.",
                "user_disabled" => "Your account has been disabled.",
                _ => "Login failed. Please try again."
            };
        }
        catch (Exception)
        {
            ErrorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void NavigateByRole(string role)
    {
        if (!string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/'))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }
        Navigation.NavigateTo(role == "Admin" ? "/admin" : "/workspace");
    }

    private class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}