@page "/models"
@inject BillingClient BillingClient

<PageTitle>Models - OpenRussiaRouter</PageTitle>

<main class="models-page" id="main-content">
    <section class="models-hero" aria-labelledby="models-title">
        <div>
            <div class="eyebrow">Filter Filter</div>
            <h1 id="models-title">Models</h1>
            <p class="models-lead">Browse available OpenAI-compatible models routed through OpenRussiaRouter.</p>
        </div>
        <a class="btn btn-primary compare-button" href="#compare">Compare</a>
    </section>

    <section class="models-shell" aria-label="Model catalog">
        <aside class="filter-panel" aria-label="Filters">
            <div class="filter-heading">Filter</div>

            <label class="form-label" for="model-search">Search models</label>
            <input id="model-search" class="form-control search-input" type="search" placeholder="GPT, Claude, Gemini..." @bind="SearchText" @bind:event="oninput" />

            <div class="filter-group" role="group" aria-label="Model categories">
                @foreach (var category in Categories)
                {
                    <button type="button" class="filter-chip @(SelectedCategory == category ? "active" : null)" @onclick="() => SelectedCategory = category">
                        @category
                    </button>
                }
            </div>
        </aside>

        <div class="models-content">
            <div class="models-toolbar">
                <div>
                    <div class="toolbar-label">Models</div>
                    <div class="toolbar-count">@FilteredModels.Count model@(FilteredModels.Count == 1 ? "" : "s") available</div>
                </div>
                <div class="toolbar-note">OpenAI-compatible API</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="catalog-state error" role="alert">
                    <strong>Could not load models.</strong>
                    <span>@ErrorMessage</span>
                </div>
            }
            else if (ModelList is null)
            {
                <div class="models-list" aria-label="Loading models">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="model-card skeleton-card" aria-hidden="true">
                            <div class="skeleton-line wide"></div>
                            <div class="skeleton-line"></div>
                            <div class="skeleton-meta"></div>
                        </div>
                    }
                </div>
            }
            else if (FilteredModels.Count == 0)
            {
                <div class="catalog-state">
                    <strong>No models found.</strong>
                    <span>Try another search or category.</span>
                </div>
            }
            else
            {
                <div class="models-list">
                    @foreach (var model in FilteredModels)
                    {
                        <article class="model-card">
                            <div class="model-main">
                                <div class="model-icon" aria-hidden="true">@GetInitials(model.DisplayName)</div>
                                <div>
                                    <h2>@model.DisplayName</h2>
                                    <code>@model.Id</code>
                                </div>
                            </div>

                            <p class="model-description">@GetDescription(model)</p>

                            <div class="model-meta" aria-label="Model metadata">
                                <span>@GetProvider(model)</span>
                                <span>@GetCapability(model)</span>
                                <span>Available</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="compare-panel" id="compare" aria-labelledby="compare-title">
        <div>
            <div class="eyebrow">Compare</div>
            <h2 id="compare-title">Pick the right model for each request.</h2>
        </div>
        <p>Use model IDs from this catalog with the OpenAI-compatible endpoint. Pricing and routing are handled by OpenRussiaRouter.</p>
    </section>
</main>

<style>
    .models-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: var(--spacing-4xl) var(--spacing-xl);
    }

    .models-hero {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--spacing-xl);
        padding-bottom: var(--spacing-3xl);
        border-bottom: 1px solid var(--color-hairline);
    }

    .eyebrow {
        color: var(--color-mute);
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.08em;
        margin-bottom: var(--spacing-md);
        text-transform: uppercase;
    }

    .models-lead {
        color: var(--color-body);
        max-width: 620px;
        font-size: 18px;
        line-height: 28px;
    }

    .compare-button {
        flex: 0 0 auto;
        min-height: 44px;
        line-height: 28px;
    }

    .models-shell {
        display: grid;
        grid-template-columns: 260px minmax(0, 1fr);
        gap: var(--spacing-2xl);
        padding: var(--spacing-3xl) 0;
    }

    .filter-panel {
        position: sticky;
        top: 88px;
        align-self: start;
        border: 1px solid var(--color-hairline);
        background: var(--color-canvas);
        padding: var(--spacing-lg);
    }

    .filter-heading {
        color: var(--color-ink);
        font-size: 16px;
        margin-bottom: var(--spacing-lg);
    }

    .search-input {
        margin-bottom: var(--spacing-lg);
    }

    .filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
    }

    .filter-chip {
        min-height: 40px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-pill);
        background: transparent;
        color: var(--color-body);
        cursor: pointer;
        font: inherit;
        padding: var(--spacing-sm) var(--spacing-md);
        transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
    }

    .filter-chip:hover,
    .filter-chip:focus-visible {
        border-color: rgba(255, 255, 255, 0.45);
        color: var(--color-ink);
        outline: none;
    }

    .filter-chip.active {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: var(--color-on-primary);
    }

    .models-toolbar {
        display: flex;
        justify-content: space-between;
        gap: var(--spacing-lg);
        padding-bottom: var(--spacing-lg);
        border-bottom: 1px solid var(--color-hairline);
        margin-bottom: var(--spacing-lg);
    }

    .toolbar-label {
        font-size: 20px;
        color: var(--color-ink);
    }

    .toolbar-count,
    .toolbar-note {
        color: var(--color-mute);
        font-size: 14px;
    }

    .models-list {
        display: grid;
        gap: var(--spacing-md);
    }

    .model-card {
        border: 1px solid var(--color-hairline);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
        padding: var(--spacing-lg);
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .model-card:hover {
        border-color: rgba(255, 255, 255, 0.32);
        background-color: rgba(255, 255, 255, 0.02);
    }

    .model-main {
        display: flex;
        gap: var(--spacing-md);
        align-items: center;
        margin-bottom: var(--spacing-md);
    }

    .model-icon {
        display: grid;
        place-items: center;
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-sm);
        color: var(--color-ink);
        font-family: var(--font-mono);
        font-size: 13px;
        background: var(--color-canvas-soft);
    }

    .model-card h2 {
        font-size: 20px;
        line-height: 28px;
        margin: 0;
    }

    .model-card code {
        color: var(--color-mute);
        font-family: var(--font-mono);
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .model-description {
        color: var(--color-body);
        margin-bottom: var(--spacing-lg);
    }

    .model-meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
    }

    .model-meta span {
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-pill);
        color: var(--color-body);
        font-size: 13px;
        padding: var(--spacing-xs) var(--spacing-sm);
    }

    .catalog-state {
        border: 1px solid var(--color-hairline);
        color: var(--color-body);
        display: grid;
        gap: var(--spacing-xs);
        padding: var(--spacing-xl);
    }

    .catalog-state strong {
        color: var(--color-ink);
    }

    .catalog-state.error {
        border-color: rgba(255, 59, 48, 0.45);
    }

    .skeleton-card {
        min-height: 152px;
    }

    .skeleton-line,
    .skeleton-meta {
        border-radius: var(--radius-pill);
        background: linear-gradient(90deg, var(--color-canvas-soft), var(--color-canvas-mid), var(--color-canvas-soft));
        background-size: 200% 100%;
        animation: skeleton-pulse 1.4s ease-in-out infinite;
    }

    .skeleton-line {
        width: 48%;
        height: 18px;
        margin-bottom: var(--spacing-md);
    }

    .skeleton-line.wide {
        width: 72%;
    }

    .skeleton-meta {
        width: 34%;
        height: 28px;
        margin-top: var(--spacing-xl);
    }

    .compare-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);
        gap: var(--spacing-2xl);
        border-top: 1px solid var(--color-hairline);
        padding-top: var(--spacing-3xl);
    }

    .compare-panel h2 {
        font-size: 36px;
        line-height: 40px;
    }

    .compare-panel p {
        color: var(--color-body);
        margin-top: var(--spacing-xl);
    }

    @@keyframes skeleton-pulse {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .skeleton-line,
        .skeleton-meta {
            animation: none;
        }
    }

    @@media (max-width: 820px) {
        .models-page {
            padding: var(--spacing-2xl) var(--spacing-lg);
        }

        .models-hero,
        .models-toolbar,
        .compare-panel {
            display: grid;
            grid-template-columns: 1fr;
        }

        .models-shell {
            grid-template-columns: 1fr;
        }

        .filter-panel {
            position: static;
        }

        .compare-button {
            width: 100%;
        }
    }

    @@media (max-width: 520px) {
        .models-hero h1 {
            font-size: 56px;
            line-height: 60px;
            letter-spacing: -1.5px;
        }

        .model-main {
            align-items: flex-start;
        }

        .toolbar-note {
            display: none;
        }
    }
</style>

@code {
    private static readonly string[] Categories = ["All", "OpenAI", "Anthropic", "Google", "Meta", "Coding"];
    private IReadOnlyList<ModelInfo>? ModelList { get; set; }
    private string SearchText { get; set; } = string.Empty;
    private string SelectedCategory { get; set; } = "All";
    private string? ErrorMessage { get; set; }

    private IReadOnlyList<ModelInfo> FilteredModels
    {
        get
        {
            if (ModelList is null)
            {
                return [];
            }

            var query = SearchText.Trim();
            return ModelList
                .Where(model => MatchesCategory(model, SelectedCategory))
                .Where(model => string.IsNullOrWhiteSpace(query) ||
                    model.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    model.Id.Contains(query, StringComparison.OrdinalIgnoreCase))
                .OrderBy(model => model.DisplayName)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ModelList = await BillingClient.ListPublicModelsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            ModelList = [];
        }
    }

    private static bool MatchesCategory(ModelInfo model, string category)
    {
        if (category == "All")
        {
            return true;
        }

        var text = $"{model.Id} {model.DisplayName}";
        return category switch
        {
            "OpenAI" => text.Contains("openai", StringComparison.OrdinalIgnoreCase) || text.Contains("gpt", StringComparison.OrdinalIgnoreCase),
            "Anthropic" => text.Contains("anthropic", StringComparison.OrdinalIgnoreCase) || text.Contains("claude", StringComparison.OrdinalIgnoreCase),
            "Google" => text.Contains("google", StringComparison.OrdinalIgnoreCase) || text.Contains("gemini", StringComparison.OrdinalIgnoreCase),
            "Meta" => text.Contains("meta", StringComparison.OrdinalIgnoreCase) || text.Contains("llama", StringComparison.OrdinalIgnoreCase),
            "Coding" => text.Contains("code", StringComparison.OrdinalIgnoreCase) || text.Contains("coder", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }

    private static string GetProvider(ModelInfo model)
    {
        var text = $"{model.Id} {model.DisplayName}";
        if (text.Contains("claude", StringComparison.OrdinalIgnoreCase) || text.Contains("anthropic", StringComparison.OrdinalIgnoreCase)) return "Anthropic";
        if (text.Contains("gpt", StringComparison.OrdinalIgnoreCase) || text.Contains("openai", StringComparison.OrdinalIgnoreCase)) return "OpenAI";
        if (text.Contains("gemini", StringComparison.OrdinalIgnoreCase) || text.Contains("google", StringComparison.OrdinalIgnoreCase)) return "Google";
        if (text.Contains("llama", StringComparison.OrdinalIgnoreCase) || text.Contains("meta", StringComparison.OrdinalIgnoreCase)) return "Meta";
        if (model.Id.Contains('/', StringComparison.Ordinal)) return model.Id.Split('/')[0];
        return "Model";
    }

    private static string GetCapability(ModelInfo model)
    {
        var text = $"{model.Id} {model.DisplayName}";
        if (text.Contains("vision", StringComparison.OrdinalIgnoreCase)) return "Vision";
        if (text.Contains("code", StringComparison.OrdinalIgnoreCase) || text.Contains("coder", StringComparison.OrdinalIgnoreCase)) return "Coding";
        if (text.Contains("reason", StringComparison.OrdinalIgnoreCase) || text.Contains("thinking", StringComparison.OrdinalIgnoreCase)) return "Reasoning";
        return "Text generation";
    }

    private static string GetDescription(ModelInfo model)
    {
        return $"{model.DisplayName} is available through the OpenRussiaRouter API using the model id {model.Id}.";
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "AI";
        }

        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
}
