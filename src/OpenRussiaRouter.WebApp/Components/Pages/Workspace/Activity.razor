@page "/workspace/activity"
@layout WorkspaceLayout
@inject AuthState AuthState
@inject BillingClient BillingClient

<PageTitle>Activity - OpenRussiaRouter</PageTitle>

<div class="ws-section-header">
    <h2>Activity</h2>
    <p class="ws-section-desc">Recent API usage and token consumption.</p>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="ws-panel">
    <div class="ws-panel-header">Recent Usage</div>
    <div class="ws-panel-body">
        @if (_usage is null)
        {
            <p class="text-muted">Loading...</p>
        }
        else if (_usage.Count == 0)
        {
            <p class="text-muted">No usage records yet.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Model</th>
                        <th>Input</th>
                        <th>Output</th>
                        <th>Cache</th>
                        <th>Cost (RUB)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _usage)
                    {
                        <tr>
                            <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td><code>@r.ModelId</code></td>
                            <td>@r.InputTokens.ToString("N0")</td>
                            <td>@r.OutputTokens.ToString("N0")</td>
                            <td>@r.CacheTokens.ToString("N0")</td>
                            <td>@r.CostRub.ToString("N4")</td>
                            <td>
                                <span class="badge @(r.Status == "completed" ? "badge-success" : "badge-warning")">
                                    @r.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IReadOnlyList<UsageInfo>? _usage;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.CurrentSession is null) return;
        try { _usage = await BillingClient.ListUsageAsync(AuthState.CurrentSession.UserId); }
        catch { _error = "Failed to load usage data."; }
    }
}
