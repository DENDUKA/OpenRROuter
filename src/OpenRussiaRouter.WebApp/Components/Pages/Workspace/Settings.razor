@page "/workspace/settings"
@layout WorkspaceLayout
@inject AuthState AuthState

<PageTitle>Settings - OpenRussiaRouter</PageTitle>

<div class="ws-section-header">
    <h2>Settings</h2>
    <p class="ws-section-desc">Account information.</p>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">Account</div>
    <div class="ws-panel-body">
        <div class="ws-info-row">
            <span class="ws-info-label">Display Name</span>
            <span>@(AuthState.CurrentSession?.DisplayName ?? "—")</span>
        </div>
        <div class="ws-info-row">
            <span class="ws-info-label">User ID</span>
            <code>@(AuthState.CurrentSession?.UserId.ToString() ?? "—")</code>
        </div>
        <div class="ws-info-row">
            <span class="ws-info-label">Role</span>
            <span>@(AuthState.CurrentSession?.Role ?? "—")</span>
        </div>
    </div>
</div>

@code { }
