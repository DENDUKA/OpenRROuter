@page
@model Admin.AnomaliesModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Anomalies - Admin"; }

<div class="adm-section-head">
    <h2>Anomalies</h2>
    <p>Review suspicious usage and operational anomalies.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="adm-card">
    <div class="adm-card-header">All Anomalies</div>
    <div class="adm-card-body">
        @if (Model.Anomalies.Count == 0)
        {
            <p class="text-muted">No anomalies detected.</p>
        }
        else
        {
            <table class="table">
                <thead><tr>
                    <th>Date</th><th>Request ID</th><th>Type</th><th>Message</th>
                </tr></thead>
                <tbody>
                    @foreach (var anomaly in Model.Anomalies)
                    {
                        <tr>
                            <td>@anomaly.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td><small>@anomaly.RequestId</small></td>
                            <td><span class="badge badge-warning">@anomaly.Type</span></td>
                            <td>@anomaly.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
