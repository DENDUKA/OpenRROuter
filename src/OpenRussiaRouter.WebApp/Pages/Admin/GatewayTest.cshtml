@page
@model Admin.GatewayTestModel
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Gateway Test - Admin";
}

<div class="adm-section-head">
    <h2>Gateway Test</h2>
    <p>Отправить запрос на <code>/v1/chat/completions</code> через ApiGateway. Доступны все модели каталога, включая отключенные.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert" data-testid="error-message">@Model.ErrorMessage</div>
}

<div class="adm-card">
    <div class="adm-card-header">Запрос</div>
    <div class="adm-card-body">
        <form id="gateway-test-form" method="post" action="/admin/gatewaytest/stream" data-testid="form-gateway-test">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="Form_Model" class="form-label">Model</label>
                <select id="Form_Model" name="Model" class="form-control" data-testid="input-model">
                    @foreach (var option in Model.Models)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="Form_Prompt" class="form-label">Prompt</label>
                <textarea id="Form_Prompt" name="Prompt" class="form-control" rows="6"
                          placeholder="Напишите запрос к модели..." data-testid="input-prompt"></textarea>
            </div>
            <div class="adm-btn-row">
                <button type="submit" id="gw-test-send" class="btn btn-primary" data-testid="btn-send">Send</button>
                <button type="button" id="gw-test-clear" class="btn btn-secondary">Clear</button>
            </div>
        </form>
    </div>
</div>

<div class="adm-card" id="gw-test-result-card" style="display: none;">
    <div class="adm-card-header">Результат</div>
    <div class="adm-card-body">
        <div class="adm-form-row">
            <div class="form-group">
                <strong>Latency:</strong> <span id="gw-test-latency" data-testid="result-latency">-</span>
            </div>
            <div class="form-group">
                <strong>HTTP:</strong> <span id="gw-test-status" data-testid="result-status">-</span>
            </div>
            <div class="form-group">
                <strong>Tokens:</strong> <span id="gw-test-usage" data-testid="result-usage">-</span>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Ответ</label>
            <pre id="gw-test-output" data-testid="result-output"
                 style="background: #f8fafc; color: #1f2937; padding: 12px; border: 1px solid #d1d5db; border-radius: 4px; max-height: 480px; overflow: auto; white-space: pre-wrap; word-break: break-word; font-family: inherit; font-size: 14px; line-height: 1.5;"></pre>
        </div>
    </div>
</div>

<script>
    (function () {
        const form = document.getElementById('gateway-test-form');
        const sendBtn = document.getElementById('gw-test-send');
        const clearBtn = document.getElementById('gw-test-clear');
        const resultCard = document.getElementById('gw-test-result-card');
        const outputEl = document.getElementById('gw-test-output');
        const latencyEl = document.getElementById('gw-test-latency');
        const statusEl = document.getElementById('gw-test-status');
        const usageEl = document.getElementById('gw-test-usage');
        let sseBuffer = '';
        let responseText = '';
        let statusMessage = '';
        let completionReason = '';
        let sawAnyEvent = false;
        let hasServerLatency = false;

        clearBtn.addEventListener('click', function () {
            outputEl.textContent = '';
            latencyEl.textContent = '-';
            statusEl.textContent = '-';
            usageEl.textContent = '-';
            resultCard.style.display = 'none';
        });

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            outputEl.textContent = '';
            latencyEl.textContent = '...';
            statusEl.textContent = '...';
            usageEl.textContent = '-';
            resultCard.style.display = '';
            sendBtn.disabled = true;

            const startedAt = performance.now();
            sseBuffer = '';
            responseText = '';
            statusMessage = 'Отправляем запрос...';
            completionReason = '';
            sawAnyEvent = false;
            hasServerLatency = false;
            renderOutput();

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'text/event-stream' }
                });

                statusEl.textContent = response.status;

                if (!response.ok) {
                    const errBody = await response.text();
                    outputEl.textContent = formatErrorBody(errBody, response.status);
                    latencyEl.textContent = Math.round(performance.now() - startedAt) + ' ms';
                    return;
                }

                if (!response.body) {
                    outputEl.textContent = 'Сервер ответил без тела ответа.';
                    return;
                }

                const reader = response.body.getReader();
                const decoder = new TextDecoder('utf-8');
                statusMessage = 'Ответ приходит потоком...';
                renderOutput();
                while (true) {
                    const { value, done } = await reader.read();
                    if (done) break;
                    const chunk = decoder.decode(value, { stream: true });
                    processStreamChunk(chunk);
                    renderOutput();
                    outputEl.scrollTop = outputEl.scrollHeight;
                }

                processStreamChunk(decoder.decode());
                flushBufferedText();
                if (!hasServerLatency) {
                    latencyEl.textContent = Math.round(performance.now() - startedAt) + ' ms';
                }
                statusMessage = responseText || sawAnyEvent
                    ? 'Проверка завершена.'
                    : 'Ответ получен, но текстового содержимого нет.';
                renderOutput();
            } catch (err) {
                statusMessage = 'Не удалось выполнить запрос: ' + err.message;
                renderOutput();
                latencyEl.textContent = Math.round(performance.now() - startedAt) + ' ms';
            } finally {
                sendBtn.disabled = false;
            }
        });

        function processStreamChunk(chunk) {
            if (!chunk) return;

            sseBuffer += chunk.replace(/\r\n/g, '\n');
            let separatorIndex;
            while ((separatorIndex = sseBuffer.indexOf('\n\n')) >= 0) {
                const block = sseBuffer.slice(0, separatorIndex);
                sseBuffer = sseBuffer.slice(separatorIndex + 2);
                processSseBlock(block);
            }
        }

        function processSseBlock(block) {
            const lines = block.split('\n');
            let eventName = 'message';
            const dataLines = [];

            for (const line of lines) {
                if (line.startsWith('event:')) {
                    eventName = line.slice(6).trim();
                } else if (line.startsWith('data:')) {
                    dataLines.push(line.slice(5).trimStart());
                }
            }

            if (dataLines.length === 0) return;

            sawAnyEvent = true;
            const payload = dataLines.join('\n').trim();
            if (!payload || payload === '[DONE]') return;

            if (eventName === 'orr-meta') {
                applyMeta(payload);
                return;
            }

            appendResponsePayload(payload);
        }

        function appendResponsePayload(payload) {
            let obj = null;
            try {
                obj = JSON.parse(payload);
            } catch {
                appendPlainText(payload);
                return;
            }

            if (obj?.error) {
                appendPlainText('Ошибка: ' + formatError(obj.error));
                return;
            }

            appendChoiceText(obj);

            if (obj?.usage && typeof obj.usage === 'object') {
                applyUsage(obj.usage);
            }
        }

        function appendChoiceText(obj) {
            if (!Array.isArray(obj?.choices)) return;

            for (const choice of obj.choices) {
                const content = choice?.delta?.content
                    ?? choice?.message?.content
                    ?? choice?.text;

                if (typeof content === 'string' && content.length > 0) {
                    responseText += content;
                }

                if (choice?.finish_reason) {
                    completionReason = formatFinishReason(choice.finish_reason);
                }
            }
        }

        function appendPlainText(text) {
            if (!text) return;
            responseText += responseText ? '\n' + text : text;
        }

        function applyMeta(payload) {
            try {
                const meta = JSON.parse(payload);
                if (typeof meta.latency_ms === 'number') {
                    latencyEl.textContent = meta.latency_ms + ' ms (server)';
                    hasServerLatency = true;
                }
                if (typeof meta.status === 'number' && meta.status > 0) {
                    statusEl.textContent = meta.status;
                }
            } catch { /* ignore malformed meta */ }
        }

        function applyUsage(usage) {
            const prompt = usage.prompt_tokens ?? usage.input_tokens ?? '?';
            const completion = usage.completion_tokens ?? usage.output_tokens ?? '?';
            const total = usage.total_tokens ?? sumIfNumbers(prompt, completion) ?? '?';
            usageEl.textContent = `prompt=${prompt} | completion=${completion} | total=${total}`;
        }

        function flushBufferedText() {
            const tail = sseBuffer.trim();
            sseBuffer = '';
            if (tail) {
                if (tail.startsWith('data:') || tail.startsWith('event:')) {
                    processSseBlock(tail);
                } else {
                    appendResponsePayload(tail);
                }
            }
        }

        function renderOutput() {
            const parts = [];
            if (responseText) {
                parts.push(responseText);
            }
            if (statusMessage) {
                parts.push(statusMessage);
            }
            if (completionReason) {
                parts.push('Причина завершения: ' + completionReason);
            }
            outputEl.textContent = parts.join('\n\n');
        }

        function formatErrorBody(body, status) {
            if (!body || !body.trim()) {
                return `Сервер вернул ошибку HTTP ${status} без текста.`;
            }

            try {
                const obj = JSON.parse(body);
                if (obj?.error) {
                    return 'Ошибка: ' + formatError(obj.error);
                }
                if (typeof obj?.message === 'string') {
                    return 'Ошибка: ' + obj.message;
                }
            } catch { /* plain text body */ }

            return 'Ошибка: ' + body.trim();
        }

        function formatError(error) {
            if (typeof error === 'string') return error;
            const message = error?.message ?? error?.detail ?? error?.code ?? 'Неизвестная ошибка.';
            const code = error?.code && error.code !== message ? ` (${error.code})` : '';
            return message + code;
        }

        function formatFinishReason(reason) {
            switch (reason) {
                case 'stop':
                    return 'ответ завершён';
                case 'length':
                    return 'достигнут лимит длины';
                case 'content_filter':
                    return 'ответ остановлен фильтром';
                case 'tool_calls':
                    return 'модель запросила вызов инструмента';
                default:
                    return reason;
            }
        }

        function sumIfNumbers(left, right) {
            const leftNumber = Number(left);
            const rightNumber = Number(right);
            return Number.isFinite(leftNumber) && Number.isFinite(rightNumber)
                ? leftNumber + rightNumber
                : null;
        }
    })();
</script>
