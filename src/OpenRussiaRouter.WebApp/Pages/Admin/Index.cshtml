@page
@model Admin.IndexModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Dashboard - Admin"; }

<div class="adm-section-head">
    <h2>Dashboard</h2>
    <p>Admin account overview.</p>
</div>

<div class="adm-card">
    <div class="adm-card-header">Admin Account</div>
    <div class="adm-card-body">
        <div class="adm-info-row">
            <span class="adm-info-label">User ID</span>
            <span><code>@(Model.CurrentUser?.UserId ?? "—")</code></span>
        </div>
        <div class="adm-info-row">
            <span class="adm-info-label">Role</span>
            <span>@(Model.CurrentUser?.Role ?? "—")</span>
        </div>
    </div>
</div>

<div class="adm-card">
    <div class="adm-card-header">Platform settings</div>
    <div class="adm-card-body">
        @if (Model.SaveMessage != null)
        {
            <div class="alert alert-success" role="status">@Model.SaveMessage</div>
        }
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        <form method="post" asp-page-handler="SaveSettings">
            <div class="form-group">
                <label asp-for="PublicApiBaseUrl" class="form-label">Public API base URL</label>
                <input asp-for="PublicApiBaseUrl" class="form-control" placeholder="https://api.example.com" autocomplete="off" />
                <small class="text-muted">
                    User-facing endpoint of the ApiGateway shown in the Setup guide (the client <code>base_url</code>, without <code>/v1</code>).
                    Leave blank to fall back to the cabinet's own origin. Example for the VPS: <code>http://31.76.49.2:8080</code>.
                </small>
            </div>
            <div class="adm-btn-row">
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="adm-card">
    <div class="adm-card-header">Promotions</div>
    <div class="adm-card-body">
        <form method="post" asp-page-handler="SavePromo">
            <h5>Start Balance (after email verification)</h5>
            <div class="form-group form-check">
                <input asp-for="StartBalanceEnabled" class="form-check-input" />
                <label asp-for="StartBalanceEnabled" class="form-check-label">Enabled</label>
            </div>
            <div class="form-group">
                <label asp-for="StartBalanceAmountUsd" class="form-label">Amount (USD)</label>
                <input asp-for="StartBalanceAmountUsd" class="form-control" type="number" step="0.01" min="0.01" max="100" />
            </div>

            <hr />
            <h5>First Top-Up Bonus</h5>
            <div class="form-group form-check">
                <input asp-for="FirstTopUpEnabled" class="form-check-input" />
                <label asp-for="FirstTopUpEnabled" class="form-check-label">Enabled</label>
            </div>
            <div class="form-group">
                <label asp-for="FirstTopUpPercent" class="form-label">Bonus Percent (%)</label>
                <input asp-for="FirstTopUpPercent" class="form-control" type="number" step="0.01" min="0.01" max="100" />
            </div>

            <div class="adm-btn-row">
                <button type="submit" class="btn btn-primary">Save Promotions</button>
            </div>
        </form>
    </div>
</div>
