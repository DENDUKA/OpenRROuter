@page
@model Admin.ModelsModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Models - Admin"; }

<div class="adm-section-head">
    <h2>Models</h2>
    <p>Manage model catalog and routing metadata.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
}
@if (Model.WarningMessages.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <ul style="margin:0;padding-left:1.25rem">
            @foreach (var warning in Model.WarningMessages)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

@if (Model.ShowForm)
{
    <div class="adm-card">
        <div class="adm-card-header">@(Model.IsAdd ? "Add Model" : $"Edit Model: {Model.Form.Id}")</div>
        <div class="adm-card-body">
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>
            <form method="post" asp-page-handler="Save">
                <input type="hidden" name="isNew" value="@(Model.IsAdd ? "true" : "false")" />
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.Id" class="form-label">Model ID</label>
                        @if (Model.IsAdd)
                        {
                            <input asp-for="Form.Id" class="form-control" />
                        }
                        else
                        {
                            <input asp-for="Form.Id" class="form-control" readonly />
                        }
                        <span asp-validation-for="Form.Id" class="validation-message"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.DisplayName" class="form-label">Model Name</label>
                        <input asp-for="Form.DisplayName" class="form-control" />
                        <span asp-validation-for="Form.DisplayName" class="validation-message"></span>
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.RouterModelId" class="form-label">Router Model</label>
                        @{
                            var hasCurrent = !string.IsNullOrWhiteSpace(Model.Form.RouterModelId);
                            var currentMissing = hasCurrent && !Model.AvailableNodeModels.Contains(Model.Form.RouterModelId);
                        }
                        @if (Model.AvailableNodeModels.Count > 0 || currentMissing)
                        {
                            <select asp-for="Form.RouterModelId" class="form-control">
                                <option value="">— select from node —</option>
                                @if (currentMissing)
                                {
                                    <option value="@Model.Form.RouterModelId" selected>@Model.Form.RouterModelId (offline)</option>
                                }
                                @foreach (var modelId in Model.AvailableNodeModels)
                                {
                                    <option value="@modelId">@modelId</option>
                                }
                            </select>
                            @if (currentMissing)
                            {
                                <small class="text-muted">Current Router Model is not reported by any node right now — kept for safety.</small>
                            }
                        }
                        else
                        {
                            <input asp-for="Form.RouterModelId" class="form-control" placeholder="e.g. minimax/MiniMax-M2.7" />
                            <small class="text-muted">Nodes unavailable — enter model ID manually</small>
                        }
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.InputPrice" class="form-label">Input Price ($/1M)</label>
                        <input asp-for="Form.InputPrice" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Form.InputPrice" class="validation-message"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.OutputPrice" class="form-label">Output Price ($/1M)</label>
                        <input asp-for="Form.OutputPrice" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Form.OutputPrice" class="validation-message"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.CachePrice" class="form-label">Cache Price ($/1M)</label>
                        <input asp-for="Form.CachePrice" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Form.CachePrice" class="validation-message"></span>
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group" style="grid-column: span 3">
                        <label asp-for="Form.Description" class="form-label">Description <small class="text-muted">(optional)</small></label>
                        <textarea asp-for="Form.Description" class="form-control" rows="3" placeholder="Model description (auto-filled by Enrich from OpenRouter or enter manually)"></textarea>
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.ContextLength" class="form-label">Context Length (tokens)</label>
                        <input asp-for="Form.ContextLength" class="form-control" type="number" min="0" placeholder="e.g. 131072" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.Modalities" class="form-label">Modalities</label>
                        <input asp-for="Form.Modalities" class="form-control" placeholder="e.g. text, image" />
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group" style="grid-column: span 3">
                        <label class="form-label">Tags</label>
                        <div style="display:flex; flex-wrap:wrap; gap:0.5rem">
                            @foreach (var tag in Model.AvailableTags)
                            {
                                var isChecked = Model.Form.TagIds.Contains(tag.Id);
                                <label style="display:flex; align-items:center; gap:0.25rem; font-weight:normal;">
                                    <input type="checkbox" name="Form.TagIds" value="@tag.Id" @(isChecked ? "checked" : "") />
                                    @tag.DisplayName
                                </label>
                            }
                        </div>
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label class="form-label">
                            <input asp-for="Form.Enabled" type="checkbox" />
                            Enabled (model is available to API clients)
                        </label>
                    </div>
                </div>
                <div class="adm-btn-row">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a class="btn btn-secondary" href="/admin/models">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

<div class="adm-card">
    <div class="adm-card-header adm-card-header--split">
        <span>Public Models</span>
        <div class="adm-btn-row">
            <form method="post" asp-page-handler="Enrich" style="display:inline">
                <button type="submit" class="btn btn-sm btn-secondary">Enrich from OpenRouter</button>
            </form>
            <a class="btn btn-sm btn-secondary" href="/admin/models/sync">Sync from 9Router</a>
            <a class="btn btn-sm btn-primary" href="?action=add">Add Model</a>
        </div>
    </div>
    <div class="adm-card-body">
        @if (Model.Models.Count == 0)
        {
            <p class="text-muted">No models configured.</p>
        }
        else
        {
            <table class="table">
                <thead><tr>
                    <th>Model ID</th><th>Display Name</th><th>Router Model</th>
                    <th>Input / Output / Cache per 1M</th><th>Tags</th><th>Status</th><th>Source</th><th>Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var m in Model.Models)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <code>@m.Id</code>
                                    <button type="button" class="btn btn-icon copy-btn" data-model-id="@m.Id" onclick="copyModelId(event)" title="Copy Model ID" aria-label="Copy Model ID" style="padding: 4px; border: none; background: transparent; cursor: pointer;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                    </button>
                                </div>
                            </td>
                            <td>@m.DisplayName</td>
                            <td><code>@m.UpstreamModelId</code></td>
                            <td>@m.InputPrice.ToString("N2") / @m.OutputPrice.ToString("N2") / @m.CachePrice.ToString("N2") $</td>
                            <td>
                                @if (m.TagIds != null && m.TagIds.Count > 0)
                                {
                                    <div style="display:flex; flex-wrap:wrap; gap:0.25rem;">
                                        @foreach(var tid in m.TagIds)
                                        {
                                            Model.TagsById.TryGetValue(tid, out var t);
                                            <span class="badge" style="background-color: @(t?.Color ?? "#6c757d"); color: white;">@(t?.DisplayName ?? tid)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size:12px">&mdash;</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(m.Enabled ? "badge-success" : "badge-secondary")">
                                    @(m.Enabled ? "Enabled" : "Disabled")
                                </span>
                            </td>
                            <td>
                                @if (m.DescriptionSource == "openrouter")
                                {
                                    <span class="badge badge-info" title="Enriched from OpenRouter">OR</span>
                                }
                                else if (m.DescriptionSource == "manual")
                                {
                                    <span class="badge badge-secondary" title="Manually entered">manual</span>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size:12px">&mdash;</span>
                                }
                            </td>
                            <td class="adm-actions-cell">
                                <a class="btn-icon" title="Edit" aria-label="Edit"
                                   href="?action=edit&modelId=@Uri.EscapeDataString(m.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </a>
                                <form method="post" asp-page-handler="ToggleEnabled" style="display:inline">
                                    <input type="hidden" name="modelId" value="@m.Id" />
                                    <button type="submit" class="btn-icon" title="@(m.Enabled ? "Disable" : "Enable")"
                                            aria-label="@(m.Enabled ? "Disable" : "Enable")">
                                        @if (m.Enabled)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        }
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .copy-btn:hover { color: var(--color-primary); }
</style>
