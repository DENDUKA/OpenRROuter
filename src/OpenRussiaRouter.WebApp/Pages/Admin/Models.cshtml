@page
@model Admin.ModelsModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Models - Admin"; }

<div class="adm-section-head">
    <h2>Models</h2>
    <p>Manage model catalog and routing metadata.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
}
@if (Model.WarningMessages.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <ul style="margin:0;padding-left:1.25rem">
            @foreach (var warning in Model.WarningMessages)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

@if (Model.ShowForm)
{
    <div class="adm-card">
        <div class="adm-card-header">@(Model.IsAdd ? "Add Model" : $"Edit Model: {Model.Form.Id}")</div>
        <div class="adm-card-body">
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>
            <form method="post" asp-page-handler="Save">
                <input type="hidden" name="isNew" value="@(Model.IsAdd ? "true" : "false")" />
                
                <h5 class="adm-form-group-title">Basic Info</h5>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.Id" class="form-label">Model ID</label>
                        @if (Model.IsAdd)
                        {
                            <input asp-for="Form.Id" class="form-control" />
                        }
                        else
                        {
                            <input asp-for="Form.Id" class="form-control" readonly />
                        }
                        <span asp-validation-for="Form.Id" class="validation-message"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.DisplayName" class="form-label">Model Name</label>
                        <input asp-for="Form.DisplayName" class="form-control" />
                        <span asp-validation-for="Form.DisplayName" class="validation-message"></span>
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group" style="position: relative;">
                        <label asp-for="Form.RouterModelId" class="form-label">Router Model</label>
                        @{
                            var hasCurrent = !string.IsNullOrWhiteSpace(Model.Form.RouterModelId);
                            var currentMissing = hasCurrent && !Model.AvailableNodeModels.Contains(Model.Form.RouterModelId);
                        }
                        @if (Model.AvailableNodeModels.Count > 0 || currentMissing)
                        {
                            <select asp-for="Form.RouterModelId" class="form-control" id="routerModelIdSelect">
                                <option value="">— select from node —</option>
                                @if (currentMissing)
                                {
                                    <option value="@Model.Form.RouterModelId" selected>@Model.Form.RouterModelId (offline)</option>
                                }
                                @foreach (var modelId in Model.AvailableNodeModels)
                                {
                                    <option value="@modelId">@modelId</option>
                                }
                            </select>
                            @if (currentMissing)
                            {
                                <small class="text-muted">Current Router Model is not reported by any node right now — kept for safety.</small>
                            }
                        }
                        else
                        {
                            <input asp-for="Form.RouterModelId" class="form-control" id="routerModelIdSelect" placeholder="e.g. minimax/MiniMax-M2.7" />
                            <small class="text-muted">Nodes unavailable — enter model ID manually</small>
                        }
                        <div id="orPriceDisplay" style="font-size: 13px; margin-top: 0.4rem;"></div>
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.ModelType" class="form-label">Model Type</label>
                        <select asp-for="Form.ModelType" class="form-control">
                            @foreach (var t in Model.ModelTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.Provider" class="form-label">Provider</label>
                        <input asp-for="Form.Provider" class="form-control" placeholder="e.g. OpenAI" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.Priority" class="form-label">Priority <small class="text-muted">(catalog sort order)</small></label>
                        <input asp-for="Form.Priority" class="form-control" type="number" min="0" step="1" />
                        <small class="text-muted">Higher number shows the model higher on the public /models page.</small>
                        <span asp-validation-for="Form.Priority" class="validation-message"></span>
                    </div>
                    <div class="form-group" style="align-self: center; margin-top: 1.5rem;">
                        <label class="form-label" style="margin-bottom: 0;">
                            <input asp-for="Form.Enabled" type="checkbox" />
                            Enabled (model is available to API clients)
                        </label>
                    </div>
                </div>

                <h5 class="adm-form-group-title">Pricing</h5>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.InputPrice" class="form-label">Input Price ($/1M)</label>
                        <input asp-for="Form.InputPrice" class="form-control" type="number" step="0.000001" />
                        <span asp-validation-for="Form.InputPrice" class="validation-message"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.OutputPrice" class="form-label">Output Price ($/1M)</label>
                        <input asp-for="Form.OutputPrice" class="form-control" type="number" step="0.000001" />
                        <span asp-validation-for="Form.OutputPrice" class="validation-message"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.CachePrice" class="form-label">Cache Price ($/1M)</label>
                        <input asp-for="Form.CachePrice" class="form-control" type="number" step="0.000001" />
                        <span asp-validation-for="Form.CachePrice" class="validation-message"></span>
                    </div>
                </div>

                <h5 class="adm-form-group-title">Capabilities & Modalities</h5>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.ContextLength" class="form-label">Context Length (tokens)</label>
                        <input asp-for="Form.ContextLength" class="form-control" type="number" min="0" placeholder="e.g. 131072" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.Modalities" class="form-label">Modalities <small class="text-muted">(legacy)</small></label>
                        <input asp-for="Form.Modalities" class="form-control" placeholder="e.g. text, image" />
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label class="form-label">Input Modalities</label>
                        <div class="modality-checks" id="inputModalitiesChecks">
                            @foreach (var mod in Model.ModalityTypes)
                            {
                                var isChecked = (Model.Form.InputModalities ?? "").Contains(mod, StringComparison.OrdinalIgnoreCase);
                                <label class="modality-check">
                                    <input type="checkbox" data-modality="@mod" data-target="InputModalities" @(isChecked ? "checked" : "") onchange="syncModalityChecks(this)" />
                                    <span class="modality-icon">@Html.Raw(Admin.ModelsModel.ModalityIcon(mod))</span> @mod
                                </label>
                            }
                        </div>
                        <input type="hidden" asp-for="Form.InputModalities" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Output Modalities</label>
                        <div class="modality-checks" id="outputModalitiesChecks">
                            @foreach (var mod in Model.ModalityTypes)
                            {
                                var isChecked = (Model.Form.OutputModalities ?? "").Contains(mod, StringComparison.OrdinalIgnoreCase);
                                <label class="modality-check">
                                    <input type="checkbox" data-modality="@mod" data-target="OutputModalities" @(isChecked ? "checked" : "") onchange="syncModalityChecks(this)" />
                                    <span class="modality-icon">@Html.Raw(Admin.ModelsModel.ModalityIcon(mod))</span> @mod
                                </label>
                            }
                        </div>
                        <input type="hidden" asp-for="Form.OutputModalities" />
                    </div>
                </div>

                <h5 class="adm-form-group-title">Reasoning (Thinking)</h5>
                <div class="adm-form-row">
                    <div class="form-group" style="grid-column: span 3">
                        <label class="form-label" style="margin-bottom: 0;">
                            <input asp-for="Form.SupportsReasoning" type="checkbox" id="supportsReasoning" />
                            Supports reasoning
                        </label>
                    </div>
                </div>
                @if (Model.Form.ThinkingOptions?.Count > 0)
                {
                    <div class="adm-form-row">
                        <div class="form-group" style="grid-column: span 3">
                            <label class="form-label">Reasoning capabilities <small class="text-muted">(from 9Router — read only)</small></label>
                            <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center;">
                                @if (!string.IsNullOrWhiteSpace(Model.Form.ThinkingFormat))
                                {
                                    <span class="badge badge-info">thinkingFormat: @Model.Form.ThinkingFormat</span>
                                }
                                <span class="badge @(Model.Form.ThinkingCanDisable ? "badge-success" : "badge-warning")">
                                    thinkingCanDisable: @(Model.Form.ThinkingCanDisable ? "yes" : "no")
                                </span>
                                <span class="text-muted">Options:</span>
                                @foreach (var opt in Model.Form.ThinkingOptions)
                                {
                                    <span class="badge badge-secondary">@opt</span>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="adm-form-row">
                    <div class="form-group" style="grid-column: span 2">
                        <label class="form-label">Allowed efforts <small class="text-muted">(from 9Router catalog)</small></label>
                        <div id="allowedReasoningEfforts" style="display:flex; flex-wrap:wrap; gap:0.75rem">
                            @foreach (var effort in Model.AvailableReasoningEfforts)
                            {
                                var selected = Model.Form.AllowedReasoningEfforts.Contains(effort, StringComparer.Ordinal);
                                <label style="display:flex; align-items:center; gap:0.25rem; font-weight:normal;">
                                    <input type="checkbox" name="Form.AllowedReasoningEfforts" value="@effort" @(selected ? "checked" : "") />
                                    @effort
                                </label>
                            }
                            @if (Model.AvailableReasoningEfforts.Count == 0)
                            {
                                <small class="text-muted">No reasoning capabilities reported by 9Router for this model.</small>
                            }
                        </div>
                        <span asp-validation-for="Form.AllowedReasoningEfforts" class="validation-message"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.DefaultReasoningEffort" class="form-label">Default effort <small class="text-muted">(optional)</small></label>
                        <select asp-for="Form.DefaultReasoningEffort" class="form-control" id="defaultReasoningEffort">
                            <option value="">— none —</option>
                            @foreach (var effort in Model.AvailableReasoningEfforts)
                            {
                                var selected = string.Equals(Model.Form.DefaultReasoningEffort, effort, StringComparison.Ordinal);
                                <option value="@effort" selected="@(selected ? "selected" : null)">@effort</option>
                            }
                        </select>
                        <small class="text-muted">Must be one of the allowed efforts.</small>
                        <span asp-validation-for="Form.DefaultReasoningEffort" class="validation-message"></span>
                    </div>
                </div>

                <h5 class="adm-form-group-title">Enrichment & Metadata</h5>
                <div class="adm-form-row">
                    <div class="form-group" style="grid-column: span 3">
                        <label asp-for="Form.Description" class="form-label">Description <small class="text-muted">(optional)</small></label>
                        <textarea asp-for="Form.Description" class="form-control" rows="3" placeholder="Model description (auto-filled by Enrich from OpenRouter or enter manually)"></textarea>
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group" style="grid-column: span 3">
                        <label class="form-label">Tags</label>
                        <div style="display:flex; flex-wrap:wrap; gap:0.5rem">
                            @foreach (var tag in Model.AvailableTags)
                            {
                                var isChecked = Model.Form.TagIds.Contains(tag.Id);
                                <label style="display:flex; align-items:center; gap:0.25rem; font-weight:normal;">
                                    <input type="checkbox" name="Form.TagIds" value="@tag.Id" @(isChecked ? "checked" : "") />
                                    @tag.DisplayName
                                </label>
                            }
                        </div>
                    </div>
                </div>
                <div class="adm-form-row adm-enrich-row" style="margin-top: 0.5rem; padding-top: 1rem; border-top: 1px dashed var(--color-hairline);">
                    <div class="form-group" style="flex:1 1 auto">
                        <label class="form-label">OpenRouter model ID <small class="text-muted">(optional — leave blank to auto-match)</small></label>
                        <input name="openRouterId" class="form-control" value="@Model.EnrichOpenRouterId"
                               placeholder="e.g. openai/gpt-4o" autocomplete="off"
                               @(Model.EnrichNotFound ? "autofocus" : "") />
                    </div>
                    <div class="form-group" style="align-self:flex-end">
                        <button type="submit" asp-page-handler="EnrichModel" class="btn btn-secondary"
                                title="Fetch description, context length, modalities, provider and prices from OpenRouter into the fields above. Review, then Save.">
                            Fetch from OpenRouter
                        </button>
                        <label style="display:flex; align-items:center; gap:0.35rem; font-weight:normal; margin-top:0.4rem;">
                            <input type="checkbox" name="fillPrices" value="true" @(Model.EnrichFillPrices ? "checked" : "") />
                            Fill price fields
                        </label>
                    </div>
                </div>

                <div class="adm-btn-row" style="margin-top: 2rem;">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a class="btn btn-secondary" href="/admin/models">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

<div class="adm-card">
    <div class="adm-card-header adm-card-header--split">
        <span>Public Models</span>
        <div class="adm-btn-row">
            <form method="post" asp-page-handler="Enrich" style="display:inline">
                <button type="submit" class="btn btn-sm btn-secondary">Enrich from OpenRouter</button>
            </form>
            <a class="btn btn-sm btn-secondary" href="/admin/models/sync">Sync from 9Router</a>
            <a class="btn btn-sm btn-primary" href="?action=add">Add Model</a>
        </div>
    </div>
    <div class="adm-card-body">
        @if (Model.Models.Count == 0)
        {
            <p class="text-muted">No models configured.</p>
        }
        else
        {
            <table class="table">
                <thead><tr>
                    <th>Model ID</th><th>Display Name</th><th>Type</th><th>Router Model</th>
                    <th>Pricing</th><th>Tags</th><th>Status</th><th>Priority</th><th>Source</th><th>Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var m in Model.Models)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <code>@m.Id</code>
                                    <button type="button" class="btn btn-icon copy-btn" data-model-id="@m.Id" onclick="copyModelId(event)" title="Copy Model ID" aria-label="Copy Model ID" style="padding: 4px; border: none; background: transparent; cursor: pointer;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                    </button>
                                </div>
                            </td>
                            <td>@m.DisplayName</td>
                            <td>
                                @if (m.ModelType == "audio")
                                {
                                    <span class="badge badge-info" title="Audio model - billed by input characters">audio</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">text</span>
                                }
                            </td>
                            <td><code>@m.UpstreamModelId</code></td>
                            <td>
                                @if (m.ModelType == "audio")
                                {
                                    <span>Audio chars / 1M = @m.OutputPrice.ToString("N2") $</span>
                                }
                                else
                                {
                                    <span>@m.InputPrice.ToString("N2") / @m.OutputPrice.ToString("N2") / @m.CachePrice.ToString("N2") $</span>
                                }
                            </td>
                            <td>
                                @if (m.TagIds != null && m.TagIds.Count > 0)
                                {
                                    <div style="display:flex; flex-wrap:wrap; gap:0.25rem;">
                                        @foreach(var tid in m.TagIds)
                                        {
                                            Model.TagsById.TryGetValue(tid, out var t);
                                            <span class="badge" style="background-color: @(t?.Color ?? "#6c757d"); color: @ColorContrast.TextColor(t?.Color ?? "#6c757d");">@(t?.DisplayName ?? tid)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size:12px">&mdash;</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(m.Enabled ? "badge-success" : "badge-secondary")">
                                    @(m.Enabled ? "Enabled" : "Disabled")
                                </span>
                            </td>
                            <td><code>@m.Priority</code></td>
                            <td>
                                @if (m.DescriptionSource == "openrouter")
                                {
                                    <span class="badge badge-info" title="Enriched from OpenRouter">OR</span>
                                }
                                else if (m.DescriptionSource == "manual")
                                {
                                    <span class="badge badge-secondary" title="Manually entered">manual</span>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size:12px">&mdash;</span>
                                }
                            </td>
                            <td class="adm-actions-cell">
                                <a class="btn-icon" title="Edit" aria-label="Edit"
                                   href="?action=edit&modelId=@Uri.EscapeDataString(m.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </a>
                                <form method="post" asp-page-handler="ToggleEnabled" style="display:inline">
                                    <input type="hidden" name="modelId" value="@m.Id" />
                                    <button type="submit" class="btn-icon" title="@(m.Enabled ? "Disable" : "Enable")"
                                            aria-label="@(m.Enabled ? "Disable" : "Enable")">
                                        @if (m.Enabled)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        }
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .copy-btn:hover { color: var(--color-primary); }
    .adm-enrich-row { display: flex; gap: 1rem; align-items: flex-end; }
    .modality-checks { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .modality-check { display: inline-flex; align-items: center; gap: 0.3rem; padding: 4px 10px; border: 1px solid var(--color-hairline); border-radius: var(--radius-pill); cursor: pointer; font-size: 13px; user-select: none; transition: background .15s, border-color .15s; }
    .modality-check:has(input:checked) { background: var(--color-canvas-card); border-color: var(--color-ink); }
    .modality-check input { display: none; }
    .modality-icon { display: inline-flex; align-items: center; }
    .adm-form-group-title { margin-top: 1.5rem; margin-bottom: 1rem; padding-bottom: 0.25rem; border-bottom: 1px solid var(--color-hairline); color: var(--color-text); font-weight: 600; font-size: 1.1rem; }
    .adm-form-group-title:first-of-type { margin-top: 0; }
</style>

<script>
    function syncModalityChecks(checkbox) {
        const target = checkbox.dataset.target;
        const group = checkbox.closest('.modality-checks');
        const hidden = group.parentElement.querySelector('input[type="hidden"]');
        const checked = Array.from(group.querySelectorAll('input[type="checkbox"]:checked'))
            .map(cb => cb.dataset.modality);
        hidden.value = checked.join(', ');
    }

    (() => {
        const supports = document.getElementById('supportsReasoning');
        const allowed = document.getElementById('allowedReasoningEfforts');
        const def = document.getElementById('defaultReasoningEffort');
        if (!supports || !allowed || !def) return;

        const effortBoxes = Array.from(allowed.querySelectorAll('input[type="checkbox"]'));

        const syncReasoningControls = () => {
            const enabled = supports.checked;
            effortBoxes.forEach(box => { box.disabled = !enabled; });
            def.disabled = !enabled;

            if (!enabled) {
                effortBoxes.forEach(box => { box.checked = false; });
                def.value = '';
                Array.from(def.options).forEach(option => option.hidden = false);
                return;
            }

            const selected = new Set(effortBoxes.filter(box => box.checked).map(box => box.value));
            Array.from(def.options).forEach(option => {
                if (option.value === '') {
                    option.hidden = false;
                    return;
                }

                option.hidden = !selected.has(option.value);
                if (option.hidden && option.selected) {
                    def.value = '';
                }
            });
        };

        supports.addEventListener('change', syncReasoningControls);
        effortBoxes.forEach(box => box.addEventListener('change', syncReasoningControls));
        syncReasoningControls();
    })();

    document.querySelectorAll('.modality-checks').forEach(group => {
        group.querySelectorAll('input[type="checkbox"]').forEach(cb => syncModalityChecks(cb));
    });

    (() => {
        const routerModelInput = document.getElementById('routerModelIdSelect');
        const orPriceDisplay = document.getElementById('orPriceDisplay');
        
        if (!routerModelInput || !orPriceDisplay) return;

        let debounceTimer;

        async function fetchOpenRouterPrice(modelId) {
            if (!modelId) {
                orPriceDisplay.innerHTML = '';
                return;
            }

            orPriceDisplay.innerHTML = '<span class="text-muted">Fetching OpenRouter price...</span>';

            try {
                const response = await fetch(`?handler=OpenRouterPrice&modelId=${encodeURIComponent(modelId)}`, {
                    headers: { 'Accept': 'application/json' }
                });
                
                if (!response.ok) throw new Error('Network response was not ok');
                
                const data = await response.json();
                
                if (data.success) {
                    const formatPrice = p => p !== null ? `$${p.toFixed(2)}` : 'N/A';
                    orPriceDisplay.innerHTML = `<span style="color: var(--color-success);">OpenRouter cost (per 1M): Prompt ${formatPrice(data.inputPrice)} / Completion ${formatPrice(data.outputPrice)}</span>`;
                } else {
                    orPriceDisplay.innerHTML = `<span style="color: var(--color-danger);">${data.error}</span>`;
                }
            } catch (error) {
                orPriceDisplay.innerHTML = '<span style="color: var(--color-danger);">Failed to fetch price.</span>';
            }
        }

        routerModelInput.addEventListener('change', (e) => {
            fetchOpenRouterPrice(e.target.value.trim());
        });

        // For text input we want to debounce the fetching
        if (routerModelInput.tagName === 'INPUT') {
            routerModelInput.addEventListener('input', (e) => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    fetchOpenRouterPrice(e.target.value.trim());
                }, 500);
            });
        }

        // Fetch price initially if there's a selected value
        if (routerModelInput.value) {
            fetchOpenRouterPrice(routerModelInput.value.trim());
        }
    })();
</script>
