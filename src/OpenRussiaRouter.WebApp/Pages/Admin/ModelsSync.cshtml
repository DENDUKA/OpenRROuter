@page "/admin/models/sync"
@model Admin.ModelsSyncModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Sync Models - Admin"; }

<style>
    .models-sync-table-wrap { overflow-x: auto; }
    .models-sync-table { min-width: 1100px; }
    .models-sync-table code,
    .models-sync-table th,
    .models-sync-table .nowrap { white-space: nowrap; }
    .models-sync-table .price-input { width: 6.5em; }
    .models-sync-table .node-id { font-family: monospace; font-size: 0.9em; cursor: help; }
</style>

<div class="adm-section-head">
    <h2>Sync Models</h2>
    <p>Compare node catalogs with billing models and import new entries.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (Model.WarningMessages.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <ul style="margin:0;padding-left:1.25rem">
            @foreach (var warning in Model.WarningMessages)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}
@if (Model.UnreachableNodeIds.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>NODE PROBE REPORT (@Model.UnreachableNodeIds.Count failed):</strong>
        @if (Model.UnreachableNodes.Count == 0)
        {
            <div style="margin-top:0.5rem">@string.Join(", ", Model.UnreachableNodeIds)</div>
            <div style="margin-top:0.5rem;font-size:0.9em;opacity:0.85">(probe failed — details unavailable)</div>
        }
        else
        {
            @foreach (var detail in Model.UnreachableNodes)
            {
                <div style="margin-top:1rem;padding:0.6rem 0.75rem;background:rgba(0,0,0,0.15);border-radius:4px">
                    <div><strong>Node:</strong> <code>@detail.NodeId</code></div>
                    <div style="margin-top:0.4rem"><strong>Request:</strong></div>
                    <pre style="white-space:pre-wrap;word-break:break-all;margin:0.2rem 0;font-size:0.85em">@(string.IsNullOrWhiteSpace(detail.Request) ? "(not captured)" : detail.Request)</pre>
                    <div style="margin-top:0.4rem"><strong>Response:</strong></div>
                    <pre style="white-space:pre-wrap;word-break:break-all;margin:0.2rem 0;font-size:0.85em">@(string.IsNullOrWhiteSpace(detail.Response) ? "(no response — connection failed)" : detail.Response)</pre>
                </div>
            }
        }
    </div>
}
@if (Model.ShowAddNodeMessage)
{
    <div class="alert alert-info" role="status">Add a node first.</div>
}

@if (Model.CatalogUnavailable && Model.BillingOnlyModels.Count > 0)
{
    <div class="adm-card">
        <div class="adm-card-header">Billing Catalog</div>
        <div class="adm-card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Billing ID</th>
                        <th>Display Name</th>
                        <th>Router Model</th>
                        <th>Status</th>
                        <th>Input / Output / Cache per 1M</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.BillingOnlyModels)
                    {
                        <tr>
                            <td><code>@m.Id</code></td>
                            <td>@m.DisplayName</td>
                            <td><code>@m.UpstreamModelId</code></td>
                            <td>
                                <span class="badge @(m.Enabled ? "badge-success" : "badge-secondary")">
                                    @(m.Enabled ? "Enabled" : "Disabled")
                                </span>
                            </td>
                            <td>@m.InputPrice.ToString("N2") / @m.OutputPrice.ToString("N2") / @m.CachePrice.ToString("N2") RUB</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.CatalogUnavailable && !Model.BillingUnavailable)
{
    <div class="adm-card">
        <div class="adm-card-header">New On Nodes</div>
        <div class="adm-card-body">
            @if (Model.NewOnNodes.Count == 0)
            {
                <p class="text-muted">No new node models to import.</p>
            }
            else
            {
                <form method="post" asp-page-handler="Import">
                    <div asp-validation-summary="ModelOnly" class="validation-message"></div>
                    <div class="adm-form-row">
                        <div class="form-group">
                            <label asp-for="Form.Prefix" class="form-label">Public ID Prefix</label>
                            <input asp-for="Form.Prefix" class="form-control" placeholder="myorg/" data-testid="models-sync-prefix" />
                            <small class="text-muted">Applied to every Suggested Billing ID below.</small>
                        </div>
                    </div>
                    <div class="models-sync-table-wrap">
                        <table class="table models-sync-table" data-testid="models-sync-new-table">
                            <thead>
                                <tr>
                                    <th>Import</th>
                                    <th>Suggested Billing ID</th>
                                    <th>Display Name</th>
                                    <th>Router Model</th>
                                    <th>Type</th>
                                    <th>Input&nbsp;RUB/1M</th>
                                    <th>Output&nbsp;RUB/1M</th>
                                    <th>Cache&nbsp;RUB/1M</th>
                                    <th>Enabled</th>
                                    <th>Providers</th>
                                    <th>Nodes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var display in Model.RowDisplays)
                                {
                                    var i = display.FormIndex;
                                    var entry = display.Entry;
                                    var nodeIdsTitle = string.Join(", ", entry.NodeIds);
                                    var routerModelId = Admin.ModelsSyncModel.GetRouterModelId(entry);
                                    <tr data-testid="models-sync-row" data-upstream-id="@entry.UpstreamId">
                                        <td>
                                            <input asp-for="Form.Rows[i].UpstreamId" type="hidden" />
                                            <input asp-for="Form.Rows[i].Selected" type="checkbox" data-testid="models-sync-checkbox" />
                                        </td>
                                        <td><code>@(Model.Form.Prefix + routerModelId)</code></td>
                                        <td class="nowrap">@entry.DisplayName</td>
                                        <td><code title="Node internal ID: @entry.UpstreamId">@routerModelId</code></td>
                                        <td>@entry.ModelType</td>
                                        <td>
                                            <input asp-for="Form.Rows[i].InputPrice"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control price-input"
                                                   data-testid="models-sync-row-input-price" />
                                            <span asp-validation-for="Form.Rows[i].InputPrice" class="validation-message"></span>
                                        </td>
                                        <td>
                                            <input asp-for="Form.Rows[i].OutputPrice"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control price-input"
                                                   data-testid="models-sync-row-output-price" />
                                            <span asp-validation-for="Form.Rows[i].OutputPrice" class="validation-message"></span>
                                        </td>
                                        <td>
                                            <input asp-for="Form.Rows[i].CachePrice"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control price-input"
                                                   data-testid="models-sync-row-cache-price" />
                                            <span asp-validation-for="Form.Rows[i].CachePrice" class="validation-message"></span>
                                        </td>
                                        <td>
                                            <input asp-for="Form.Rows[i].Enabled" type="checkbox" data-testid="models-sync-row-enabled" />
                                        </td>
                                        <td class="nowrap">@string.Join(", ", entry.SourceProviders)</td>
                                        <td title="@nodeIdsTitle">
                                            @if (entry.NodeIds.Count == 0)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else if (entry.NodeIds.Count == 1)
                                            {
                                                <span class="node-id">@(entry.NodeIds[0].Length > 8 ? entry.NodeIds[0][..8] + "…" : entry.NodeIds[0])</span>
                                            }
                                            else
                                            {
                                                <span class="node-id">@entry.NodeIds.Count nodes</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="adm-btn-row">
                        <button type="submit" class="btn btn-primary" formnovalidate data-testid="models-sync-submit">Import Selected</button>
                        <a class="btn btn-secondary" href="/admin/models">Back to Models</a>
                    </div>
                </form>
            }
        </div>
    </div>
}

@if (!Model.CatalogUnavailable && Model.Configured.Count > 0)
{
    <div class="adm-card">
        <div class="adm-card-header">Configured</div>
        <div class="adm-card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Billing ID</th>
                        <th>Billing Display Name</th>
                        <th>Router Model</th>
                        <th>Type</th>
                        <th>Providers</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Configured)
                    {
                        <tr>
                            <td><code>@row.BillingId</code></td>
                            <td>@row.BillingDisplayName</td>
                            <td><code>@row.UpstreamId</code></td>
                            <td>@row.ModelType</td>
                            <td>@string.Join(", ", row.SourceProviders)</td>
                            <td>
                                <span class="badge @(row.Enabled ? "badge-success" : "badge-secondary")">
                                    @(row.Enabled ? "Enabled" : "Disabled")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.MissingFromNodesSuppressed)
{
    <div class="alert alert-info" role="status">Missing-from-nodes rows are hidden while some nodes are unreachable.</div>
}
else if (!Model.CatalogUnavailable && Model.MissingFromNodes.Count > 0)
{
    <div class="adm-card">
        <div class="adm-card-header">Missing From Nodes</div>
        <div class="adm-card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Billing ID</th>
                        <th>Display Name</th>
                        <th>Router Model</th>
                        <th>Status</th>
                        <th>Input / Output / Cache per 1M</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.MissingFromNodes)
                    {
                        <tr>
                            <td><code>@row.Id</code></td>
                            <td>@row.DisplayName</td>
                            <td><code>@row.UpstreamModelId</code></td>
                            <td>
                                <span class="badge @(row.Enabled ? "badge-success" : "badge-secondary")">
                                    @(row.Enabled ? "Enabled" : "Disabled")
                                </span>
                            </td>
                            <td>@row.InputPrice.ToString("N2") / @row.OutputPrice.ToString("N2") / @row.CachePrice.ToString("N2") RUB</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
