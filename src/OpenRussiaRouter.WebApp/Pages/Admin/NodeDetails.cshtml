@page "/admin/nodes/{nodeId}"
@model Admin.NodeDetailsModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Router Node - Admin"; }

<div class="adm-section-head">
    <h2>Router Node</h2>
    <p>Connection and integration API status.</p>
</div>

<div class="adm-btn-row">
    <a class="btn btn-secondary" href="/admin/nodes">Back to nodes</a>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert" data-testid="error-message">@Model.ErrorMessage</div>
}

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success" role="status" data-testid="success-message">@Model.SuccessMessage</div>
}

@if (Model.Details is { } details)
{
    <div class="adm-card" data-testid="node-details-card">
        <div class="adm-card-header adm-card-header--split">
            <span>@details.Node.Name</span>
            <span class="badge @Admin.NodeDetailsModel.GetNodeStatusBadge(details.Node.Status)" data-testid="node-status">@details.Node.Status</span>
        </div>
        <div class="adm-card-body">
            <table class="table">
                <tbody>
                    <tr><th>Node ID</th><td><code>@details.Node.NodeId</code></td></tr>
                    <tr><th>Endpoint</th><td><code>@details.Node.EndpointUrl</code></td></tr>
                    <tr><th>Control token</th><td><code>@details.Node.ControlToken</code></td></tr>
                    <tr><th>Capacity weight</th><td>@details.Node.CapacityWeight</td></tr>
                    <tr><th>In-flight requests</th><td>@details.Node.InFlightRequests</td></tr>
                    <tr><th>Last checked</th><td>@(details.Node.LastCheckedAt?.ToLocalTime().ToString("g") ?? "Never")</td></tr>
                    <tr><th>Last health error</th><td>@(string.IsNullOrWhiteSpace(details.Node.LastHealthErrorCode) ? "None" : details.Node.LastHealthErrorCode)</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="adm-card" data-testid="control-token-card">
        <div class="adm-card-header">Update Control Token</div>
        <div class="adm-card-body">
            @if (Model.AvailabilityCheckResult is { } checkResult)
            {
                <div class="alert @(checkResult.Success ? "alert-success" : "alert-danger")" role="status" data-testid="control-token-check-result">
                    <div><strong>@(checkResult.Success ? "Integration API is reachable." : "Integration API check failed.")</strong></div>
                    <div><code>@checkResult.RequestLine</code></div>
                    <pre style="white-space:pre-wrap;word-break:break-word;margin:0.5rem 0 0;font-size:0.85em">@checkResult.ResponseLine</pre>
                </div>
            }

            @if (Model.CatalogProbeResult is { } probeResult)
            {
                var probeOk = probeResult.ResponseLine?.StartsWith("HTTP 2", StringComparison.Ordinal) == true;
                <div class="alert @(probeOk ? "alert-success" : "alert-danger")" role="status" data-testid="control-token-probe-catalog-result">
                    <div><strong>@(probeOk ? "Catalog endpoint is reachable." : "Catalog endpoint check failed.")</strong></div>
                    <div class="text-muted" style="font-size:0.85em;margin-top:0.25rem">
                        Probes <code>/api/integrations/providers</code> with the form's control token.
                        This is what the Sync flow uses — distinct from Integration API (keys) check.
                    </div>
                    <div style="margin-top:0.5rem"><code>@probeResult.RequestLine</code></div>
                    <pre style="white-space:pre-wrap;word-break:break-word;margin:0.5rem 0 0;font-size:0.85em">@probeResult.ResponseLine</pre>
                </div>
            }

            <form method="post" asp-route-nodeId="@details.Node.NodeId" data-testid="form-update-control-token">
                <div class="form-group">
                    <label asp-for="TokenForm.ControlToken" class="form-label">Control Token</label>
                    <input asp-for="TokenForm.ControlToken" class="form-control" autocomplete="off"
                           data-testid="input-control-token" />
                </div>
                <div class="adm-btn-row">
                    <button type="submit" class="btn btn-secondary" asp-page-handler="CheckControlToken"
                            data-testid="btn-check-control-token">Check Integration API</button>
                    <button type="submit" class="btn btn-secondary" asp-page-handler="ProbeCatalog"
                            data-testid="btn-probe-catalog-control-token">Probe Catalog</button>
                    <button type="submit" class="btn btn-primary" asp-page-handler="UpdateControlToken"
                            data-testid="btn-save-control-token">Save token</button>
                </div>
            </form>
        </div>
    </div>

    @if (details.ApiError != null)
    {
        <div class="alert alert-warning" role="alert" data-testid="api-error">@details.ApiError</div>
    }

    <div class="adm-card" data-testid="provider-quota-card">
        <div class="adm-card-header">Provider Connections</div>
        <div class="adm-card-body">
            @if (details.Providers.Count == 0)
            {
                <p class="text-muted">No provider quota data returned.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Provider</th>
                            <th>Connection</th>
                            <th>Auth</th>
                            <th>Status</th>
                            <th>Test</th>
                            <th>Usage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var provider in details.Providers)
                        {
                            <tr data-testid="provider-row" data-connection-id="@provider.ConnectionId">
                                <td><code>@provider.Provider</code></td>
                                <td>
                                    <div>@provider.Name</div>
                                    <small class="text-muted">@provider.ConnectionId</small>
                                </td>
                                <td>@provider.AuthType</td>
                                <td><span class="badge @Admin.NodeDetailsModel.GetStatusBadge(provider.IsActive)">@(provider.IsActive ? "active" : "inactive")</span></td>
                                <td>@(provider.TestStatus ?? "-")</td>
                                <td>
                                    @if (provider.Error != null)
                                    {
                                        <span class="text-danger">@provider.Error</span>
                                    }
                                    else if (provider.UsageJson != null)
                                    {
                                        <pre style="white-space:pre-wrap;word-break:break-word;margin:0;font-size:0.85em">@Admin.NodeDetailsModel.FormatJson(provider.UsageJson)</pre>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No usage</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="adm-card" data-testid="integration-keys-card">
        <div class="adm-card-header adm-card-header--split">
            <span>Service-managed Keys</span>
            <form method="post" asp-route-nodeId="@details.Node.NodeId" class="m-0">
                <button type="submit" class="btn btn-sm btn-secondary mr-2" asp-page-handler="CheckSync" data-testid="btn-check-sync">
                    Is Sync
                </button>
                <button type="submit" class="btn btn-sm btn-primary" asp-page-handler="SyncKeys" data-testid="btn-sync-keys">
                    Sync Keys
                </button>
            </form>
        </div>
        <div class="adm-card-body">
            @if (details.Keys.Count == 0)
            {
                <p class="text-muted">No service-managed keys returned.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Preview</th>
                            <th>Machine</th>
                            <th>Status</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in details.Keys)
                        {
                            <tr data-testid="integration-key-row" data-key-id="@key.Id">
                                <td>@key.Name</td>
                                <td><code>@key.KeyPreview</code></td>
                                <td><code>@key.MachineId</code></td>
                                <td><span class="badge @Admin.NodeDetailsModel.GetStatusBadge(key.IsActive)">@(key.IsActive ? "active" : "inactive")</span></td>
                                <td>@key.CreatedAt</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
