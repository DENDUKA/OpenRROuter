@page
@model Admin.NodesModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Router Nodes - Admin"; }

<div class="adm-section-head">
    <h2>Router Nodes</h2>
    <p>Manage OpenRussiaRouter nodes.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert" data-testid="error-message">@Model.ErrorMessage</div>
}

@if (Model.Action == "add")
{
    <div class="adm-card">
        <div class="adm-card-header">Add F9Router Integration Node</div>
        <div class="adm-card-body">
            <form method="post" asp-page-handler="Add" data-testid="form-add-node">
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.Name" class="form-label">Name</label>
                        <input asp-for="Form.Name" class="form-control" placeholder="Production F9Router" data-testid="input-name" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Form.EndpointUrl" class="form-label">F9Router URL</label>
                        <input asp-for="Form.EndpointUrl" class="form-control" placeholder="https://router.example" data-testid="input-endpoint-url" />
                    </div>
                </div>
                <div class="adm-form-row">
                    <div class="form-group">
                        <label asp-for="Form.ControlToken" class="form-label">Control Token</label>
                        <input asp-for="Form.ControlToken" class="form-control" placeholder="router-control-token" data-testid="input-token-secret-name" />
                    </div>
                </div>
                <input asp-for="Form.CapacityWeight" type="hidden" value="100" />
                <div class="adm-btn-row">
                    <button type="submit" class="btn btn-primary" data-testid="btn-submit-add">Connect Node</button>
                    <a class="btn btn-secondary" href="/admin/nodes">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

<div class="adm-card">
    <div class="adm-card-header adm-card-header--split">
        <span>Router Node List</span>
        <a class="btn btn-sm btn-primary" href="?action=add" data-testid="btn-add-node">Add Node</a>
    </div>
    <div class="adm-card-body">
        @if (Model.Nodes.Count == 0)
        {
            <p class="text-muted" data-testid="empty-list">No router nodes configured.</p>
        }
        else
        {
            <table class="table">
                <thead><tr>
                    <th>Name</th><th>Endpoint</th><th>Status</th><th>In-Flight</th><th>Last Checked</th><th>Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var node in Model.Nodes)
                    {
                        <tr data-testid="node-row" data-node-name="@node.Name" data-node-id="@node.NodeId">
                            <td><a href="/admin/nodes/@node.NodeId" data-testid="link-node-details">@node.Name</a></td>
                            <td><small>@node.EndpointUrl</small></td>
                            <td><span class="badge @Admin.NodesModel.GetStatusBadge(node.Status)" data-testid="node-status">@node.Status</span></td>
                            <td>@node.InFlightRequests</td>
                            <td>@(node.LastCheckedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                            <td class="adm-actions-cell">
                                <a href="/admin/nodes/@node.NodeId/provider-limits"
                                   class="btn-icon"
                                   title="Provider limits"
                                   aria-label="Provider limits"
                                   data-testid="btn-provider-limits">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"/>
                                        <line x1="12" y1="20" x2="12" y2="4"/>
                                        <line x1="6" y1="20" x2="6" y2="14"/>
                                    </svg>
                                </a>
                                <a href="/admin/nodes/@node.NodeId/edit"
                                   class="btn-icon"
                                   title="Edit"
                                   aria-label="Edit"
                                   data-testid="btn-edit-node">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 20h9"/>
                                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                                    </svg>
                                </a>
                                @if (node.Status == "disabled")
                                {
                                    <form method="post" asp-page-handler="Enable" style="display:inline">
                                        <input type="hidden" name="nodeId" value="@node.NodeId" />
                                        <button type="submit" class="btn-icon btn-icon-success" title="Enable" aria-label="Enable"
                                                data-testid="btn-enable"
                                                onclick="return confirm('Enable node @node.Name?')">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        </button>
                                    </form>
                                }
                                @if (node.Status != "disabled")
                                {
                                    <form method="post" asp-page-handler="Disable" style="display:inline">
                                        <input type="hidden" name="nodeId" value="@node.NodeId" />
                                        <button type="submit" class="btn-icon btn-icon-danger" title="Disable" aria-label="Disable"
                                                data-testid="btn-disable"
                                                onclick="return confirm('Disable node @node.Name?')">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                            </svg>
                                        </button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Delete" style="display:inline">
                                    <input type="hidden" name="nodeId" value="@node.NodeId" />
                                    <button type="submit" class="btn-icon btn-icon-danger" title="Delete" aria-label="Delete"
                                            data-testid="btn-delete"
                                            onclick="return confirm('Permanently delete node @node.Name? This cannot be undone.')">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                            <path d="M10 11v6M14 11v6"/>
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                        </svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="adm-card">
    <div class="adm-card-header">Test Request</div>
    <div class="adm-card-body">
        @if (Model.TestResult != null)
        {
            <div class="alert @(Model.TestResult.Success ? "alert-success" : "alert-danger")" role="alert" data-testid="test-result">
                <pre style="white-space:pre-wrap;word-break:break-word;margin:0;font-size:0.85em">@Model.TestResult.Body</pre>
            </div>
        }
        <form method="post" asp-page-handler="Test">
            <div class="adm-form-row">
                <div class="form-group">
                    <label asp-for="TestInput.NodeId" class="form-label">Router Node</label>
                    <select asp-for="TestInput.NodeId" class="form-control" data-testid="select-test-node">
                        @foreach (var node in Model.Nodes)
                        {
                            <option value="@node.NodeId">@node.Name (@node.Status)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="TestInput.Model" class="form-label">Router Model</label>
                    <select asp-for="TestInput.Model" class="form-control" data-testid="input-model">
                        <option value="@Model.TestInput.Model">@Model.TestInput.Model</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="TestInput.Message" class="form-label">Message</label>
                <textarea asp-for="TestInput.Message" class="form-control" rows="3"
                          placeholder="Hello! How are you?" data-testid="input-message"></textarea>
            </div>
            <div class="adm-btn-row">
                <button type="submit" class="btn btn-primary" data-testid="btn-send-test">Send Request</button>
            </div>
        </form>
    </div>
</div>

<div class="adm-card">
    <div class="adm-card-header">Streaming Test Request</div>
    <div class="adm-card-body">
        <form method="post" asp-page-handler="StreamingTest" id="streaming-test-form" data-testid="form-streaming-test">
            <div class="adm-form-row">
                <div class="form-group">
                    <label asp-for="StreamingTestInput.NodeId" class="form-label">Router Node</label>
                    <select asp-for="StreamingTestInput.NodeId" class="form-control" data-testid="select-streaming-test-node">
                        @foreach (var node in Model.Nodes)
                        {
                            <option value="@node.NodeId">@node.Name (@node.Status)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="StreamingTestInput.Model" class="form-label">Router Model</label>
                    <select asp-for="StreamingTestInput.Model" class="form-control" data-testid="input-streaming-model">
                        <option value="@Model.StreamingTestInput.Model">@Model.StreamingTestInput.Model</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="StreamingTestInput.Message" class="form-label">Message</label>
                <textarea asp-for="StreamingTestInput.Message" class="form-control" rows="3"
                          placeholder="Hello! How are you?" data-testid="input-streaming-message"></textarea>
            </div>
            <div class="adm-btn-row">
                <button type="submit" class="btn btn-primary" data-testid="btn-send-streaming-test">Send Streaming Request</button>
                <button type="button" class="btn btn-secondary" id="btn-stop-streaming-test" disabled data-testid="btn-stop-streaming-test">Stop</button>
            </div>
        </form>
        <div class="alert alert-info mt-3" role="alert" id="streaming-test-result" hidden data-testid="streaming-test-result">
            <pre id="streaming-test-output" style="white-space:pre-wrap;word-break:break-word;margin:0;font-size:0.85em;max-height:360px;overflow:auto"></pre>
        </div>
    </div>
</div>

<script>
    (() => {
        const form = document.getElementById('streaming-test-form');
        if (!form) {
            return;
        }

        const output = document.getElementById('streaming-test-output');
        const result = document.getElementById('streaming-test-result');
        const submitButton = form.querySelector('button[type="submit"]');
        const stopButton = document.getElementById('btn-stop-streaming-test');
        let controller = null;

        function setResultState(state) {
            result.classList.remove('alert-info', 'alert-success', 'alert-danger');
            result.classList.add(state);
        }

        function append(text) {
            output.textContent += text;
            output.scrollTop = output.scrollHeight;
        }

        form.addEventListener('submit', async event => {
            event.preventDefault();

            if (controller) {
                controller.abort();
            }

            controller = new AbortController();
            output.textContent = '';
            result.hidden = false;
            setResultState('alert-info');
            submitButton.disabled = true;
            stopButton.disabled = false;

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    signal: controller.signal,
                    headers: { 'X-Requested-With': 'fetch' }
                });

                if (!response.ok) {
                    setResultState('alert-danger');
                }

                if (!response.body) {
                    append(await response.text());
                    return;
                }

                const reader = response.body.getReader();
                const decoder = new TextDecoder();

                while (true) {
                    const { value, done } = await reader.read();
                    if (done) {
                        break;
                    }

                    append(decoder.decode(value, { stream: true }));
                }

                append(decoder.decode());
                if (response.ok) {
                    setResultState('alert-success');
                }
            } catch (error) {
                if (error.name === 'AbortError') {
                    append('\n[stream aborted]');
                } else {
                    setResultState('alert-danger');
                    append(error.message);
                }
            } finally {
                submitButton.disabled = false;
                stopButton.disabled = true;
                controller = null;
            }
        });

        stopButton.addEventListener('click', () => {
            if (controller) {
                controller.abort();
            }
        });
    })();

    (async () => {
        const pairs = [
            { nodeSelectId: 'TestInput_NodeId', modelSelectId: 'TestInput_Model' },
            { nodeSelectId: 'StreamingTestInput_NodeId', modelSelectId: 'StreamingTestInput_Model' }
        ];

        async function fetchModels(nodeId) {
            if (!nodeId) return [];
            try {
                const resp = await fetch(`?handler=NodeModels&nodeId=${encodeURIComponent(nodeId)}`);
                if (!resp.ok) return [];
                return await resp.json();
            } catch {
                return [];
            }
        }

        function populateModelSelect(select, models) {
            const prev = select.value;
            select.innerHTML = '';
            if (models.length === 0) {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = '(no models)';
                select.appendChild(opt);
                return;
            }
            for (const m of models) {
                const opt = document.createElement('option');
                opt.value = m;
                opt.textContent = m;
                select.appendChild(opt);
            }
            select.value = (prev && models.includes(prev)) ? prev : models[0];
        }

        for (const { nodeSelectId, modelSelectId } of pairs) {
            const nodeSelect = document.getElementById(nodeSelectId);
            const modelSelect = document.getElementById(modelSelectId);
            if (!nodeSelect || !modelSelect) continue;

            if (nodeSelect.value) {
                const models = await fetchModels(nodeSelect.value);
                populateModelSelect(modelSelect, models);
            }

            nodeSelect.addEventListener('change', async () => {
                modelSelect.innerHTML = '<option value="">Loading...</option>';
                const models = await fetchModels(nodeSelect.value);
                populateModelSelect(modelSelect, models);
            });
        }
    })();
</script>
