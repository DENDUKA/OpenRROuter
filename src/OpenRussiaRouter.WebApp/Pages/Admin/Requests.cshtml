@page
@model Admin.RequestsModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Requests - Admin"; }

<div class="adm-section-head">
    <h2>Requests</h2>
    <p>All LLM requests routed through the gateway.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="adm-card">
    <div class="adm-card-header">
        <span>Requests</span>
    </div>
    <div class="adm-card-body">
        @* Active filter chips *@
        @if (Model.HasActiveFilters())
        {
            <div class="filter-chips">
                @foreach (var m in Model.ModelFilters)
                {
                    <span class="filter-chip">Model: @m <a href="@Model.BuildRemoveFilterUrl("model", m)" class="filter-chip-remove" title="Remove">&times;</a></span>
                }
                @foreach (var p in Model.ProviderFilters)
                {
                    <span class="filter-chip">Provider: @p <a href="@Model.BuildRemoveFilterUrl("provider", p)" class="filter-chip-remove" title="Remove">&times;</a></span>
                }
                @foreach (var k in Model.ApiKeyFilters)
                {
                    <span class="filter-chip">API Key: @k <a href="@Model.BuildRemoveFilterUrl("apiKey", k)" class="filter-chip-remove" title="Remove">&times;</a></span>
                }
                @foreach (var n in Model.NodeFilters)
                {
                    <span class="filter-chip">Node: @Model.GetNodeName(n) <a href="@Model.BuildRemoveFilterUrl("node", n)" class="filter-chip-remove" title="Remove">&times;</a></span>
                }
                @foreach (var a in Model.AccountFilters)
                {
                    <span class="filter-chip">Account: @a <a href="@Model.BuildRemoveFilterUrl("account", a)" class="filter-chip-remove" title="Remove">&times;</a></span>
                }
            </div>
        }

        @* Filter controls *@
        <form method="get" class="d-flex gap-2 align-items-start flex-wrap mb-3" id="filterForm" style="font-weight:normal">
            @{
                var dropdowns = new[]
                {
                    new { Type = "model",    Label = "Model",    Options = Model.ModelOptions },
                    new { Type = "provider", Label = "Provider", Options = Model.ProviderOptions },
                    new { Type = "apiKey",   Label = "API Key",  Options = Model.ApiKeyOptions },
                    new { Type = "node",     Label = "Node",     Options = Model.NodeOptions },
                    new { Type = "account",  Label = "Account",  Options = Model.AccountOptions }
                };
            }
            @foreach (var d in dropdowns)
            {
                var activeCount = d.Options.Count(o => o.Active);
                <div class="filter-multiselect" data-ms-type="@d.Type">
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-toggle" aria-expanded="false">
                        @d.Label
                        @if (activeCount > 0)
                        {
                            <span class="ms-count">@activeCount</span>
                        }
                        <span class="ms-caret">&nbsp;&#9662;</span>
                    </button>
                    <div class="ms-panel" role="menu" aria-label="@d.Label filter">
                        <input type="text" class="form-control form-control-sm ms-search" placeholder="Search @d.Label.ToLowerInvariant()..." autocomplete="off" />
                        <div class="ms-options">
                            @if (d.Options.Count == 0)
                            {
                                <div class="ms-empty">No values available</div>
                            }
                            else
                            {
                                foreach (var opt in d.Options)
                                {
                                    <label class="ms-option" data-value="@opt.Value">
                                        <input type="checkbox" name="@d.Type" value="@opt.Value" checked="@opt.Active" />
                                        <span class="ms-option-label" title="@opt.Value">@opt.Display</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
            <input type="datetime-local" name="from" value="@Model.FromUtc" class="form-control form-control-sm" style="width:190px;max-width:100%" title="From (UTC)" aria-label="From (UTC)" />
            <input type="datetime-local" name="to" value="@Model.ToUtc" class="form-control form-control-sm" style="width:190px;max-width:100%" title="To (UTC)" aria-label="To (UTC)" />
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
            <button type="button" class="btn btn-sm btn-info" id="calculateBtn">Calculate</button>
            @if (Model.HasActiveFilters())
            {
                <a href="/admin/requests" class="btn btn-sm btn-secondary">Clear</a>
            }
        </form>

        @* Calculate results *@
        <div id="calculateResults" class="filter-summary" style="display:none">
            <span class="filter-summary-item"><strong>Requests:</strong> <span id="sumRequests">0</span></span>
            <span class="filter-summary-item"><strong>Input tokens:</strong> <span id="sumInput">0</span></span>
            <span class="filter-summary-item"><strong>Output tokens:</strong> <span id="sumOutput">0</span></span>
            <span class="filter-summary-item"><strong>Cache tokens:</strong> <span id="sumCache">0</span></span>
            <span class="filter-summary-item"><strong>Cost:</strong> <span id="sumCost">0</span> $</span>
        </div>

        @if (Model.Records.Count == 0)
        {
            <p class="text-muted">No requests found.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>API Key</th>
                            <th>Model</th>
                            <th>Node</th>
                            <th>Provider</th>
                            <th>Account</th>
                            <th>Tokens in/out/cache</th>
                            <th>Cost</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Records)
                        {
                            var (badgeClass, badgeLabel) = Model.GetStatusBadge(r.Status);
                            <tr>
                                <td style="white-space:nowrap">
                                    <small title="@r.CreatedAt.ToString("O")">@r.CreatedAt.ToLocalTime().ToString("g")</small>
                                </td>
                                <td>
                                    <a href="#" class="filter-clickable" data-filter-type="apiKey" data-filter-value="@r.ApiKeyPrefix" title="Click to filter by this API key">
                                        <small>@r.ApiKeyPrefix…</small>
                                    </a>
                                </td>
                                <td>
                                    <a href="#" class="filter-clickable" data-filter-type="model" data-filter-value="@r.ModelId" title="Click to filter by this model">
                                        <small>@r.ModelId</small>
                                    </a>
                                </td>
                                <td>
                                    <a href="#" class="filter-clickable" data-filter-type="node" data-filter-value="@r.RouterNodeId" title="Click to filter by this node">
                                        <small title="@r.RouterNodeId">@Model.GetNodeName(r.RouterNodeId)</small>
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(r.ProviderName))
                                    {
                                        <a href="#" class="filter-clickable" data-filter-type="provider" data-filter-value="@r.ProviderName" title="Click to filter by this provider">
                                            <small>@r.ProviderName</small>
                                        </a>
                                    }
                                    else
                                    {
                                        <small>—</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(r.ProviderAccount))
                                    {
                                        <a href="#" class="filter-clickable" data-filter-type="account" data-filter-value="@r.ProviderAccount" title="Click to filter by this account">
                                            <small>@r.ProviderAccount</small>
                                        </a>
                                    }
                                    else
                                    {
                                        <small>—</small>
                                    }
                                </td>
                                <td>
                                    <small>@r.InputTokens / @r.OutputTokens / @r.CacheTokens</small>
                                </td>
                                <td style="white-space:nowrap">
                                    <small>@r.CostUsd.ToString("F4") $</small>
                                </td>
                                <td><span class="badge @badgeClass">@badgeLabel</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.HasMore && Model.NextCursor != null)
            {
                <div class="mt-3 mb-2 d-flex gap-2">
                    @if (Model.Cursor != null)
                    {
                        <button type="button" class="btn btn-sm btn-secondary" onclick="history.back()">&larr; Previous page</button>
                    }
                    <a href="@Model.BuildFilterUrl(Model.NextCursor)" class="btn btn-sm btn-primary">Next page &rarr;</a>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('filterForm');

    // ── Multi-select dropdowns: toggle / close / search ───────────────────────
    function closeAllPanels(except) {
        document.querySelectorAll('.filter-multiselect').forEach(function(container) {
            var panel = container.querySelector('.ms-panel');
            var toggle = container.querySelector('.ms-toggle');
            if (panel && panel !== except) {
                panel.classList.remove('open');
                if (toggle) toggle.setAttribute('aria-expanded', 'false');
            }
        });
    }

    document.addEventListener('click', function(e) {
        var toggle = e.target.closest && e.target.closest('.ms-toggle');
        if (toggle) {
            e.preventDefault();
            var panel = toggle.parentElement.querySelector('.ms-panel');
            var willOpen = !panel.classList.contains('open');
            closeAllPanels(willOpen ? panel : null);
            panel.classList.toggle('open', willOpen);
            toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
            if (willOpen) {
                var search = panel.querySelector('.ms-search');
                if (search) { search.value = ''; search.focus(); }
                panel.querySelectorAll('.ms-option').forEach(function(o) { o.style.display = ''; });
            }
            return;
        }
        if (!e.target.closest || !e.target.closest('.filter-multiselect')) {
            closeAllPanels(null);
        }
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            var openPanels = document.querySelectorAll('.filter-multiselect .ms-panel.open');
            if (openPanels.length > 0) {
                e.preventDefault();
                openPanels.forEach(function(panel) {
                    panel.classList.remove('open');
                    var container = panel.closest('.filter-multiselect');
                    if (container) {
                        var toggle = container.querySelector('.ms-toggle');
                        if (toggle) {
                            toggle.setAttribute('aria-expanded', 'false');
                            toggle.focus();
                        }
                    }
                });
            }
        }
    });

    document.querySelectorAll('.ms-search').forEach(function(search) {
        search.addEventListener('input', function() {
            var q = this.value.toLowerCase();
            this.closest('.ms-panel').querySelectorAll('.ms-option').forEach(function(opt) {
                var text = opt.querySelector('.ms-option-label').textContent.toLowerCase();
                opt.style.display = text.indexOf(q) !== -1 ? '' : 'none';
            });
        });
    });

    // Keep dropdown open after checking a box (user may select multiple).
    document.querySelectorAll('.ms-option input[type="checkbox"]').forEach(function(cb) {
        cb.addEventListener('click', function(e) { e.stopPropagation(); });
    });

    // ── Clickable table cells → check the matching checkbox and submit ───────
    document.addEventListener('click', function(e) {
        var link = e.target.closest && e.target.closest('.filter-clickable');
        if (!link) return;
        e.preventDefault();

        var type = link.dataset.filterType;
        var value = link.dataset.filterValue;
        if (!type || !value || !form) return;

        var cbs = form.querySelectorAll('input[type="checkbox"][name="' + type + '"]');
        var found = false;
        for (var i = 0; i < cbs.length; i++) {
            if (cbs[i].value === value) {
                if (!cbs[i].checked) cbs[i].checked = true;
                found = true;
                break;
            }
        }
        // Value not in current dropdown options (e.g. on a page without that row)
        // → create a hidden input so it still submits.
        if (!found) {
            var existing = form.querySelectorAll('input[type="hidden"][name="' + type + '"]');
            for (var j = 0; j < existing.length; j++) {
                if (existing[j].value === value) { found = true; break; }
            }
            if (!found) {
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = type;
                inp.value = value;
                form.appendChild(inp);
            }
        }
        form.submit();
    });

    // ── Calculate button → POST current checkbox selection as query ──────────
    document.getElementById('calculateBtn').addEventListener('click', function() {
        if (!form) return;
        var params = new URLSearchParams();

        form.querySelectorAll('input[type="checkbox"]:checked').forEach(function(cb) {
            if (cb.name) params.append(cb.name, cb.value);
        });
        // Hidden inputs may carry values not present in dropdowns.
        form.querySelectorAll('input[type="hidden"]').forEach(function(inp) {
            if (inp.name && inp.value) params.append(inp.name, inp.value);
        });

        var fromInput = form.querySelector('input[name="from"]');
        var toInput = form.querySelector('input[name="to"]');
        if (fromInput && fromInput.value) params.append('from', fromInput.value);
        if (toInput && toInput.value) params.append('to', toInput.value);

        fetch('/admin/requests?handler=Calculate&' + params.toString())
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.error) { alert(data.error); return; }
                document.getElementById('sumRequests').textContent = data.totalRequests.toLocaleString();
                document.getElementById('sumInput').textContent = data.inputTokens.toLocaleString();
                document.getElementById('sumOutput').textContent = data.outputTokens.toLocaleString();
                document.getElementById('sumCache').textContent = data.cacheTokens.toLocaleString();
                document.getElementById('sumCost').textContent = data.costUsd.toFixed(4);
                document.getElementById('calculateResults').style.display = 'flex';
            })
            .catch(function(err) { alert('Failed to calculate: ' + err); });
    });
});
</script>
}
