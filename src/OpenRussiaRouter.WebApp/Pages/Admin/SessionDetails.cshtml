@page "/admin/sessions/{id:long}"
@model Admin.SessionDetailsModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Session - Admin"; }

<div class="adm-section-head">
    <h2>Visit Session</h2>
    <p>One collapsed session and the pages it visited, in order.</p>
</div>

<div class="adm-btn-row">
    <a class="btn btn-secondary" href="/admin/sessions">Back to sessions</a>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert" data-testid="error-message">@Model.ErrorMessage</div>
}

@if (!Model.AnalyticsEnabled)
{
    <div class="alert alert-warning" role="alert">
        Analytics sink is not configured on this environment. Site visits are not being recorded.
    </div>
}
else if (Model.Details is { } details)
{
    var s = details.Session;
    var visitorHash = Uri.EscapeDataString(s.VisitorHash);

    <div class="adm-card" data-testid="session-header-card">
        <div class="adm-card-header adm-card-header--split">
            <span>@s.StartedAtUtc.ToLocalTime().ToString("g")</span>
            <span class="badge @(s.DeviceClass == "bot" ? "badge-warning" : "badge-secondary")">@s.DeviceClass</span>
        </div>
        <div class="adm-card-body">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Visitor hash</th>
                        <td>
                            <code>@s.VisitorHash</code>
                            <div style="margin-top:.35rem">
                                <a href="/admin/sessions?visitorHash=@visitorHash">All sessions of this visitor</a>
                                <span class="text-muted"> &middot; </span>
                                <a href="/admin/visitors?visitorHash=@visitorHash" title="Raw, not-yet-compacted page views">Raw visit tail</a>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th>Started (UTC)</th>
                        <td><code>@s.StartedAtUtc.ToString("O")</code></td>
                    </tr>
                    <tr>
                        <th>Ended (UTC)</th>
                        <td><code>@s.EndedAtUtc.ToString("O")</code></td>
                    </tr>
                    <tr>
                        <th>Duration</th>
                        <td>@Admin.SessionsModel.FormatDuration(s.DurationSeconds)</td>
                    </tr>
                    <tr>
                        <th>Page views</th>
                        <td><span class="badge badge-secondary">@s.PageViewCount</span></td>
                    </tr>
                    <tr>
                        <th>Entry &rarr; Exit</th>
                        <td><code>@s.EntryPath</code> &rarr; <code>@s.ExitPath</code></td>
                    </tr>
                    <tr>
                        <th>Source</th>
                        <td>
                            @if (!string.IsNullOrEmpty(s.ReferrerHost))
                            {
                                <text>@s.ReferrerHost</text>
                                <span class="badge badge-secondary">@s.ReferrerKind</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">@s.ReferrerKind</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>UTM</th>
                        <td>
                            @if (string.IsNullOrEmpty(s.UtmSource) && string.IsNullOrEmpty(s.UtmMedium) && string.IsNullOrEmpty(s.UtmCampaign))
                            {
                                <span class="text-muted">none</span>
                            }
                            else
                            {
                                <text>
                                    source: <code>@(s.UtmSource ?? "-")</code>,
                                    medium: <code>@(s.UtmMedium ?? "-")</code>,
                                    campaign: <code>@(s.UtmCampaign ?? "-")</code>
                                </text>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Auth</th>
                        <td>
                            @if (s.IsAuthenticated)
                            {
                                <span class="badge badge-success">signed-in</span>
                                @if (Model.UserName != null)
                                {
                                    <text> @Model.UserName</text>
                                }
                                @if (s.DistinctId != null)
                                {
                                    <br />
                                    <small class="text-muted">distinct_id: <code>@s.DistinctId</code></small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">anon</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Environment</th>
                        <td><code>@s.Environment</code></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="adm-card" data-testid="session-pages-card">
        <div class="adm-card-header">
            <span>Pages</span>
            <span class="text-muted" style="font-weight:normal;margin-left:8px">@details.Pages.Count shown</span>
        </div>
        <div class="adm-card-body">
            @if (Model.TruncationNote != null)
            {
                <div class="alert alert-warning" role="status" data-testid="pages-truncated">@Model.TruncationNote</div>
            }

            @if (details.Pages.Count == 0)
            {
                <p class="text-muted">No page list stored for this session.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Offset</th>
                            <th>Path</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in details.Pages)
                        {
                            <tr>
                                <td style="white-space:nowrap">
                                    <small title="@p.OccurredAt.ToString("O")">@p.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</small>
                                </td>
                                <td style="white-space:nowrap">
                                    <small class="text-muted">@Admin.SessionDetailsModel.FormatOffset(s.StartedAtUtc, p.OccurredAt)</small>
                                </td>
                                <td><code>@p.Path</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
