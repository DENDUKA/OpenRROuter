@page
@model Admin.TopUpsModel
@{ Layout = "~/Pages/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Top-ups - Admin"; }

<div class="adm-section-head">
    <h2>Top-up History</h2>
    <p>All balance top-ups across users.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="adm-card">
    <div class="adm-card-header">
        <span>All Top-ups</span>
    </div>
    <div class="adm-card-body">
        @if (Model.Records.Count == 0)
        {
            <p class="text-muted">No top-ups found.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>User</th>
                        <th>Amount</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Records)
                    {
                        <tr>
                            <td style="white-space:nowrap"><small title="@r.CreatedAtUtc.ToString("O")">@r.CreatedAtUtc.ToLocalTime().ToString("g")</small></td>
                            <td>@Model.GetUserDisplayName(r.UserId)</td>
                            <td style="white-space:nowrap">@r.Amount.ToString("N2") $</td>
                            <td>@r.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.HasMore && Model.NextCursor != null)
            {
                <div class="mt-3 mb-2 d-flex gap-2">
                    @if (Model.Cursor != null)
                    {
                        <button type="button" class="btn btn-sm btn-secondary" onclick="history.back()">&larr; Previous page</button>
                    }
                    <a href="/admin/topups?cursor=@Uri.EscapeDataString(Model.NextCursor)" class="btn btn-sm btn-primary">Next page &rarr;</a>
                </div>
            }
        }
    </div>
</div>
