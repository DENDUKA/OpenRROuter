@page "/docs"
@model DocsModel
@{ ViewData["Title"] = Localizer["Docs_Title"]; }

<div class="docs-page">
    <section class="docs-hero" aria-labelledby="docs-title">
        <div class="section-label">@Localizer["Docs_CatalogEyebrow"]</div>
        <h1 id="docs-title">@Localizer["Docs_CatalogTitle"]</h1>
        <p>@Localizer["Docs_CatalogLead"]</p>
    </section>

    <section class="docs-section" aria-labelledby="docs-catalog">
        <h2 id="docs-catalog" class="visually-hidden">@Localizer["Docs_CatalogTitle"]</h2>
        <div class="docs-grid">
            @foreach (var tool in Model.Tools)
            {
                <partial name="_DocsCard" model="tool" />
            }
        </div>
    </section>

    <section class="docs-section" aria-labelledby="endpoint-title">
        <h2 id="endpoint-title">@Localizer["Docs_Endpoint"]</h2>
        <p>@Localizer["Docs_EndpointLead"]</p>
        <div class="docs-field" aria-label="@Localizer["Docs_BaseUrlAria"]">
            <span class="docs-field-label">@Localizer["Docs_BaseUrlLabel"]</span>
            <code class="docs-field-value" id="docs-base-url">@Model.V1BaseUrl</code>
            <button type="button" class="docs-copy-btn" data-copy="@Model.V1BaseUrl" data-copied="@Localizer["Btn_Copied"]" onclick="copyDocsValue(event)">@Localizer["Btn_Copy"]</button>
        </div>
        <div class="docs-field" aria-label="@Localizer["Docs_AuthHeaderAria"]">
            <span class="docs-field-label">@Localizer["Docs_AuthHeader"]</span>
            <code class="docs-field-value">Authorization: Bearer &lt;YOUR_API_KEY&gt;</code>
        </div>
        <table class="table docs-endpoint-table">
            <thead><tr><th scope="col">@Localizer["Docs_Th_Method"]</th><th scope="col">@Localizer["Docs_Th_Path"]</th><th scope="col">@Localizer["Docs_Th_Purpose"]</th></tr></thead>
            <tbody>
                <tr><td><code>POST</code></td><td><code>/v1/chat/completions</code></td><td>@Localizer["Docs_ChatCompletions"]</td></tr>
                <tr><td><code>GET</code></td><td><code>/v1/models</code></td><td>@Localizer["Docs_ListModels"]</td></tr>
            </tbody>
        </table>
    </section>

    <section class="docs-section" aria-labelledby="steps-title">
        <h2 id="steps-title">@Localizer["Docs_Steps"]</h2>
        <div class="docs-step-list">
            <div class="docs-step">
                <span>01</span>
                <div>
                    <h3>@Localizer["Docs_StepSignupTitle"]</h3>
                    <p>@Localizer["Docs_StepSignupDesc"]</p>
                </div>
            </div>
            <div class="docs-step">
                <span>02</span>
                <div>
                    <h3>@Localizer["Docs_StepBuyTitle"]</h3>
                    <p>@Localizer["Docs_StepBuyDesc"]</p>
                </div>
            </div>
            <div class="docs-step">
                <span>03</span>
                <div>
                    <h3>@Localizer["Docs_StepModelTitle"]</h3>
                    <p>@Localizer["Docs_StepModelDesc"]</p>
                </div>
            </div>
            <div class="docs-step">
                <span>04</span>
                <div>
                    <h3>@Localizer["Docs_StepKeyTitle"]</h3>
                    <p>@Localizer["Docs_StepKeyDesc"]</p>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .docs-page { max-width: 920px; }
    .docs-hero {
        padding: 40px 0 32px;
        border-bottom: 1px solid var(--color-hairline);
    }
    .docs-hero p {
        max-width: 620px;
        font-size: 16px;
        line-height: 26px;
    }
    .docs-section {
        padding: 40px 0;
        border-bottom: 1px solid var(--color-hairline);
    }
    .docs-section:last-child { border-bottom: none; }
    .docs-step-list {
        display: grid;
        gap: 0;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        background: var(--color-canvas-soft);
        overflow: hidden;
    }
    .docs-step {
        display: grid;
        grid-template-columns: 52px minmax(0, 1fr);
        gap: var(--spacing-md);
        padding: 18px;
        border-top: 1px solid var(--color-hairline);
    }
    .docs-step:first-child { border-top: none; }
    .docs-step span {
        color: var(--color-body);
        font-family: var(--font-mono);
        font-size: 12px;
    }
    .docs-step h3 { margin: 0 0 4px; font-size: 15px; }
    .docs-step p { margin: 0; }
    .docs-field {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        margin-top: var(--spacing-md);
        padding: 12px 14px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-md);
        background: var(--color-canvas-soft);
    }
    .docs-field-label {
        flex: 0 0 92px;
        color: var(--color-mute);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .docs-field-value {
        flex: 1 1 auto;
        padding: 0;
        background: transparent;
        color: var(--color-ink);
        font-family: var(--font-mono);
        font-size: 13px;
        overflow-wrap: anywhere;
    }
    .docs-copy-btn {
        flex: 0 0 auto;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-sm);
        background: transparent;
        color: var(--color-body);
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        padding: 4px 10px;
    }
    .docs-copy-btn:hover { color: var(--color-ink); border-color: var(--color-border); }
    .docs-endpoint-table { margin-top: var(--spacing-lg); }
    .docs-endpoint-table td, .docs-endpoint-table th { white-space: nowrap; }
    .docs-endpoint-table td:last-child, .docs-endpoint-table th:last-child { white-space: normal; }

    .docs-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
    .docs-card {
        display: grid;
        grid-template-columns: 40px minmax(0, 1fr);
        gap: 14px;
        padding: 18px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        background: var(--color-canvas-soft);
        text-decoration: none;
        color: inherit;
        transition: border-color .15s, transform .15s;
    }
    .docs-card:hover { border-color: var(--color-border); transform: translateY(-1px); }
    .docs-card-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: grid;
        place-items: center;
        color: #fff;
        font-weight: 600;
        font-size: 16px;
    }
    .docs-card-head {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 8px;
        margin-bottom: 6px;
    }
    .docs-card h3 { margin: 0; font-size: 15px; }
    .docs-card-cat {
        font-size: 11px;
        color: var(--color-mute);
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: nowrap;
    }
    .docs-card p {
        margin: 0 0 10px;
        color: var(--color-body);
        font-size: 13px;
        line-height: 1.5;
    }
    .docs-card ul {
        margin: 0;
        padding-left: 18px;
        font-size: 12.5px;
        color: var(--color-mute);
    }
    .docs-card ul li { margin: 2px 0; }

    .docs-code-panel {
        margin-top: var(--spacing-md);
        position: relative;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        background: var(--color-canvas-soft);
        overflow: hidden;
    }
    .docs-code-panel pre {
        margin: 0;
        padding: 18px;
        overflow-x: auto;
        color: var(--color-body);
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.6;
    }
    .docs-code-panel code {
        display: block;
        padding: 0;
        background: transparent;
        color: inherit;
        font-size: inherit;
    }
    .integ-copy {
        position: absolute;
        top: 10px;
        right: 10px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-sm);
        background: var(--color-canvas-card);
        color: var(--color-body);
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        padding: 3px 10px;
    }
    .integ-copy:hover { color: var(--color-ink); border-color: var(--color-border); }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        border: 0;
    }

    @@media (max-width: 640px) {
        .docs-hero { padding-top: 28px; }
        .docs-section { padding: 32px 0; }
        .docs-field { flex-wrap: wrap; }
    }
</style>

@section Scripts {
    <script>
        // Copy a docs value (base URL etc). orrCopyText is defined globally in _Layout.cshtml.
        function copyDocsValue(event) {
            var btn = event.currentTarget;
            var text = btn.getAttribute('data-copy');
            if (!text) return;
            var originalText = btn.getAttribute('data-original') || btn.textContent;
            btn.setAttribute('data-original', originalText);
            orrCopyText(text).then(function () {
                btn.textContent = btn.getAttribute('data-copied') || 'Copied';
                setTimeout(function () { btn.textContent = originalText; }, 1500);
            }).catch(function (err) { console.error('Copy failed:', err); });
        }

        // Copy the code in the same panel as the clicked button. orrCopyText is global (_Layout.cshtml).
        function copyCodeBlock(event) {
            var btn = event.currentTarget;
            var pre = btn.closest('.integ-panel, .docs-code-panel')?.querySelector('pre');
            if (!pre) return;
            var original = btn.getAttribute('data-original') || btn.textContent;
            btn.setAttribute('data-original', original);
            orrCopyText(pre.textContent).then(function () {
                btn.textContent = btn.getAttribute('data-copied') || 'Copied';
                setTimeout(function () { btn.textContent = original; }, 1500);
            }).catch(function (err) { console.error('Copy failed:', err); });
        }
    </script>
}
