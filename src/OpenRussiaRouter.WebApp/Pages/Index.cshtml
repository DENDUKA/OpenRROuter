<script>
    function switchApiTab(tab) {
        var isOpenAi = tab === 'openai';
        var tabOpenAi = document.getElementById('tab-openai');
        var tabAnthropic = document.getElementById('tab-anthropic');
        var panelOpenAi = document.getElementById('panel-openai');
        var panelAnthropic = document.getElementById('panel-anthropic');

        if (tabOpenAi && tabAnthropic && panelOpenAi && panelAnthropic) {
            tabOpenAi.classList.toggle('is-active', isOpenAi);
            tabOpenAi.setAttribute('aria-selected', isOpenAi ? 'true' : 'false');
            tabAnthropic.classList.toggle('is-active', !isOpenAi);
            tabAnthropic.setAttribute('aria-selected', !isOpenAi ? 'true' : 'false');

            panelOpenAi.classList.toggle('is-hidden', !isOpenAi);
            panelAnthropic.classList.toggle('is-hidden', isOpenAi);
        }
    }
</script>

<script src="~/js/flagship-carousel.js" asp-append-version="true" defer></script>
