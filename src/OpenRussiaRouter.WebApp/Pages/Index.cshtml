@page
@model IndexModel
@{
    Layout = "~/Pages/Shared/_CatalogLayout.cshtml";
    // Was null, which collapsed the most valuable <title> on the site to the bare brand name.
    // Mirrors the H1 (Home_Title) so title/H1/intent stay aligned.
    ViewData["Title"] = Localizer["Title"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
}

<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            <div class="provider-strip" aria-hidden="true">
                @foreach (var p in Model.Providers)
                {
                    <span class="provider-icon provider-icon-dynamic">
                        <img src="/providers/logo/@Uri.EscapeDataString(p.Id)" alt="@p.DisplayName" width="24" height="24" loading="lazy" decoding="async" />
                    </span>
                }

            </div>
            <h1 id="home-title" class="home-title">@Localizer["Home_Title"]</h1>
            <p class="home-lead">
                @Localizer["Home_Lead"]
            </p>
            @if (Model.StartBalanceEnabled || Model.FirstTopUpEnabled)
            {
                <div class="promo-badges">
                    @if (Model.StartBalanceEnabled)
                    {
                        <span class="promo-badge">Стартовый баланс $@Model.StartBalanceAmountUsd</span>
                    }
                    @if (Model.FirstTopUpEnabled)
                    {
                        <span class="promo-badge">+@Model.FirstTopUpPercent% к первому пополнению</span>
                    }
                </div>
            }
            <div class="cta-row" aria-label="@Localizer["A11y_PrimaryActions"]">
                <a href="/signup" class="btn btn-primary" data-goal="cta_signup_hero">@Localizer["Home_CtaSignup"]</a>
                <a href="/models" class="btn btn-secondary" data-goal="cta_models_hero">@Localizer["Home_CtaExplore"]</a>
            </div>
        </div>

        <div class="quickstart-panel" aria-labelledby="quickstart-title">
            <div class="section-label">@Localizer["Home_QuickstartLabel"]</div>
            <h2 id="quickstart-title">@Localizer["Home_QuickstartTitle"]</h2>
            <ol class="quickstart-list">
                <li>
                    <a class="quickstart-link" href="/signup" data-goal="cta_signup_quickstart">
                        @if (Model.CurrentUser != null)
                        {
                            <span class="step-number step-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                        }
                        else
                        {
                            <span class="step-number">01</span>
                        }
                        <div>
                            <h3>@Localizer["Home_StepSignup_Title"]</h3>
                            <p>@Localizer["Home_StepSignup_Desc"]</p>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="quickstart-link" href="/workspace/credits">
                        @if (Model.HasBalance)
                        {
                            <span class="step-number step-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                        }
                        else
                        {
                            <span class="step-number">02</span>
                        }
                        <div>
                            <h3>@Localizer["Home_StepBuy_Title"]</h3>
                            @if (!Model.HasPaidTopUp && Model.FirstTopUpBonusAvailable)
                            {
                                <p>@Localizer["Home_StepBuy_Desc_PromoBonus", Model.FirstTopUpPercent]</p>
                            }
                            else
                            {
                                <p>@Localizer["Home_StepBuy_Desc"]</p>
                            }
                        </div>
                    </a>
                </li>
                <li>
                    <a class="quickstart-link" href="/workspace/apikeys">
                        @if (Model.HasApiKey)
                        {
                            <span class="step-number step-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                        }
                        else
                        {
                            <span class="step-number">03</span>
                        }
                        <div>
                            <h3>@Localizer["Home_StepKey_Title"]</h3>
                            <p>@Localizer["Home_StepKey_Desc"]</p>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="quickstart-link" href="/models">
                        @if (Model.CurrentUser != null && Model.HasBalance && Model.HasApiKey)
                        {
                            <span class="step-number step-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                        }
                        else
                        {
                            <span class="step-number">04</span>
                        }
                        <div>
                            <h3>@Localizer["Home_StepModel_Title"]</h3>
                            <p>@Localizer["Home_StepModel_Desc"]</p>
                        </div>
                    </a>
                </li>
            </ol>
        </div>
    </section>

    @if (Model.FlagshipModels.Count > 0)
    {
        <section class="home-section flagship-showcase" aria-labelledby="flagship-title">
            <div class="flagship-heading">
                <div>
                    <div class="section-label flagship-section-label">@Localizer["Home_CatalogLabel"]</div>
                    <h2 id="flagship-title">@Localizer["Home_CatalogTitle"]</h2>
                    <p>@Localizer["Home_CatalogLead"]</p>
                </div>
                <a href="/models" class="btn btn-secondary" data-goal="cta_models_catalog">@Localizer["Home_CtaExplore"]</a>
            </div>

            <div class="flagship-grid">
                @foreach (var flagship in Model.FlagshipModels)
                {
                    <a class="flagship-card" href="@flagship.Path"
                       aria-label="@Localizer["Home_FlagshipCardAria", flagship.DisplayName]">
                        <div class="flagship-card-topline" aria-hidden="true"></div>
                        <div class="flagship-card-header">
                            @if (!string.IsNullOrWhiteSpace(flagship.ProviderId))
                            {
                                <img class="flagship-provider-logo"
                                     src="/providers/logo/@Uri.EscapeDataString(flagship.ProviderId)"
                                     alt="" aria-hidden="true" width="38" height="38" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="flagship-provider-logo flagship-provider-fallback" aria-hidden="true">
                                    @IndexModel.GetInitials(flagship.Provider)
                                </span>
                            }
                            <div class="flagship-provider-copy">
                                <span class="flagship-provider">@flagship.Provider</span>
                                <span class="flagship-mark">@Localizer["Home_FlagshipBadge"]</span>
                            </div>
                        </div>

                        <div class="flagship-model-copy">
                            <h3>@flagship.DisplayName</h3>
                            <code>@flagship.Id</code>
                        </div>

                        <div class="flagship-price-comparison">
                            <div class="flagship-price-legend" aria-hidden="true">
                                <span></span>
                                <span>@Localizer["Home_PriceOpenRouter"]</span>
                                <span>@Localizer["Home_PriceOurs"]</span>
                            </div>
                            <div class="flagship-price-row">
                                <span class="flagship-price-kind">@Localizer["Home_PriceInput"]</span>
                                <del>@IndexModel.FormatUsdPrice(flagship.OpenRouterInputPrice)</del>
                                <strong>@IndexModel.FormatUsdPrice(flagship.InputPrice)</strong>
                            </div>
                            <div class="flagship-price-row">
                                <span class="flagship-price-kind">@Localizer["Home_PriceOutput"]</span>
                                <del>@IndexModel.FormatUsdPrice(flagship.OpenRouterOutputPrice)</del>
                                <strong>@IndexModel.FormatUsdPrice(flagship.OutputPrice)</strong>
                            </div>
                            <div class="flagship-price-row">
                                <span class="flagship-price-kind">@Localizer["Home_PriceCache"]</span>
                                <del>@IndexModel.FormatUsdPrice(flagship.OpenRouterCachePrice)</del>
                                <strong>@IndexModel.FormatUsdPrice(flagship.CachePrice)</strong>
                            </div>
                        </div>

                        <div class="flagship-card-footer">
                            <span>@Localizer["Home_PriceUnit"]</span>
                            <span class="flagship-arrow" aria-hidden="true">↗</span>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <section class="home-section proof-grid" aria-label="@Localizer["A11y_PlatformCapabilities"]">
        <div class="proof-item">
            <div class="proof-icon proof-icon-savings" aria-hidden="true"></div>
            <h2>@Localizer["Home_ProofSavings_Title"]</h2>
            <p>
                @Localizer["Home_ProofSavings_Desc"]
            </p>
        </div>
        <div class="proof-item">
            <div class="proof-icon proof-icon-billing" aria-hidden="true"></div>
            <h2>@Localizer["Home_ProofBilling_Title"]</h2>
            <p>
                @Localizer["Home_ProofBilling_Desc"]
            </p>
        </div>
        <div class="proof-item">
            <div class="proof-icon proof-icon-routing" aria-hidden="true"></div>
            <h2>@Localizer["Home_ProofRouting_Title"]</h2>
            <p>
                @Localizer["Home_ProofRouting_Desc"]
            </p>
        </div>
        <div class="proof-item">
            <div class="proof-icon proof-icon-apikeys" aria-hidden="true"></div>
            <h2>@Localizer["Home_ProofApiKeys_Title"]</h2>
            <p>
                @Localizer["Home_ProofApiKeys_Desc"]
            </p>
        </div>
    </section>

    <section class="home-section home-section--split request-section" aria-labelledby="request-title">
        <div>
            <div class="section-label">@Localizer["Home_ApiLabel"]</div>
            <h2 id="request-title">@Localizer["Home_ApiTitle"]</h2>
            <p>
                @Localizer["Home_ApiLead"]
            </p>
            <a href="/docs" class="text-link">@Localizer["Home_ApiGuide"]</a>
        </div>
        <div class="code-panel" aria-label="@Localizer["A11y_ExampleCurlRequest"]">
<pre><code>curl /v1/chat/completions \
  -H "Authorization: Bearer $ORR_API_KEY" \
  -H "Content-Type: application/json" \
  -d '{
    "model": "ORR/...",
    "messages": [
      { "role": "user", "content": "Hello" }
    ]
  }'</code></pre>
        </div>
    </section>

    <section class="home-section final-cta" aria-labelledby="final-cta-title">
        <div>
            <div class="section-label">@Localizer["Home_FinalLabel"]</div>
            <h2 id="final-cta-title">@Localizer["Home_FinalTitle"]</h2>
            <p>@Localizer["Home_FinalLead"]</p>
        </div>
        <div class="cta-row">
            <a href="/signup" class="btn btn-primary" data-goal="cta_signup_final">@Localizer["Home_FinalCtaSignup"]</a>
            <a href="/models" class="btn btn-secondary" data-goal="cta_models_final">@Localizer["Home_FinalCtaModels"]</a>
        </div>
    </section>
</div>

<style>
    .home-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
        gap: 40px;
        align-items: start;
        padding: 56px 0 64px;
        border-bottom: 1px solid var(--color-hairline);
    }
    .provider-strip { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
    .provider-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border: 1px solid var(--provider-border);
        border-radius: 10px;
        background: var(--provider-bg);
        color: var(--provider-color);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04);
    }
    .provider-icon img {
        width: 25px;
        height: 25px;
        display: block;
        object-fit: contain;
    }
    .provider-icon-dynamic {
        --provider-color: var(--color-body);
        --provider-bg: var(--color-canvas-soft);
        --provider-border: var(--color-hairline);
    }

    .home-title {
        max-width: 820px;
        margin: 0 0 var(--spacing-lg);
        font-size: clamp(44px, 7vw, 76px);
        font-weight: 400;
        line-height: .97;
        letter-spacing: -0.04em;
    }
    .home-lead {
        max-width: 620px;
        margin: 0 0 var(--spacing-xl);
        color: var(--color-body);
        font-size: 18px;
        line-height: 28px;
    }
    .cta-row { display: flex; flex-wrap: wrap; gap: var(--spacing-md); }
    .quickstart-panel {
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        background: var(--color-canvas-soft);
        padding: 22px;
    }
    .quickstart-panel h2 {
        margin-bottom: var(--spacing-lg);
        font-size: 22px;
        letter-spacing: -0.02em;
    }
    .quickstart-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
    }
    .quickstart-list li {
        border-top: 1px solid var(--color-hairline);
    }
    .quickstart-list li:first-child { border-top: none; }
    .quickstart-link {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: var(--spacing-md);
        padding: 16px 0;
        color: inherit;
        text-decoration: none;
        border-radius: var(--radius-sm);
        transition: background-color .15s ease, color .15s ease;
    }
    .quickstart-list li:first-child .quickstart-link { padding-top: 0; }
    .quickstart-list li:last-child .quickstart-link { padding-bottom: 0; }
    .quickstart-link:hover {
        color: var(--color-ink);
        text-decoration: none;
    }
    .step-number.step-done {
        color: #10b981; /* green-500 */
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .quickstart-link:hover .step-number:not(.step-done),
    .quickstart-link:focus-visible .step-number:not(.step-done) {
        border-color: var(--color-border);
        color: var(--color-ink);
    }
    .quickstart-link:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px var(--color-canvas), 0 0 0 4px rgba(245, 245, 245, .55);
    }
    .step-number {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-canvas-card);
        color: var(--color-body);
        font-family: var(--font-mono);
        font-size: 11px;
    }
    .quickstart-list h3 {
        margin: 0 0 4px;
        font-size: 15px;
        font-weight: 500;
    }
    .quickstart-list p { margin: 0; font-size: 13px; line-height: 20px; }
    .home-section {
        padding: 48px 0;
        border-bottom: 1px solid var(--color-hairline);
    }
    .home-section:last-child { border-bottom: none; }
    .home-section h2 { max-width: 620px; margin-bottom: var(--spacing-md); }
    .home-section p { max-width: 620px; margin-bottom: 0; }
    .home-section--split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, .48fr);
        gap: 32px;
        align-items: center;
    }
    .section-action { justify-self: end; }
    .flagship-showcase {
        position: relative;
        isolation: isolate;
    }
    .flagship-showcase::before {
        content: "";
        position: absolute;
        z-index: -1;
        top: 10px;
        right: -12%;
        width: 440px;
        height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(48, 209, 88, .08), transparent 68%);
        pointer-events: none;
    }
    .flagship-heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 32px;
        align-items: end;
        margin-bottom: 28px;
    }
    .flagship-heading h2 {
        max-width: 760px;
        margin-bottom: var(--spacing-md);
        font-size: clamp(30px, 4vw, 46px);
        letter-spacing: -0.035em;
    }
    .flagship-heading p { max-width: 680px; }
    .flagship-section-label { color: var(--color-success); }
    .flagship-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: 14px;
    }
    .flagship-card {
        position: relative;
        display: flex;
        min-width: 0;
        min-height: 390px;
        flex-direction: column;
        overflow: hidden;
        padding: 22px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        background:
            linear-gradient(145deg, rgba(255, 255, 255, .035), transparent 42%),
            var(--color-canvas-soft);
        color: inherit;
        text-decoration: none;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .025);
        transition: transform .2s ease, border-color .2s ease, background-color .2s ease, box-shadow .2s ease;
    }
    .flagship-card:hover,
    .flagship-card:focus-visible {
        transform: translateY(-4px);
        border-color: rgba(48, 209, 88, .48);
        background-color: var(--color-canvas-card);
        color: inherit;
        text-decoration: none;
        box-shadow: 0 18px 44px rgba(0, 0, 0, .2), inset 0 1px 0 rgba(255, 255, 255, .05);
    }
    .flagship-card:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px var(--color-canvas), 0 0 0 4px var(--color-success);
    }
    .flagship-card-topline {
        position: absolute;
        top: 0;
        right: 20px;
        left: 20px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--color-success), transparent);
        opacity: .75;
    }
    .flagship-card-header {
        display: flex;
        align-items: center;
        gap: 11px;
    }
    .flagship-provider-logo {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        padding: 6px;
        border: 1px solid var(--color-hairline);
        border-radius: 10px;
        background: var(--color-canvas-card);
        object-fit: contain;
    }
    .flagship-provider-fallback {
        display: grid;
        place-items: center;
        color: var(--color-ink);
        font-family: var(--font-mono);
        font-size: 11px;
    }
    .flagship-provider-copy {
        display: flex;
        min-width: 0;
        flex: 1;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }
    .flagship-provider {
        overflow: hidden;
        color: var(--color-body);
        font-size: 13px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .flagship-mark {
        padding: 4px 8px;
        border: 1px solid rgba(48, 209, 88, .25);
        border-radius: var(--radius-pill);
        color: var(--color-success);
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .flagship-model-copy { margin: 24px 0 22px; }
    .flagship-model-copy h3 {
        margin: 0 0 7px;
        font-size: 24px;
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1.12;
    }
    .flagship-model-copy code {
        display: block;
        overflow: hidden;
        padding: 0;
        background: transparent;
        color: var(--color-mute);
        font-family: var(--font-mono);
        font-size: 11px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .flagship-price-comparison {
        margin-top: auto;
        border-top: 1px solid var(--color-hairline);
        border-bottom: 1px solid var(--color-hairline);
        font-variant-numeric: tabular-nums;
    }
    .flagship-price-legend,
    .flagship-price-row {
        display: grid;
        grid-template-columns: minmax(58px, .8fr) minmax(78px, 1fr) minmax(78px, 1fr);
        gap: 9px;
        align-items: baseline;
    }
    .flagship-price-legend {
        padding: 12px 0 8px;
        color: var(--color-mute);
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: .05em;
        text-transform: uppercase;
    }
    .flagship-price-row {
        padding: 8px 0;
        border-top: 1px solid rgba(255, 255, 255, .045);
    }
    .flagship-price-kind {
        color: var(--color-body);
        font-size: 12px;
    }
    .flagship-price-row del {
        color: var(--color-mute);
        font-family: var(--font-mono);
        font-size: 12px;
        text-decoration-color: rgba(255, 255, 255, .55);
        text-decoration-thickness: 1px;
    }
    .flagship-price-row strong {
        color: var(--color-success);
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 600;
    }
    .flagship-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        color: var(--color-mute);
        font-size: 11px;
    }
    .flagship-arrow {
        color: var(--color-success);
        font-size: 16px;
        transition: transform .2s ease;
    }
    .flagship-card:hover .flagship-arrow,
    .flagship-card:focus-visible .flagship-arrow { transform: translate(2px, -2px); }
    .proof-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }
    .proof-item {
        min-height: 180px;
        padding: 20px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        background: var(--color-canvas-soft);
    }
    .proof-item:hover {
        border-color: var(--color-border);
        background: var(--color-canvas-card);
    }
    .proof-item h2 {
        max-width: none;
        margin-bottom: var(--spacing-md);
        font-size: 24px;
    }
    .proof-icon {
        width: 34px;
        height: 34px;
        margin-bottom: 22px;
        border: 1px solid var(--color-hairline);
        border-radius: 8px;
        color: var(--color-body);
        position: relative;
    }
    .proof-icon::before {
        content: "";
        position: absolute;
        inset: 8px;
        background: currentColor;
        mask: var(--icon) center / contain no-repeat;
        -webkit-mask: var(--icon) center / contain no-repeat;
    }
