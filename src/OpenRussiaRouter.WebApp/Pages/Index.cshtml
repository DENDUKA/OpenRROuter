@page
@model IndexModel
@{
    Layout = "~/Pages/Shared/_CatalogLayout.cshtml";
    // Was null, which collapsed the most valuable <title> on the site to the bare brand name.
    // Mirrors the H1 (Home_Title) so title/H1/intent stay aligned.
    ViewData["Title"] = Localizer["Title"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
}

<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            <div class="provider-strip" aria-hidden="true">
                @foreach (var p in Model.Providers)
                {
                    <span class="provider-icon provider-icon-dynamic">
                        <img src="/providers/logo/@Uri.EscapeDataString(p.Id)" alt="@p.DisplayName" width="24" height="24" loading="lazy" decoding="async" />
                    </span>
                }

            </div>
            <h1 id="home-title" class="home-title">@Localizer["Home_Title"]</h1>
            <p class="home-lead">
                @Localizer["Home_Lead"]
            </p>
            @if (Model.StartBalanceEnabled || Model.FirstTopUpEnabled)
            {
                <div class="promo-badges">
                    @if (Model.StartBalanceEnabled)
                    {
                        <span class="promo-badge">Стартовый баланс $@Model.StartBalanceAmountUsd</span>
                    }
                    @if (Model.FirstTopUpEnabled)
                    {
                        <span class="promo-badge">+@Model.FirstTopUpPercent% к первому пополнению</span>
                    }
                </div>
            }
            <div class="cta-row" aria-label="@Localizer["A11y_PrimaryActions"]">
                <a href="/signup" class="btn btn-primary" data-goal="cta_signup_hero">@Localizer["Home_CtaSignup"]</a>
                <a href="/models" class="btn btn-secondary" data-goal="cta_models_hero">@Localizer["Home_CtaExplore"]</a>
            </div>
        </div>

        <div class="quickstart-panel" aria-labelledby="quickstart-title">
            <div class="section-label">@Localizer["Home_QuickstartLabel"]</div>
            <h2 id="quickstart-title">@Localizer["Home_QuickstartTitle"]</h2>
            <ol class="quickstart-list">
                <li>
                    <a class="quickstart-link" href="/signup" data-goal="cta_signup_quickstart">
                        @if (Model.CurrentUser != null)
                        {
                            <span class="step-number step-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                        }
                        else
                        {
                            <span class="step-number">01</span>
                        }
                        <div>
                            <h3>@Localizer["Home_StepSignup_Title"]</h3>
                            <p>@Localizer["Home_StepSignup_Desc"]</p>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="quickstart-link" href="/workspace/credits">
                        @if (Model.HasBalance)
                        {
                            <span class="step-number step-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                        }
                        else
                        {
                            <span class="step-number">02</span>
                        }
                        <div>
                            <h3>@Localizer["Home_StepBuy_Title"]</h3>
                            @if (!Model.HasPaidTopUp && Model.FirstTopUpBonusAvailable)
                            {
                                <p>@Localizer["Home_StepBuy_Desc_PromoBonus", Model.FirstTopUpPercent]</p>
                            }
                            else
                            {
                                <p>@Localizer["Home_StepBuy_Desc"]</p>
                            }
                        </div>
                    </a>
                </li>
                <li>
                    <a class="quickstart-link" href="/workspace/apikeys">
                        @if (Model.HasApiKey)
                        {
                            <span class="step-number step-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                        }
                        else
                        {
                            <span class="step-number">03</span>
                        }
                        <div>
                            <h3>@Localizer["Home_StepKey_Title"]</h3>
                            <p>@Localizer["Home_StepKey_Desc"]</p>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="quickstart-link" href="/models">
                        @if (Model.CurrentUser != null && Model.HasBalance && Model.HasApiKey)
                        {
                            <span class="step-number step-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                        }
                        else
                        {
                            <span class="step-number">04</span>
                        }
                        <div>
                            <h3>@Localizer["Home_StepModel_Title"]</h3>
                            <p>@Localizer["Home_StepModel_Desc"]</p>
                        </div>
                    </a>
                </li>
            </ol>
        </div>
    </section>

    @if (Model.FlagshipModels.Count > 0)
    {
        <section class="home-section flagship-showcase" aria-labelledby="flagship-title">
            <div class="flagship-heading">
                <div>
                    <div class="section-label flagship-section-label">@Localizer["Home_CatalogLabel"]</div>
                    <h2 id="flagship-title">@Localizer["Home_CatalogTitle"]</h2>
                    @if (!string.IsNullOrWhiteSpace(Localizer["Home_CatalogLead"].Value))
                    {
                        <p>@Localizer["Home_CatalogLead"]</p>
                    }
                </div>
                <a href="/models" class="btn btn-secondary" data-goal="cta_models_catalog">@Localizer["Home_CtaExplore"]</a>
            </div>

            <div class="flagship-carousel" data-flagship-carousel>
                <div class="flagship-track" data-flagship-track>
                    <div class="flagship-cycle" data-flagship-cycle>
                        @foreach (var flagship in Model.FlagshipModels)
                        {
                            <a class="flagship-card" href="@flagship.Path"
                               aria-label="@Localizer["Home_FlagshipCardAria", flagship.DisplayName]">
                                <div class="flagship-card-topline" aria-hidden="true"></div>
                                <div class="flagship-card-header">
                                    @if (!string.IsNullOrWhiteSpace(flagship.ProviderId))
                                    {
                                        <img class="flagship-provider-logo"
                                             src="/providers/logo/@Uri.EscapeDataString(flagship.ProviderId)"
                                             alt="" aria-hidden="true" width="42" height="42" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <span class="flagship-provider-logo flagship-provider-fallback" aria-hidden="true">
                                            @IndexModel.GetInitials(flagship.Provider)
                                        </span>
                                    }
                                    <div class="flagship-provider-copy">
                                        <span class="flagship-provider">@flagship.Provider</span>
                                    </div>
                                </div>

                                <div class="flagship-model-copy">
                                    <div class="flagship-model-heading">
                                        <h3>@flagship.DisplayName</h3>
                                        @if (flagship.MaxDiscountPercent is { } discount)
                                        {
                                            <span class="flagship-discount" title="@Localizer["Home_DiscountTooltip"]">
                                                <strong>−@discount%</strong>
                                            </span>
                                        }
                                    </div>
                                    <code>@flagship.Id</code>
                                </div>

                                <table class="flagship-price-comparison">
                                    <thead>
                                        <tr>
                                            <th scope="col">@Localizer["Home_PriceOperation"]</th>
                                            <th scope="col">@Localizer["Home_PriceColumn"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="flagship-price-row">
                                            <th scope="row" class="flagship-price-kind">@Localizer["Home_PriceInput"]</th>
                                            <td>
                                                <div class="flagship-price-pair">
                                                    <strong title="@Localizer["Home_PriceOurs"]">@IndexModel.FormatUsdPrice(flagship.InputPrice)</strong>
                                                    <del title="@Localizer["Home_PriceOpenRouter"]">@IndexModel.FormatUsdPrice(flagship.OpenRouterInputPrice)</del>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr class="flagship-price-row">
                                            <th scope="row" class="flagship-price-kind">@Localizer["Home_PriceOutput"]</th>
                                            <td>
                                                <div class="flagship-price-pair">
                                                    <strong title="@Localizer["Home_PriceOurs"]">@IndexModel.FormatUsdPrice(flagship.OutputPrice)</strong>
                                                    <del title="@Localizer["Home_PriceOpenRouter"]">@IndexModel.FormatUsdPrice(flagship.OpenRouterOutputPrice)</del>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr class="flagship-price-row">
                                            <th scope="row" class="flagship-price-kind">@Localizer["Home_PriceCache"]</th>
                                            <td>
                                                <div class="flagship-price-pair">
                                                    <strong title="@Localizer["Home_PriceOurs"]">@IndexModel.FormatUsdPrice(flagship.CachePrice)</strong>
                                                    <del title="@Localizer["Home_PriceOpenRouter"]">@IndexModel.FormatUsdPrice(flagship.OpenRouterCachePrice)</del>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div class="flagship-card-footer">
                                    <span>@Localizer["Home_PriceUnit"]</span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </section>
    }

    <section class="home-section proof-grid" aria-label="@Localizer["A11y_PlatformCapabilities"]">
        <div class="proof-item">
            <div class="proof-icon proof-icon-savings" aria-hidden="true"></div>
            <h2>@Localizer["Home_ProofSavings_Title"]</h2>
            <p>
                @Localizer["Home_ProofSavings_Desc"]
            </p>
        </div>
        <div class="proof-item">
            <div class="proof-icon proof-icon-billing" aria-hidden="true"></div>
            <h2>@Localizer["Home_ProofBilling_Title"]</h2>
            <p>
                @Localizer["Home_ProofBilling_Desc"]
            </p>
        </div>
        <div class="proof-item">
            <div class="proof-icon proof-icon-routing" aria-hidden="true"></div>
            <h2>@Localizer["Home_ProofRouting_Title"]</h2>
            <p>
                @Localizer["Home_ProofRouting_Desc"]
            </p>
        </div>
        <div class="proof-item">
            <div class="proof-icon proof-icon-apikeys" aria-hidden="true"></div>
            <h2>@Localizer["Home_ProofApiKeys_Title"]</h2>
            <p>
                @Localizer["Home_ProofApiKeys_Desc"]
            </p>
        </div>
    </section>

    <section class="home-section home-section--split request-section" aria-labelledby="request-title">
        <div>
            <div class="section-label">@Localizer["Home_ApiLabel"]</div>
            <h2 id="request-title">@Localizer["Home_ApiTitle"]</h2>
            <p>
                @Localizer["Home_ApiLead"]
            </p>
            <a href="/docs" class="text-link">@Localizer["Home_ApiGuide"]</a>
        </div>
        <div class="code-panel-container">
            <div class="code-tabs" role="tablist">
                <button type="button" class="code-tab is-active" id="tab-openai" role="tab" aria-selected="true" aria-controls="panel-openai" onclick="switchApiTab('openai')">
                    @Localizer["Home_ApiTabOpenAI"]
                </button>
                <button type="button" class="code-tab" id="tab-anthropic" role="tab" aria-selected="false" aria-controls="panel-anthropic" onclick="switchApiTab('anthropic')">
                    @Localizer["Home_ApiTabAnthropic"]
                </button>
            </div>
            <div class="code-panel" id="panel-openai" role="tabpanel" aria-labelledby="tab-openai" aria-label="@Localizer["A11y_ExampleCurlRequest"]">
<pre><code># Base URL: https://api.rawrter.com/v1
curl https://api.rawrter.com/v1/chat/completions \
  -H "Authorization: Bearer $ORR_API_KEY" \
  -H "Content-Type: application/json" \
  -d '{
    "model": "ORR/...",
    "messages": [
      { "role": "user", "content": "Hello" }
    ]
  }'</code></pre>
            </div>
            <div class="code-panel is-hidden" id="panel-anthropic" role="tabpanel" aria-labelledby="tab-anthropic" aria-label="Anthropic Claude Code Request">
<pre><code># Base URL: https://api.rawrter.com
# Claude Code config (~/.claude.json):
{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.rawrter.com",
    "ANTHROPIC_AUTH_TOKEN": "sk-or-...",
    "ANTHROPIC_MODEL": "ORR/..."
  }
}</code></pre>
            </div>
        </div>
    </section>

    <section class="home-section final-cta" aria-labelledby="final-cta-title">
        <div>
            <div class="section-label">@Localizer["Home_FinalLabel"]</div>
            <h2 id="final-cta-title">@Localizer["Home_FinalTitle"]</h2>
            <p>@Localizer["Home_FinalLead"]</p>
        </div>
        <div class="cta-row">
            <a href="/signup" class="btn btn-primary" data-goal="cta_signup_final">@Localizer["Home_FinalCtaSignup"]</a>
            <a href="/models" class="btn btn-secondary" data-goal="cta_models_final">@Localizer["Home_FinalCtaModels"]</a>
        </div>
    </section>
</div>

<style>
    .home-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr);
        gap: 40px;
        align-items: start;
        padding: 0 0 64px;
        border-bottom: 1px solid var(--color-hairline);
    }
    .provider-strip { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
    .provider-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border: 1px solid var(--provider-border);
        border-radius: 10px;
        background: var(--provider-bg);
        color: var(--provider-color);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04);
    }
    .provider-icon img {
        width: 25px;
        height: 25px;
        display: block;
        object-fit: contain;
    }
    .provider-icon-dynamic {
        --provider-color: var(--color-body);
        --provider-bg: var(--color-canvas-soft);
        --provider-border: var(--color-hairline);
    }

    .home-title {
        max-width: 820px;
        margin: 0 0 var(--spacing-lg);
        font-size: clamp(36px, 5.2vw, 76px);
        font-weight: 400;
        line-height: .97;
        letter-spacing: -0.04em;
    }
    .home-lead {
        max-width: 620px;
        margin: 0 0 var(--spacing-xl);
        color: var(--color-body);
        font-size: 18px;
        line-height: 28px;
    }
    .promo-badges {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        margin-bottom: var(--spacing-md);
    }
    .promo-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border: 1px solid rgba(34, 197, 94, .32);
        border-radius: var(--radius-pill);
        background: rgba(34, 197, 94, .08);
        color: var(--color-success);
        font-size: 13px;
        line-height: 1.2;
    }
    .cta-row { display: flex; flex-wrap: wrap; gap: var(--spacing-md); }
    .quickstart-panel {
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        background: var(--color-canvas-soft);
        padding: 22px;
    }
    .quickstart-panel h2 {
        margin-bottom: var(--spacing-lg);
        font-size: 22px;
        letter-spacing: -0.02em;
    }
    .quickstart-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
    }
    .quickstart-list li {
        border-top: 1px solid var(--color-hairline);
    }
    .quickstart-list li:first-child { border-top: none; }
    .quickstart-link {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: var(--spacing-md);
        padding: 16px 0;
        color: inherit;
        text-decoration: none;
        border-radius: var(--radius-sm);
        transition: background-color .15s ease, color .15s ease;
    }
    .quickstart-list li:first-child .quickstart-link { padding-top: 0; }
    .quickstart-list li:last-child .quickstart-link { padding-bottom: 0; }
    .quickstart-link:hover {
        color: var(--color-ink);
        text-decoration: none;
    }
    .step-number.step-done {
        color: #10b981; /* green-500 */
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .quickstart-link:hover .step-number:not(.step-done),
    .quickstart-link:focus-visible .step-number:not(.step-done) {
        border-color: var(--color-border);
        color: var(--color-ink);
    }
    .quickstart-link:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px var(--color-canvas), 0 0 0 4px rgba(245, 245, 245, .55);
    }
    .step-number {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-canvas-card);
        color: var(--color-body);
        font-family: var(--font-mono);
        font-size: 11px;
    }
    .quickstart-list h3 {
        margin: 0 0 4px;
        font-size: 15px;
        font-weight: 500;
    }
    .quickstart-list p { margin: 0; font-size: 13px; line-height: 20px; }
    .home-section {
        padding: 48px 0;
        border-bottom: 1px solid var(--color-hairline);
    }
    .home-section:last-child { border-bottom: none; }
    .home-section h2 { max-width: 620px; margin-bottom: var(--spacing-md); }
    .home-section p { max-width: 620px; margin-bottom: 0; }
    .home-section--split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, .48fr);
        gap: 32px;
        align-items: center;
    }
    .section-action { justify-self: end; }
    .flagship-showcase {
        --color-accent-green: #34d399;
        --color-accent-green-bg: rgba(52, 211, 153, .08);
        --color-success: var(--color-accent-green);
        --color-strikethrough: #9ca3af;
        --color-old-price-accent: #f87171;
        --color-text-primary: #f3f4f6;
        --color-text-muted: #8b949e;
        --color-border-subtle: rgba(255, 255, 255, .06);
        --color-body: #c3c6cf;
        --color-mute: var(--color-text-muted);
        --radius-lg: 20px;
        --flagship-card-width: clamp(280px, 28vw, 330px);
        position: relative;
        isolation: isolate;
        overflow-x: clip;
    }
    .flagship-showcase::before {
        content: "";
        position: absolute;
        z-index: -1;
        top: 10px;
        right: 0;
        width: 440px;
        height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, var(--color-accent-green-bg), transparent 68%);
        pointer-events: none;
    }
    .flagship-heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 32px;
        align-items: end;
        margin-bottom: 28px;
    }
    .flagship-heading h2 {
        max-width: 760px;
        margin-bottom: var(--spacing-md);
        font-size: clamp(28px, 3.5vw, 40px);
        font-weight: 500;
        letter-spacing: -0.025em;
        line-height: 1.2;
    }
    .flagship-heading p {
        max-width: 680px;
        font-size: 16px;
        line-height: 1.65;
    }
    .flagship-section-label {
        color: var(--color-success);
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 500;
        letter-spacing: .04em;
    }
    .flagship-carousel {
        position: relative;
        overflow-x: auto;
        overflow-y: hidden;
        margin-inline: 0;
        padding-inline: 0;
        padding-block: 8px 32px;
        margin-bottom: -24px;
        cursor: grab;
        scrollbar-width: none;
        overscroll-behavior-inline: contain;
        touch-action: auto;
        mask-image: linear-gradient(90deg, transparent, #000 42px, #000 calc(100% - 42px), transparent);
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 42px, #000 calc(100% - 42px), transparent);
    }
    [data-flagship-carousel][data-flagship-initialized="true"] { touch-action: pan-y; }
    .flagship-carousel::-webkit-scrollbar { display: none; }
    .flagship-carousel.is-dragging {
        cursor: grabbing;
        user-select: none;
    }
    .flagship-track,
    .flagship-cycle {
        display: flex;
        gap: 14px;
    }
    .flagship-track { width: max-content; }
    .flagship-card {
        position: relative;
        display: flex;
        width: var(--flagship-card-width);
        min-width: 0;
        min-height: 400px;
        flex: 0 0 var(--flagship-card-width);
        flex-direction: column;
        justify-content: space-between;
        gap: 20px;
        overflow: hidden;
        padding: 24px;
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: var(--radius-lg, 20px);
        background:
            linear-gradient(165deg, rgba(255, 255, 255, .04) 0%, rgba(255, 255, 255, .01) 40%, transparent 100%),
            var(--color-canvas-soft, #111315);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: var(--color-text-primary, #f3f4f6);
        text-decoration: none;
        box-shadow: 0 16px 36px -8px rgba(0, 0, 0, .55), inset 0 1px 0 rgba(255, 255, 255, .08);
        transition: transform .25s cubic-bezier(.16, 1, .3, 1), border-color .25s ease, box-shadow .25s ease;
    }
    .flagship-card:hover,
    .flagship-card:focus-visible {
        transform: translateY(-3px);
        border-color: rgba(52, 211, 153, .25);
        color: var(--color-text-primary, #f3f4f6);
        text-decoration: none;
        box-shadow: 0 24px 48px -12px rgba(0, 0, 0, .7), inset 0 1px 0 rgba(255, 255, 255, .12);
    }
    .flagship-card:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px var(--color-canvas), 0 0 0 4px var(--color-success);
    }
    .flagship-card-topline {
        position: absolute;
        top: 0;
        right: 20px;
        left: 20px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--color-success), transparent);
        opacity: .45;
    }
    .flagship-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .flagship-provider-logo {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        padding: 8px;
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 12px;
        background: rgba(255, 255, 255, .025);
        object-fit: contain;
    }
    .flagship-provider-fallback {
        display: grid;
        place-items: center;
        color: var(--color-ink);
        font-family: var(--font-mono);
        font-size: 13px;
    }
    .flagship-provider-copy {
        display: flex;
        min-width: 0;
        flex: 1;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }
    .flagship-provider {
        overflow: hidden;
        color: var(--color-body);
        font-size: 16px;
        font-weight: 500;
        line-height: 1.5;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .flagship-model-copy { margin: 4px 0 8px; }
    .flagship-model-heading {
        display: grid;
