@page "/invite/{token}"
@model InviteModel
@{ ViewData["Title"] = "Complete Registration"; }

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">OPENRUSSIAROUTER</div>
        <div class="auth-title">Complete Registration</div>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.IsSuccess)
    {
        <div class="alert alert-success" role="alert">
            <p class="mb-1">Registration complete!</p>
            <p><a href="/login">Click here to log in</a></p>
        </div>
    }
    else
    {
        <form method="post">
            <input type="hidden" asp-for="Token" />
            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
            </div>
            <div class="form-group legal-consent">
                <div class="form-check">
                    <input asp-for="Input.AcceptLegal" class="form-check-input" type="checkbox" required />
                    <label asp-for="Input.AcceptLegal" class="form-check-label">
                        Я принимаю <a href="/legal/offer" target="_blank" rel="noopener noreferrer">Публичную оферту</a> и <a href="/legal/privacy" target="_blank" rel="noopener noreferrer">Политику конфиденциальности</a>.
                    </label>
                </div>
                <span asp-validation-for="Input.AcceptLegal" class="validation-message"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Complete Registration</button>
        </form>
    }
</div>

<style>
    .auth-container { max-width: 400px; margin: 0 auto; padding: var(--spacing-section) 0; }
    .auth-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .auth-wordmark { font-size: 16px; font-weight: 700; letter-spacing: 2px; color: var(--color-ink); margin-bottom: var(--spacing-lg); }
    .auth-title { font-size: 24px; font-weight: 700; color: var(--color-ink); }
    .form-group { margin-bottom: var(--spacing-lg); }
</style>
