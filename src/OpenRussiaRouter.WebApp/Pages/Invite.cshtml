@page "/invite/{token}"
@model InviteModel
@{ ViewData["Title"] = Localizer["Invite_Title"]; }

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">RAWRTER</div>
        <div class="auth-title">@Localizer["Invite_Title"]</div>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.IsSuccess)
    {
        <div class="alert alert-success" role="alert">
            <p class="mb-1">@Localizer["Invite_Success"]</p>
            <p><a href="/login">@Localizer["Invite_LoginLink"]</a></p>
        </div>
    }
    else
    {
        <form method="post">
            <input type="hidden" asp-for="Token" />
            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">@Localizer["Invite_Password"]</label>
                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="validation-message" aria-live="polite"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label">@Localizer["Invite_ConfirmPassword"]</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="validation-message" aria-live="polite"></span>
            </div>
            <div class="form-group legal-consent">
                <div class="form-check">
                    <input asp-for="Input.AcceptLegal" class="form-check-input" type="checkbox" required />
                    <label asp-for="Input.AcceptLegal" class="form-check-label">
                        @Localizer["Consent_Prefix"] <a href="/legal/offer" target="_blank" rel="noopener noreferrer">@Localizer["Consent_OfferLink"]</a> @Localizer["Consent_And"] <a href="/legal/privacy" target="_blank" rel="noopener noreferrer">@Localizer["Consent_PrivacyLink"]</a>.
                    </label>
                </div>
                <span asp-validation-for="Input.AcceptLegal" class="validation-message" aria-live="polite"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">@Localizer["Invite_Submit"]</button>
        </form>
    }
</div>

<style>
    .auth-container { max-width: 400px; margin: 0 auto; padding: var(--spacing-section) 0; }
    .auth-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .auth-wordmark { font-size: 16px; font-weight: 700; letter-spacing: 2px; color: var(--color-ink); margin-bottom: var(--spacing-lg); }
    .auth-title { font-size: 24px; font-weight: 700; color: var(--color-ink); }
    .form-group { margin-bottom: var(--spacing-lg); }
</style>
