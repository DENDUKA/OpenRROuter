@page
@model LoginModel
@{
    ViewData["Title"] = Localizer["Login_Title"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
}

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">OPENRUSSIAROUTER</div>
        <div class="auth-title">@Localizer["Login_Title"]</div>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="form-group">
            <label asp-for="Input.Email" class="form-label">@Localizer["Login_Email"]</label>
            <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="validation-message" aria-live="polite"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Password" class="form-label">@Localizer["Login_Password"]</label>
            <div class="input-with-toggle">
                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" id="login-password" />
                <button type="button" class="password-toggle" onclick="togglePassword('login-password', this)" aria-label="@Localizer["A11y_ShowPassword"]">
                    <svg class="eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-closed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="validation-message" aria-live="polite"></span>
            <div class="forgot-link"><a href="/forgot-password">@Localizer["Login_ForgotPassword"]</a></div>
        </div>
        <button type="submit" class="btn btn-primary w-100">@Localizer["Login_Submit"]</button>
    </form>
    <div class="auth-divider">@Localizer["Login_Divider"]</div>
    @if (Model.GoogleEnabled)
    {
        <form method="post" asp-page-handler="Google">
            <button type="submit" class="btn btn-secondary w-100 btn-oauth" data-goal="cta_oauth_google">
                <svg class="oauth-icon" width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                @Localizer["Login_Google"]
            </button>
        </form>
    }
    @if (Model.YandexEnabled)
    {
        <form method="post" asp-page-handler="Yandex">
            <button type="submit" class="btn btn-secondary w-100 btn-oauth" data-goal="cta_oauth_yandex">
                <img class="oauth-icon" src="/icons/yandex.svg" alt="Yandex" width="20" height="20" />
                @Localizer["Login_Yandex"]
            </button>
        </form>
    }
    <div class="auth-alt">@Localizer["Login_AltSignup"] <a href="/signup">@Localizer["Login_SignupLink"]</a></div>
</div>

<style>
    .auth-container { max-width: 400px; margin: 0 auto; padding: var(--spacing-section) 0; }
    .auth-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .auth-wordmark { font-size: 16px; font-weight: 500; letter-spacing: 2px; color: var(--color-ink); margin-bottom: var(--spacing-lg); }
    .auth-title { font-size: 38px; font-weight: 400; color: var(--color-ink); }
    .form-group { margin-bottom: var(--spacing-lg); }
    .auth-divider { text-align: center; margin: var(--spacing-lg) 0; color: var(--color-body-mid); font-size: 13px; }
    .forgot-link { text-align: right; margin-top: var(--spacing-xs); font-size: 13px; }
    .auth-alt { text-align: center; margin-top: var(--spacing-lg); color: var(--color-body-mid); font-size: 13px; }
    .input-with-toggle { position: relative; }
    .input-with-toggle .form-control { padding-right: 44px; }
    .password-toggle {
        position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
        width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
        border: none; background: transparent; color: var(--color-body); cursor: pointer;
        border-radius: var(--radius-sm);
    }
    .password-toggle:hover { color: var(--color-ink); background: var(--color-canvas-mid); }
    .btn-oauth { display: inline-flex; align-items: center; justify-content: center; gap: 10px; }
    .oauth-icon { flex-shrink: 0; border-radius: 2px; }
</style>

@section Scripts {
<script>
    function togglePassword(inputId, btn) {
        var input = document.getElementById(inputId);
        var open = btn.querySelector('.eye-open');
        var closed = btn.querySelector('.eye-closed');
        if (input.type === 'password') {
            input.type = 'text'; open.style.display = 'none'; closed.style.display = '';
        } else {
            input.type = 'password'; open.style.display = ''; closed.style.display = 'none';
        }
    }
</script>
}
