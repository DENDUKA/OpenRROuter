@page
@model LoginModel
@{ ViewData["Title"] = "Login"; }

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">OPENRUSSIAROUTER</div>
        <div class="auth-title">Login</div>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="form-group">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="validation-message"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Password" class="form-label">Password</label>
            <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="validation-message"></span>
            <div class="forgot-link"><a href="/forgot-password">Forgot password?</a></div>
        </div>
        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>
    <div class="auth-divider">or</div>
    <form method="post" asp-page-handler="Google">
        <div class="form-group legal-consent">
            <div class="form-check">
                <input asp-for="Input.AcceptLegal" class="form-check-input" type="checkbox" required />
                <label asp-for="Input.AcceptLegal" class="form-check-label">
                    Я принимаю <a href="/legal/offer" target="_blank" rel="noopener noreferrer">Публичную оферту</a> и <a href="/legal/privacy" target="_blank" rel="noopener noreferrer">Политику конфиденциальности</a>.
                </label>
            </div>
            <span asp-validation-for="Input.AcceptLegal" class="validation-message"></span>
        </div>
        <button type="submit" class="btn btn-secondary w-100">Sign in with Google</button>
    </form>
    <div class="auth-alt">Don't have an account? <a href="/signup">Sign up</a></div>
</div>

<style>
    .auth-container { max-width: 400px; margin: 0 auto; padding: var(--spacing-section) 0; }
    .auth-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .auth-wordmark { font-size: 16px; font-weight: 500; letter-spacing: 2px; color: var(--color-ink); margin-bottom: var(--spacing-lg); }
    .auth-title { font-size: 38px; font-weight: 400; color: var(--color-ink); }
    .form-group { margin-bottom: var(--spacing-lg); }
    .auth-divider { text-align: center; margin: var(--spacing-lg) 0; color: var(--color-body-mid); font-size: 13px; }
    .forgot-link { text-align: right; margin-top: var(--spacing-xs); font-size: 13px; }
    .auth-alt { text-align: center; margin-top: var(--spacing-lg); color: var(--color-body-mid); font-size: 13px; }
</style>
