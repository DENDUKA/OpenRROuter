@page "/models/{provider}/{slug}"
@model ModelDetailsModel
@using OpenRussiaRouter.WebApp.Services.Markup
@* Site origin, not the API base: structured-data URLs must match the canonical the layout emits. *@
@inject OpenRussiaRouter.WebApp.Services.SiteBaseUrlResolver SiteUrlResolver
@{
    ViewData["Title"] = Model.DisplayName;
    var metaDescription = Localizer["MetaDescription", Model.DisplayName, Model.ProviderTitle,
        Model.FormatPrice(Model.InputPrice), Model.FormatPrice(Model.OutputPrice), Model.ContextDisplay, Model.PublicModelId];
    ViewData["MetaDescription"] = metaDescription;

    var seoBase = SiteUrlResolver.Resolve(Model.Request);
    var modelUrl = seoBase + Model.Request.Path;
    ViewData["StructuredData"] = new[]
    {
        StructuredData.ModelProduct(
            Model.DisplayName,
            metaDescription.Value,
            Model.PublicModelId,
            Model.ProviderTitle,
            modelUrl,
            Model.InputPrice,
            Model.OutputPrice,
            Model.HasPricing),
        StructuredData.Breadcrumbs(
        [
            (Localizer["Nav_Home"].Value, seoBase + "/"),
            (Localizer["Nav_Models"].Value, seoBase + "/models"),
            (Model.ProviderTitle, seoBase + "/providers/" + Uri.EscapeDataString(Model.ProviderRouteId)),
            (Model.DisplayName, modelUrl),
        ]),
    };
}

<div class="model-detail-page">
    <section class="model-hero">
        <div class="breadcrumb">
            <a href="/">@Localizer["Nav_Home"]</a>
            <span class="breadcrumb-sep">/</span>
            <a href="/models">@Localizer["Nav_Models"]</a>
            <span class="breadcrumb-sep">/</span>
            <a href="/providers/@Uri.EscapeDataString(Model.ProviderRouteId)">@Model.ProviderTitle</a>
            <span class="breadcrumb-sep">/</span>
            <span>@Model.DisplayName</span>
        </div>
        <h1 class="model-title">
            @if (!string.IsNullOrEmpty(Model.ModelData?.ProviderId))
            {
                <img class="model-provider-icon" src="/providers/logo/@Uri.EscapeDataString(Model.ModelData.ProviderId)" alt="" aria-hidden="true" />
            }
            else if (ModelsModel.TryGetStaticIcon(Model.Provider, out var iconPath))
            {
                <img class="model-provider-icon" src="@iconPath" alt="" aria-hidden="true" />
            }
            else
            {
                <span class="model-provider-icon model-provider-initials" aria-hidden="true">@Model.Initials</span>
            }
            @Model.DisplayName
        </h1>
        <p class="model-desc">@Localizer["Model_Desc"]</p>

        <div class="hero-actions">
            <a class="btn btn-primary" href="/workspace/apikeys">@Localizer["Model_GetApiKey"]</a>
        </div>

        <div class="metrics-grid" aria-label="@Localizer["Model_MetricsAria"]">
            <div class="metric metric-modalities">
                <div class="metric-label">@Localizer["Model_Metric_Modalities"]</div>
                <div class="modality-icons">
                    <div class="modality-row">
                        <div class="modality-icons-set">
                            @foreach (var mod in Model.InputModalities)
                            {
                                <span class="modality-icon active" title="@mod">@Html.Raw(ModelDetailsModel.ModalityIcon(mod))</span>
                            }
                        </div>
                        <span class="modality-arrow">-></span>
                        <div class="modality-icons-set">
                            @foreach (var mod in Model.OutputModalities)
                            {
                                <span class="modality-icon active" title="@mod">@Html.Raw(ModelDetailsModel.ModalityIcon(mod))</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="metric"><div class="metric-label">@Localizer["Model_Metric_Input"]</div><div class="metric-value">@(Model.IsAudioModel ? "—" : (Model.HasPricing ? Model.FormatPrice(Model.InputPrice) : Localizer["Model_PriceRoute"]))</div></div>
            <div class="metric"><div class="metric-label">@Localizer["Model_Metric_Output"]</div><div class="metric-value">@(Model.HasPricing ? Model.FormatPrice(Model.OutputPrice) : Localizer["Model_PriceRoute"])</div></div>
            <div class="metric"><div class="metric-label">@Localizer["Model_Metric_Cache"]</div><div class="metric-value">@(Model.IsAudioModel ? "—" : (Model.HasPricing ? Model.FormatPrice(Model.CachePrice) : Localizer["Model_PriceRoute"]))</div></div>
            <div class="metric"><div class="metric-label">@Localizer["Model_Metric_Author"]</div><div class="metric-value">@Model.ProviderTitle</div></div>
            <div class="metric"><div class="metric-label">@Localizer["Model_Metric_Context"]</div><div class="metric-value">@Model.ContextDisplay</div></div>
        </div>
    </section>

    <section class="model-section">
        @* The description block had no heading, so the page went H1 -> H2 "API" with the only
           prose in between unlabelled. *@
        <h2>@Localizer["Model_AboutTitle", Model.DisplayName]</h2>
        @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
        {
            <div class="model-markdown">@Html.Raw(Model.DescriptionHtml)</div>
        }
        else
        {
            <p class="text-muted">@Localizer["Model_DescriptionEmpty"]</p>
        }
    </section>

    <section class="model-section">
        <h2>@Localizer["Model_ApiTitle"]</h2>
        <p>@Localizer["Model_ApiLead", Model.PublicModelId]</p>
        <partial name="_IntegrationExamples" model="Model.Integration" />
    </section>

    @if (Model.RelatedModels.Count > 0)
    {
        @* Only outbound catalog links on the page: without them a model detail page is a dead end
           for readers and a leaf with no onward crawl path. *@
        <section class="model-section">
            <h2>@Localizer["Model_RelatedTitle", Model.ProviderTitle]</h2>
            <ul class="related-models">
                @foreach (var related in Model.RelatedModels)
                {
                    <li>
                        <a href="@related.Path">@related.DisplayName</a>
                        <code class="related-model-id">@related.Id</code>
                    </li>
                }
            </ul>
            <p><a href="/providers/@Uri.EscapeDataString(Model.ProviderRouteId)">@Localizer["Model_RelatedAll", Model.ProviderTitle]</a></p>
        </section>
    }
</div>

<style>
    .model-detail-page { width: 100%; }
    .model-hero { padding: 0 0 24px; }
    .model-provider-icon { width: 48px; height: 48px; border-radius: 10px; border: 1px solid var(--color-hairline); object-fit: contain; flex-shrink: 0; vertical-align: middle; }
    .model-provider-initials { display: grid; place-items: center; background: var(--color-canvas-card); color: var(--color-body); font-family: var(--font-mono); font-size: 14px; }
    .model-title { display: flex; align-items: center; gap: 14px; max-width: 820px; margin-bottom: 8px; font-size: clamp(34px, 5vw, 56px); line-height: .98; }
    .model-slug-line { color: var(--color-body); font-size: 15px; }
    .model-desc { max-width: 760px; margin-top: 20px; color: var(--color-body); font-size: 15px; }
    .hero-actions { display: flex; gap: 10px; margin-top: 22px; }
    .metrics-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; margin: 30px 0 0; }
    .metric-label { margin-bottom: 4px; color: var(--color-body-mid); font-size: 12px; }
    .metric-value { color: var(--color-ink); font-size: 16px; font-weight: 500; overflow-wrap: anywhere; }
    .model-section { padding: 32px 0; border-bottom: 1px solid var(--color-hairline); }
    pre { overflow-x: auto; margin: 0; padding: 18px; border: 1px solid var(--color-hairline); border-radius: var(--radius-md); background: var(--color-canvas-card); }
    pre code { padding: 0; background: transparent; color: var(--color-body); font-size: 13px; }
    .metric-modalities { grid-column: span 1; }
    .modality-icons { display: flex; align-items: center; gap: 6px; }
    .modality-row { display: flex; align-items: center; gap: 8px; }
    .modality-icons-set { display: flex; gap: 4px; }
    .modality-arrow { color: var(--color-body-mid); font-size: 14px; font-weight: 500; }
    .modality-icon { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 1px solid var(--color-hairline); border-radius: 6px; }
    .modality-icon.active { color: var(--color-ink); border-color: var(--color-ink); background: var(--color-canvas-card); }
    .modality-icon.inactive { color: var(--color-hairline); border-color: var(--color-hairline); opacity: .35; }
    .model-markdown { max-width: 820px; color: var(--color-ink); font-size: 15px; line-height: 1.65; }
    .related-models { list-style: none; padding: 0; margin: 0 0 var(--spacing-lg); display: grid; gap: var(--spacing-sm); max-width: 820px; }
    .related-models li { display: flex; align-items: baseline; gap: var(--spacing-sm); flex-wrap: wrap; }
    .related-model-id { color: var(--color-mute); font-family: var(--font-mono); font-size: 13px; }
    .model-markdown > :first-child { margin-top: 0; }
    .model-markdown > :last-child { margin-bottom: 0; }
    .model-markdown h1, .model-markdown h2, .model-markdown h3, .model-markdown h4 { margin: 1.4em 0 .5em; line-height: 1.2; font-weight: 600; }
    .model-markdown h1 { font-size: 1.6em; }
    .model-markdown h2 { font-size: 1.35em; }
    .model-markdown h3 { font-size: 1.15em; }
    .model-markdown p, .model-markdown ul, .model-markdown ol, .model-markdown blockquote { margin: .8em 0; }
    .model-markdown ul, .model-markdown ol { padding-left: 1.6em; }
    .model-markdown blockquote { padding: .4em 1em; border-left: 3px solid var(--color-hairline); color: var(--color-body); }
    .model-markdown code { padding: 2px 6px; border-radius: 4px; background: var(--color-canvas-card); font-family: var(--font-mono); font-size: .9em; }
    .model-markdown pre { padding: 14px 16px; border-radius: var(--radius-md); }
    .model-markdown pre code { padding: 0; background: transparent; }
    .model-markdown table { border-collapse: collapse; margin: 1em 0; }
    .model-markdown th, .model-markdown td { padding: 6px 12px; border: 1px solid var(--color-hairline); }
    .model-markdown a { color: var(--color-primary); text-decoration: underline; }
    .model-markdown img { max-width: 100%; height: auto; }
    .model-markdown hr { border: none; border-top: 1px solid var(--color-hairline); margin: 2em 0; }
    @@media (max-width: 900px) { .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .table-scroll { overflow-x: auto; } }
</style>
