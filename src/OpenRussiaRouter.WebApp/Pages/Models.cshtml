@page
@model ModelsModel
@{
    Layout = "~/Pages/Shared/_CatalogLayout.cshtml";
    ViewData["Title"] = Localizer["Catalog_Title"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
}

<div class="models-page">
    <section class="models-hero" aria-labelledby="models-title">
        <div>
            <div class="eyebrow">@Localizer["Catalog_Eyebrow"]</div>
            <h1 id="models-title">@Localizer["Catalog_Title"]</h1>
            <p class="models-lead">@Localizer["Catalog_Lead"]</p>
            <div class="promo-badges">
                <span class="promo-badge">@Localizer["Catalog_SbpBadge"]</span>
            </div>
        </div>
    </section>

    <section class="models-shell" aria-label="@Localizer["Catalog_Title"]">
        <div class="filter-row" aria-label="@Localizer["Catalog_Filters"]">
            <label class="sr-only" for="model-search">@Localizer["Catalog_SearchAria"]</label>
            <input id="model-search" class="search" type="search" placeholder="@Localizer["Catalog_SearchPlaceholder"]" oninput="filterModels()" />

            <div class="filter-group" role="group" aria-label="@Localizer["Catalog_FilterCategoriesAria"]">
                <button type="button" class="filter-pill active"
                        aria-pressed="true"
                        onclick="setCategory('All', this)">
                    <span class="filter-pill-icon" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect></svg>
                    </span>
                    @Localizer["Catalog_Category_All"]
                </button>

                @foreach (var cat in Model.ProviderCategories)
                {
                    <button type="button" class="filter-pill"
                            aria-pressed="false"
                            onclick="setCategory('@cat.Id', this)">
                        <span class="filter-pill-icon" aria-hidden="true">
                            <img src="@cat.IconUrl" width="14" height="14" alt="" />
                        </span>
                        @cat.DisplayName
                    </button>
                }

                @foreach (var cat in Model.CapabilityCategories)
                {
                    <button type="button" class="filter-pill"
                            aria-pressed="false"
                            onclick="setCategory('@cat.Id', this)">
                        <span class="filter-pill-icon" aria-hidden="true">
                            @switch (cat.Id)
                            {
                                case "Text":
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 6H3"></path><path d="M21 12H3"></path><path d="M15.5 18H3"></path></svg>
                                    break;
                                case "Vision":
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    break;
                                case "Coding":
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                                    break;
                            }
                        </span>
                        @cat.DisplayName
                    </button>
                }
            </div>
        </div>

        <div class="models-toolbar">
            <div>
                <div class="toolbar-label">@Localizer["Catalog_AllModelsLabel"]</div>
                <div class="toolbar-count" id="model-count" data-count-singular='@Localizer.GetString("Catalog_CountOne")' data-count-plural='@Localizer.GetString("Catalog_CountMany")'>@(Model.Models.Count == 1 ? Localizer["Catalog_CountOne", Model.Models.Count] : Localizer["Catalog_CountMany", Model.Models.Count])</div>
            </div>
            <div class="toolbar-note">@Localizer["Catalog_PricePrefix"] @Model.CurrencySymbol</div>
        </div>

        @if (Model.ErrorMessage != null)
        {
            <div class="catalog-state error" role="alert">
                <strong>@Localizer["Catalog_LoadFailedTitle"]</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        }
        else if (Model.Models.Count == 0)
        {
            <div class="catalog-state">
                <strong>@Localizer["Catalog_NoModelsTitle"]</strong>
            </div>
        }
        else
        {
            <div class="table-wrap table-scroll">
                <table class="table model-table">
                    <colgroup>
                        <col><col><col><col><col><col><col>
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Catalog_Th_Model"]</th>
                            <th scope="col">@Localizer["Catalog_Th_Author"]</th>
                            <th scope="col">@Localizer["Catalog_Th_Tags"]</th>
                            <th scope="col" class="num">@Localizer["Catalog_Th_InputPrice"]</th>
                            <th scope="col" class="num">@Localizer["Catalog_Th_OutputPrice"]</th>
                            <th scope="col" class="num">@Localizer["Catalog_Th_CachePrice"]</th>
                            <th scope="col" class="num">@Localizer["Catalog_Th_Context"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Models)
                        {
                            var initials = ModelsModel.GetInitials(m.DisplayName);
                            var detailUrl = ModelDetailRoute.TryBuildPath(m.Id, m.ProviderId, m.Provider);
                            var tagSearch = string.Join(" ", m.Tags.Select(t => t.DisplayName));
                            // Razor drops an attribute whose value expression is null, so a model without an
                            // addressable detail URL renders a plain row instead of location.href=''.
                            var rowClick = detailUrl is null ? null : $"location.href='{detailUrl}'";
                            var rowKey = detailUrl is null ? null : $"if(event.key==='Enter')location.href='{detailUrl}'";
                            <tr data-name="@m.DisplayName.ToLower()" data-id="@m.Id.ToLower()"
                                data-provider="@m.Provider.ToLower()" data-capability="@m.Capability.ToLower()"
                                data-tags="@tagSearch.ToLower()"
                                onclick="@rowClick" tabindex="@(detailUrl is null ? null : "0")"
                                role="@(detailUrl is null ? null : "link")"
                                onkeydown="@rowKey">
                                <td>
                                    <div class="model-cell">
                                        @if (!string.IsNullOrEmpty(m.ProviderId))
                                        {
                                             <img class="model-icon" src="/providers/logo/@m.ProviderId" alt="" aria-hidden="true" width="28" height="28" loading="lazy" decoding="async" />
                                        }
                                        else if (ModelsModel.TryGetStaticIcon(m.Provider, out var iconPath))
                                        {
                                             <img class="model-icon" src="@iconPath" alt="" aria-hidden="true" width="28" height="28" loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <div class="model-icon" aria-hidden="true">@initials</div>
                                        }
                                        <div>
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                @* Real <a href>: crawlers do not follow the row's onclick, and without
                                                   it every model detail page is an orphan. The handler stays for UX. *@
                                                @if (detailUrl is not null)
                                                {
                                                    <a class="model-name" href="@detailUrl">@m.DisplayName</a>
                                                }
                                                else
                                                {
                                                    <div class="model-name">@m.DisplayName</div>
                                                }
                                                <button type="button" class="btn btn-icon copy-btn" data-model-id="@m.Id" data-goal="copy_model_id" onclick="copyModelId(event)" title="@Localizer["Catalog_CopyTitle"]" aria-label="@Localizer["Catalog_CopyAria"]">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                                </button>
                                            </div>
                                            <code class="model-slug">@m.Id</code>
                                        </div>
                                    </div>
                                </td>
                                <td class="model-author">
                                    @if (!string.IsNullOrEmpty(m.ProviderId))
                                    {
                                        <a class="model-author-link" href="/providers/@Uri.EscapeDataString(m.ProviderId)">@m.Provider</a>
                                    }
                                    else
                                    {
                                        @m.Provider
                                    }
                                </td>
                                <td>
                                    @if (m.Tags.Count > 0)
                                    {
                                        <div class="tag-list" aria-label="@Localizer["Catalog_TagsAria"]">
                                            @foreach (var tag in m.Tags)
                                            {
                                                <span class="badge model-tag" style="background-color: @(tag.Color ?? "#6c757d"); color: @ColorContrast.TextColor(tag.Color ?? "#6c757d");">@tag.DisplayName</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="num">@(m.ModelType == "audio" ? "—" : Model.FormatPrice(m.InputPrice))</td>
                                <td class="num">@Model.FormatPrice(m.OutputPrice)</td>
                                <td class="num">@(m.ModelType == "audio" ? "—" : Model.FormatPrice(m.CacheWritePrice))</td>
                                <td class="num">@m.Context</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<style>
    .models-page { width: 100%; }
    .models-hero { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--spacing-xl); padding-bottom: var(--spacing-2xl); border-bottom: 1px solid var(--color-hairline); }
    .models-lead { color: var(--color-body); max-width: 620px; font-size: 18px; line-height: 28px; }
    .promo-badges { display: flex; flex-wrap: wrap; gap: var(--spacing-sm); margin-top: var(--spacing-md); }
    .promo-badge { display: inline-flex; align-items: center; padding: 4px 10px; border: 1px solid rgba(34, 197, 94, .32); border-radius: var(--radius-pill); background: rgba(34, 197, 94, .08); color: var(--color-success); font-size: 13px; line-height: 1.2; }
    .models-shell { padding: var(--spacing-xl) 0 var(--spacing-3xl); }
    .filter-group { display: flex; flex-wrap: wrap; gap: var(--spacing-sm); flex: 1 1 auto; }
    .filter-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-xl); }
    .search { flex: 1 1 360px; max-width: 560px; border-radius: var(--radius-pill); }
    .filter-pill { height: 32px; border: 1px solid var(--color-hairline); border-radius: var(--radius-pill); background: transparent; color: var(--color-body); cursor: pointer; font: inherit; padding: 0 var(--spacing-md); display: inline-flex; align-items: center; gap: 5px; transition: border-color .15s ease, color .15s ease, background-color .15s ease; }
    .filter-pill-icon { display: inline-flex; align-items: center; flex-shrink: 0; }
    .filter-pill:hover, .filter-pill:focus-visible { border-color: rgba(255,255,255,.45); color: var(--color-ink); outline: none; }
    .filter-pill.active { background: var(--color-canvas-card); border-color: var(--color-border); color: var(--color-ink); }
    .models-toolbar { display: flex; justify-content: space-between; gap: var(--spacing-lg); padding-bottom: var(--spacing-md); border-bottom: 1px solid var(--color-hairline); margin-bottom: var(--spacing-lg); }
    .toolbar-label { font-size: 18px; color: var(--color-ink); }
    .toolbar-count, .toolbar-note { color: var(--color-mute); font-size: 14px; }
    .model-cell { display: flex; align-items: center; gap: 8px; min-width: 0; max-width: 260px; }
    .model-table { table-layout: fixed; width: 100%; min-width: 900px; }
    .model-icon { display: grid; place-items: center; flex: 0 0 28px; width: 28px; height: 28px; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); color: var(--color-ink); font-family: var(--font-mono); font-size: 10px; background: var(--color-canvas-soft); object-fit: contain; }
    /* .model-name is an <a> when the model is addressable, a <div> otherwise; display:block keeps
       the ellipsis working in both cases and the link visually identical to the old plain text. */
    .model-name { display: block; color: var(--color-ink); font-weight: 500; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    a.model-name:hover, a.model-name:focus-visible { text-decoration: underline; }
    .model-table tbody tr { cursor: pointer; }
    .model-table .num { text-align: left; }
    .model-slug { display: inline-block; margin-top: 3px; color: var(--color-mute); font-family: var(--font-mono); font-size: 13px; overflow-wrap: anywhere; }
    .model-author { color: var(--color-body); font-size: 14px; white-space: nowrap; }
    .model-author-link { color: inherit; text-decoration: none; }
    .model-author-link:hover, .model-author-link:focus-visible { text-decoration: underline; }
    .tag-list { display: flex; flex-wrap: wrap; gap: 4px; min-width: 120px; }
    .model-tag { border-color: transparent; }
    .catalog-state { border: 1px solid var(--color-hairline); color: var(--color-body); display: grid; gap: var(--spacing-xs); padding: var(--spacing-xl); }
    .catalog-state strong { color: var(--color-ink); }
    .catalog-state.error { border-color: rgba(255,59,48,.45); }
    .copy-btn { padding: 4px; border: none; background: transparent; color: var(--color-mute); cursor: pointer; border-radius: var(--radius-sm); display: inline-flex; align-items: center; justify-content: center; }
    .copy-btn:hover { background: var(--color-canvas-soft); color: var(--color-ink); }
    @@media (max-width: 820px) { .models-hero, .models-toolbar { display: grid; grid-template-columns: 1fr; } .table-scroll { overflow-x: auto; } }
    @@media (max-width: 520px) { .toolbar-note { display: none; } }
</style>

<script>
    let activeCategory = 'All';

    function setCategory(cat, btn) {
        activeCategory = cat;
        document.querySelectorAll('.filter-pill').forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        applyFilter();
    }

    function filterModels() { applyFilter(); }

    function applyFilter() {
        const q = (document.getElementById('model-search').value || '').toLowerCase();
        const rows = document.querySelectorAll('.model-table tbody tr');
        let visible = 0;
        rows.forEach(row => {
            const name = row.dataset.name || '';
            const id = row.dataset.id || '';
            const provider = row.dataset.provider || '';
            const capability = row.dataset.capability || '';
            const tags = row.dataset.tags || '';
            const textMatch = !q || name.includes(q) || id.includes(q) || tags.includes(q);
            const catMatch = activeCategory === 'All' || provider.includes(activeCategory.toLowerCase())
                || capability.includes(activeCategory.toLowerCase())
                || tags.includes(activeCategory.toLowerCase())
                || name.includes(activeCategory.toLowerCase()) || id.includes(activeCategory.toLowerCase());
            const show = textMatch && catMatch;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        const countEl = document.getElementById('model-count');
        if (countEl) {
            const singularTpl = countEl.getAttribute('data-count-singular') || '{0} model available';
            const pluralTpl = countEl.getAttribute('data-count-plural') || '{0} models available';
            const tpl = visible === 1 ? singularTpl : pluralTpl;
            countEl.textContent = tpl.replace('{0}', visible);
        }
    }

    function copyModelId(event) {
        event.stopPropagation();
        event.preventDefault();
        const btn = event.currentTarget;
        const id = btn.getAttribute('data-model-id');
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(id).then(() => {
                const originalSvg = btn.innerHTML;
                btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                setTimeout(() => btn.innerHTML = originalSvg, 2000);
            }).catch(err => console.error('Failed to copy text: ', err));
        } else {
            const textArea = document.createElement("textarea");
            textArea.value = id;
            textArea.style.position = "fixed";
            textArea.style.left = "-999999px";
            textArea.style.top = "-999999px";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
                const originalSvg = btn.innerHTML;
                btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                setTimeout(() => btn.innerHTML = originalSvg, 2000);
            } catch (err) {
                console.error('Fallback: Oops, unable to copy', err);
            }
            document.body.removeChild(textArea);
        }
    }
</script>
