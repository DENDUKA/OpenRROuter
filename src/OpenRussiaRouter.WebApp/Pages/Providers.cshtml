@page
@model ProvidersModel
@{ ViewData["Title"] = Localizer["Providers_Title"]; }

<div class="providers-page">
    <section class="providers-hero" aria-labelledby="providers-title">
        <div>
            <div class="eyebrow">@Localizer["Providers_Eyebrow"]</div>
            <h1 id="providers-title">@Localizer["Providers_Title"]</h1>
            <p class="providers-lead">@Localizer["Providers_Lead"]</p>
        </div>
    </section>

    <section class="providers-shell" aria-label="@Localizer["Providers_Title"]">
        @if (Model.ErrorMessage != null)
        {
            <div class="catalog-state error" role="alert">
                <strong>@Localizer["Providers_LoadFailedTitle"]</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        }
        else if (Model.Providers.Count == 0)
        {
            <div class="catalog-state">
                <strong>@Localizer["Providers_NoProvidersTitle"]</strong>
            </div>
        }
        else
        {
            <div class="providers-grid">
                @foreach (var p in Model.Providers)
                {
                    <a class="provider-card" href="/providers/@Uri.EscapeDataString(p.Id)">
                        <div class="provider-card-header">
                            <img class="provider-logo" src="@p.LogoUrl" alt="@p.DisplayName" />
                            <div class="provider-info">
                                <h2 class="provider-name">@p.DisplayName</h2>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(p.Description))
                        {
                            <p class="provider-desc">@p.Description</p>
                        }
                    </a>
                }
            </div>
        }
    </section>
</div>

<style>
    .providers-page { width: 100%; }
    .providers-hero { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--spacing-xl); padding-bottom: var(--spacing-2xl); border-bottom: 1px solid var(--color-hairline); }
    .providers-lead { color: var(--color-body); max-width: 620px; font-size: 18px; line-height: 28px; }
    .providers-shell { padding: var(--spacing-xl) 0 var(--spacing-3xl); }
    .providers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--spacing-lg); }
    .provider-card { display: block; border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: var(--spacing-lg); background: var(--color-canvas-card); text-decoration: none; color: inherit; transition: border-color .15s ease; }
    .provider-card:hover { border-color: var(--color-border); }
    .provider-card-header { display: flex; align-items: center; gap: var(--spacing-md); }
    .provider-logo { width: 48px; height: 48px; border-radius: var(--radius-sm); object-fit: contain; border: 1px solid var(--color-hairline); background: var(--color-canvas-soft); }
    .provider-info { display: flex; flex-direction: column; gap: 2px; }
    .provider-name { color: var(--color-ink); font-size: 18px; font-weight: 600; margin: 0; }
    .provider-desc { color: var(--color-body); font-size: 14px; line-height: 22px; margin: var(--spacing-md) 0 0; }
    .catalog-state { border: 1px solid var(--color-hairline); color: var(--color-body); display: grid; gap: var(--spacing-xs); padding: var(--spacing-xl); }
    .catalog-state strong { color: var(--color-ink); }
    .catalog-state.error { border-color: rgba(255,59,48,.45); }
    @@media (max-width: 520px) { .providers-grid { grid-template-columns: 1fr; } }
</style>
