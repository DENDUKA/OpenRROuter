@page "/reset-password"
@model ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; }

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">OPENRUSSIAROUTER</div>
        <div class="auth-title">Reset password</div>
    </div>

    @if (Model.StatusMessage != null)
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <p class="auth-hint">Enter the 6-digit code we emailed to <strong>@Model.Email</strong> and choose a new password.</p>

    <form method="post">
        <input type="hidden" asp-for="Email" />
        <div class="form-group">
            <label asp-for="Code" class="form-label">Reset code</label>
            <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code"
                   maxlength="6" pattern="\d{6}" placeholder="000000" />
            <span asp-validation-for="Code" class="validation-message"></span>
        </div>
        <div class="form-group">
            <label asp-for="NewPassword" class="form-label">New password</label>
            <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="validation-message"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword" class="form-label">Confirm new password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Set new password</button>
    </form>

    <form method="post" asp-page-handler="Resend" class="resend-form">
        <input type="hidden" asp-for="Email" />
        <button type="submit" class="btn btn-secondary w-100">Resend code</button>
    </form>

    <div class="auth-alt"><a href="/login">Back to login</a></div>
</div>

<style>
    .auth-container { max-width: 400px; margin: 0 auto; padding: var(--spacing-section) 0; }
    .auth-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .auth-wordmark { font-size: 16px; font-weight: 500; letter-spacing: 2px; color: var(--color-ink); margin-bottom: var(--spacing-lg); }
    .auth-title { font-size: 38px; font-weight: 400; color: var(--color-ink); }
    .auth-hint { text-align: center; color: var(--color-body-mid); font-size: 14px; margin-bottom: var(--spacing-lg); }
    .form-group { margin-bottom: var(--spacing-lg); }
    .resend-form { margin-top: var(--spacing-md); }
    .auth-alt { text-align: center; margin-top: var(--spacing-lg); color: var(--color-body-mid); font-size: 13px; }
</style>
