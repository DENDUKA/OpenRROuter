@page "/reset-password"
@model ResetPasswordModel
@{ ViewData["Title"] = Localizer["Reset_Title"]; }

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">RAWRTER</div>
        <div class="auth-title">@Localizer["Reset_Title"]</div>
    </div>

    @if (Model.StatusMessage != null)
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <p class="auth-hint">@Localizer["Reset_Hint", Model.Email]</p>
    <p class="auth-spam-note">@Localizer["Reset_CheckSpam"]</p>

    <form method="post">
        <input type="hidden" asp-for="Email" />
        <div class="form-group">
            <label asp-for="Code" class="form-label">@Localizer["Reset_Code"]</label>
            <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code"
                   maxlength="6" pattern="\d{6}" placeholder="000000" />
            <span asp-validation-for="Code" class="validation-message" aria-live="polite"></span>
        </div>
        <div class="form-group">
            <label asp-for="NewPassword" class="form-label">@Localizer["Reset_NewPassword"]</label>
            <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="validation-message" aria-live="polite"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword" class="form-label">@Localizer["Reset_ConfirmPassword"]</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="validation-message" aria-live="polite"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">@Localizer["Reset_Submit"]</button>
    </form>

    <form method="post" asp-page-handler="Resend" class="resend-form">
        <input type="hidden" asp-for="Email" />
        <button type="submit" class="btn btn-secondary w-100">@Localizer["Reset_Resend"]</button>
    </form>

    <div class="auth-alt"><a href="/login">@Localizer["Reset_BackToLogin"]</a></div>
</div>

<style>
    .auth-container { max-width: 400px; margin: 0 auto; padding: var(--spacing-section) 0; }
    .auth-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .auth-wordmark { font-size: 16px; font-weight: 500; letter-spacing: 2px; color: var(--color-ink); margin-bottom: var(--spacing-lg); }
    .auth-title { font-size: 38px; font-weight: 400; color: var(--color-ink); }
    .auth-hint { text-align: center; color: var(--color-body-mid); font-size: 14px; margin-bottom: var(--spacing-md); }
    .auth-spam-note { text-align: center; color: var(--color-body-mid); font-size: 13px; opacity: 0.85; margin-bottom: var(--spacing-lg); }
    .form-group { margin-bottom: var(--spacing-lg); }
    .resend-form { margin-top: var(--spacing-md); }
    .auth-alt { text-align: center; margin-top: var(--spacing-lg); color: var(--color-body-mid); font-size: 13px; }
</style>
