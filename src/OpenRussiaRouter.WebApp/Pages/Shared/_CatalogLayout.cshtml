@{ Layout = "~/Pages/Shared/_Layout.cshtml"; var path = Context.Request.Path.Value ?? ""; string CatNavClass(string href, bool exact = false) { var match = exact ? path.Equals(href, StringComparison.OrdinalIgnoreCase) : path.StartsWith(href, StringComparison.OrdinalIgnoreCase); return match ? "cat-nav-item active" : "cat-nav-item"; } }
