@model string

@*
    Single code block with a Copy button. The click handler `copyCodeBlock`
    is defined globally by _IntegrationExamples.cshtml / _Layout.cshtml.
    The model is the already-resolved code text (placeholders substituted
    by the caller).
*@
<div class="docs-code-panel">
    <button type="button" class="integ-copy" data-copied="@Localizer["Btn_Copied"]" onclick="copyCodeBlock(event)">@Localizer["Btn_Copy"]</button>
    <pre><code>@Model</code></pre>
</div>
