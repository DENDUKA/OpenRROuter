@using OpenRussiaRouter.WebApp.Services.State
@inject OpenRussiaRouter.WebApp.Services.SiteBaseUrlResolver SiteUrlResolver
@inject Microsoft.Extensions.Options.IOptions<OpenRussiaRouter.WebApp.Services.Analytics.AnalyticsOptions> AnalyticsOptions
@{
    var path = Context.Request.Path.Value ?? "";
    var googleTagId = AnalyticsOptions.Value.GoogleTagId;
    var yandexCounterId = AnalyticsOptions.Value.YandexCounterId;
    var hideSidebar = path.StartsWith("/workspace", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);
    var user = User.GetUserSession();

    string TopNavClass(string href, bool exact = false)
    {
        var match = exact
            ? path.Equals(href, StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
        return match ? "topbar-link active" : "topbar-link";
    }

    string SideNavClass(string href, bool exact = false)
    {
        var match = exact
            ? path.Equals(href, StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
        return match ? "nav-item active" : "nav-item";
    }

    var displayName = user?.DisplayName ?? "User";
    var avatarLetter = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";

    // Active display currency for the topbar switcher (mirrors the saved profile choice via cookie).
    var activeCcy = Context.Request.Cookies.TryGetValue("orr_ccy", out var ccy)
        && ccy is "RUB" or "USD" or "EUR" ? ccy : "RUB";
    string CcyBtnClass(string code) => code == activeCcy ? "ccy-btn active" : "ccy-btn";

    // Active UI culture for the language switcher.
    var activeLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string LangBtnClass(string code) => code.Equals(activeLang, StringComparison.OrdinalIgnoreCase)
        ? "ccy-btn active" : "ccy-btn";

    var returnUrlForSwitchers = (path + Context.Request.QueryString).ToString();

    // ViewData["Title"] is often a LocalizedHtmlString (set from the view localizer); string-concat
    // on it prints the type name instead of the text, so render IHtmlContent titles to plain text.
    string? pageTitle = ViewData["Title"]?.ToString();
    if (ViewData["Title"] is Microsoft.AspNetCore.Html.IHtmlContent htmlTitle)
    {
        using var titleWriter = new System.IO.StringWriter();
        htmlTitle.WriteTo(titleWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
        pageTitle = titleWriter.ToString();
    }

    // SEO metadata: self-referencing canonical (no query), noindex for private/service paths and
    // error pages, brand fallback description, Open Graph + Twitter Card.
    var baseUrl = SiteUrlResolver.Resolve(Context.Request);
    var canonicalUrl = ViewData["CanonicalUrl"] as string;
    if (string.IsNullOrWhiteSpace(canonicalUrl))
    {
        canonicalUrl = baseUrl + path;
    }

    string[] noIndexPrefixes =
    [
        "/login", "/signup", "/forgot-password", "/reset-password", "/verify-email",
        "/invite/", "/workspace", "/admin", "/pay/", "/error", "/webhook/",
        "/internal/", "/health", "/metrics", "/.well-known",
    ];
    // ViewData["NoIndex"] lets a page opt out on its own (e.g. a catalog page that resolved to
    // an entity with nothing to show): such pages are deliberately kept out of sitemap.xml, so
    // leaving them indexable would send search engines two contradictory signals.
    var noIndex = ViewData["NoIndex"] is true
        || Context.Response.StatusCode >= 400
        || noIndexPrefixes.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));

    string? metaDescription = null;
    if (ViewData["MetaDescription"] is string md)
        metaDescription = md;
    else if (ViewData["MetaDescription"] is Microsoft.AspNetCore.Html.IHtmlContent htmlMeta)
    {
        using var metaWriter = new System.IO.StringWriter();
        htmlMeta.WriteTo(metaWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
        metaDescription = metaWriter.ToString();
    }
    if (string.IsNullOrWhiteSpace(metaDescription))
    {
        metaDescription = Localizer["Seo_DefaultDescription"].Value;
    }

    var ogTitle = string.IsNullOrEmpty(pageTitle) ? "OpenRussiaRouter" : pageTitle;
    var ogImageUrl = baseUrl + "/og-image.png";
}
<!DOCTYPE html>
<html lang="@activeLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? "OpenRussiaRouter" : pageTitle + " - OpenRussiaRouter")</title>
    <meta name="description" content="@metaDescription" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex,follow" />
    }
    @if (!noIndex)
    {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:url" content="@canonicalUrl" />
    }
    <meta property="og:site_name" content="OpenRussiaRouter" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@ogImageUrl" />
    @if (!noIndex)
    {
        @* Organization + WebSite once per indexable page; pages append their own blocks
           (Product, BreadcrumbList) through ViewData["StructuredData"]. Fully qualified because
           _Layout is shared by areas whose _ViewImports may not pull in Services.Seo. *@
        <script type="application/ld+json">@Html.Raw(OpenRussiaRouter.WebApp.Services.Seo.StructuredData.SiteGraph(baseUrl, activeLang))</script>
        @foreach (var block in (ViewData["StructuredData"] as IEnumerable<string>) ?? [])
        {
            <script type="application/ld+json">@Html.Raw(block)</script>
        }
    }
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(googleTagId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@googleTagId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@googleTagId');
        </script>
    }
    @if (!string.IsNullOrWhiteSpace(yandexCounterId))
    {
        <!-- Yandex.Metrika counter -->
        <script type="text/javascript">
            (function(m,e,t,r,i,k,a){
                m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
                m[i].l=1*new Date();
                for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
                k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
            })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=@yandexCounterId', 'ym');

            ym(@yandexCounterId, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
        </script>
        <noscript><div><img src="https://mc.yandex.ru/watch/@yandexCounterId" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
        <!-- /Yandex.Metrika counter -->
    }
</head>
<body>
<div class="app-shell @(hideSidebar ? "app-shell--no-sidebar" : "")">
    <a class="skip-link" href="#main-content">@Localizer["A11y_SkipToContent"]</a>

    <header class="topbar">
        <a href="/" class="topbar-brand">
            <span class="logo-mark">9R</span>
            <span class="topbar-brand-name">OpenRussiaRouter</span>
        </a>

        <nav class="topbar-nav" aria-label="@Localizer["Sidebar_Product"]">
            <a class="@TopNavClass("/models")" href="/models">@Localizer["Nav_Models"]</a>
            <a class="@TopNavClass("/providers")" href="/providers">@Localizer["Nav_Providers"]</a>
            <a class="@TopNavClass("/tools")" href="/tools">@Localizer["Nav_Tools"]</a>
            <a class="@TopNavClass("/docs")" href="/docs">@Localizer["Nav_SetupGuide"]</a>
            <a class="@TopNavClass("/support")" href="/support">@Localizer["Nav_Support"]</a>
            @if (user?.IsAdmin == true)
            {
                <a class="@TopNavClass("/admin")" href="/admin">@Localizer["Nav_Admin"]</a>
            }
        </nav>

        <div class="topbar-actions">
            @if (user != null)
            {
                <div class="user-menu" id="user-menu">
                    <button class="user-menu-trigger" id="user-menu-trigger"
                            onclick="toggleUserMenu()" aria-expanded="false" aria-haspopup="menu" aria-label="@Localizer["A11y_UserMenu"]">
                        <span class="user-avatar" aria-hidden="true">@avatarLetter</span>
                        <span class="user-display-name">@displayName</span>
                        <svg class="user-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                    <div class="user-dropdown" id="user-dropdown" role="menu" hidden>
                        <a class="dropdown-item" href="/workspace/activity" role="menuitem">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <path d="M2 12V8M6 12V5M10 12V9M14 12V3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                            @Localizer["Nav_Activity"]
                        </a>
                        <a class="dropdown-item" href="/workspace/credits" role="menuitem">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="5" width="20" height="14" rx="2"/>
                                <path d="M2 10h20"/>
                            </svg>
                            @Localizer["Nav_Credits"]
                        </a>
                        <a class="dropdown-item" href="/workspace/apikeys" role="menuitem">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <path d="M2 4h12M2 8h8M2 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                            @Localizer["Nav_ApiKeys"]
                        </a>
                        <a class="dropdown-item" href="/workspace/settings" role="menuitem">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <path d="M8 10a2 2 0 100-4 2 2 0 000 4z" stroke="currentColor" stroke-width="1.5" />
                                <path d="M13.3 6.7l-.9-.2a5.1 5.1 0 00-.4-.9l.5-.8a.6.6 0 00-.1-.8L11.1 3.5a.6.6 0 00-.8-.1l-.8.5a5.1 5.1 0 00-.9-.4l-.2-.9A.6.6 0 008 2H7.4a.6.6 0 00-.6.5l-.2.9a5.1 5.1 0 00-.9.4l-.8-.5a.6.6 0 00-.8.1L3.6 4.7a.6.6 0 00-.1.8l.5.8c-.2.3-.3.6-.4.9l-.9.2A.6.6 0 002 8v.7c0 .3.2.5.5.6l.9.2c.1.3.2.6.4.9l-.5.8a.6.6 0 00.1.8l1.3 1.3c.2.2.6.2.8.1l.8-.5c.3.2.6.3.9.4l.2.9c.1.3.3.5.6.5H8.6c.3 0 .5-.2.6-.5l.2-.9c.3-.1.6-.2.9-.4l.8.5c.2.2.6.1.8-.1l1.3-1.3a.6.6 0 00.1-.8l-.5-.8c.2-.3.3-.6.4-.9l.9-.2c.3-.1.5-.3.5-.6V8a.6.6 0 00-.5-.6z" stroke="currentColor" stroke-width="1.5" />
                            </svg>
                            @Localizer["Nav_Settings"]
                        </a>
                        <div class="dropdown-separator" role="separator"></div>
                        <div class="dropdown-currency" role="group" aria-label="@Localizer["A11y_Currency"]">
                            <span class="dropdown-currency-label">@Localizer["A11y_Currency"]</span>
                            <form method="post" action="/preferences/currency" class="ccy-switch" data-no-loading>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrlForSwitchers" />
                                <button type="submit" name="currency" value="RUB" class="@CcyBtnClass("RUB")" title="@Localizer["Currency_RUB"]">₽</button>
                                <button type="submit" name="currency" value="USD" class="@CcyBtnClass("USD")" title="@Localizer["Currency_USD"]">$</button>
                                <button type="submit" name="currency" value="EUR" class="@CcyBtnClass("EUR")" title="@Localizer["Currency_EUR"]">€</button>
                            </form>
                        </div>
                        <div class="dropdown-language" role="group" aria-label="@Localizer["A11y_Language"]">
                            <span class="dropdown-currency-label">@Localizer["A11y_Language"]</span>
                            <form method="post" action="/preferences/language" class="ccy-switch" data-no-loading>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrlForSwitchers" />
                                <button type="submit" name="culture" value="ru" class="@LangBtnClass("ru")" title="@Localizer["Language_Ru"]">RU</button>
                                <button type="submit" name="culture" value="en" class="@LangBtnClass("en")" title="@Localizer["Language_En"]">EN</button>
                            </form>
                        </div>
                        <div class="dropdown-separator" role="separator"></div>
                        <a class="dropdown-item dropdown-item--danger" href="/logout" role="menuitem">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <path d="M6 14H3a1 1 0 01-1-1V3a1 1 0 011-1h3M10 11l3-3-3-3M13 8H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            @Localizer["Nav_Exit"]
                        </a>
                    </div>
                </div>
            }
            else
            {
                <form method="post" action="/preferences/language" class="lang-switch lang-switch--compact" data-no-loading aria-label="@Localizer["A11y_Language"]">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrlForSwitchers" />
                    <button type="submit" name="culture" value="ru" class="@LangBtnClass("ru")" title="@Localizer["Language_Ru"]">RU</button>
                    <button type="submit" name="culture" value="en" class="@LangBtnClass("en")" title="@Localizer["Language_En"]">EN</button>
                </form>
                <a class="@TopNavClass("/login")" href="/login">@Localizer["Nav_Login"]</a>
            }
        </div>
    </header>

    @if (!hideSidebar)
    {
        <aside class="sidebar">
            @if (user != null)
            {
                <nav class="sidebar-nav" aria-label="@Localizer["Sidebar_Product"]">
                    <div class="nav-section">
                        <div class="nav-section-title">@Localizer["Sidebar_Product"]</div>
                        <a class="@SideNavClass("/", exact: true)" href="/">
                            <span class="nav-icon nav-icon-home" aria-hidden="true"></span>@Localizer["Sidebar_Home"]
                        </a>
                        <a class="@SideNavClass("/models")" href="/models">
                            <span class="nav-icon nav-icon-models" aria-hidden="true"></span>@Localizer["Sidebar_Models"]
                        </a>
                    </div>
                    <div class="nav-section">
                        <div class="nav-section-title">@Localizer["Sidebar_Account"]</div>
                        <a class="@SideNavClass("/workspace/apikeys")" href="/workspace/apikeys">
                            <span class="nav-icon nav-icon-key" aria-hidden="true"></span>@Localizer["Sidebar_ApiKeys"]
                        </a>
                        <a class="@SideNavClass("/workspace/activity")" href="/workspace/activity">
                            <span class="nav-icon nav-icon-usage" aria-hidden="true"></span>@Localizer["Sidebar_Usage"]
                        </a>
                    </div>
                </nav>
            }
            else
            {
                <div class="sidebar-auth">
                    <a href="/login" class="btn btn-primary sidebar-auth-btn">@Localizer["Nav_Login"]</a>
                    <a href="/signup" class="btn btn-outline-primary sidebar-auth-btn">@Localizer["Sidebar_Signup"]</a>
                </div>
            }
        </aside>
    }

    <main class="main-pane" id="main-content" tabindex="-1">
        <article class="content">
            @RenderBody()
        </article>
    </main>
</div>

<footer class="app-footer">
    <div class="app-footer-content">
        <a href="/legal/privacy">@Localizer["Footer_Privacy"]</a>
        <a href="/legal/offer">@Localizer["Footer_Offer"]</a>
        <a href="/support">@Localizer["Nav_Support"]</a>
    </div>
</footer>

    <script>
        function toggleUserMenu() {
            var menu = document.getElementById('user-dropdown');
            var btn = document.getElementById('user-menu-trigger');
            var isHidden = menu.hasAttribute('hidden');
            if (isHidden) {
                menu.removeAttribute('hidden');
                btn.setAttribute('aria-expanded', 'true');
            } else {
                menu.setAttribute('hidden', '');
                btn.setAttribute('aria-expanded', 'false');
            }
        }

        document.addEventListener('click', function(e) {
            var menu = document.getElementById('user-dropdown');
            var btn = document.getElementById('user-menu-trigger');
            if (menu && !menu.hasAttribute('hidden') && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.setAttribute('hidden', '');
                btn.setAttribute('aria-expanded', 'false');
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                var menu = document.getElementById('user-dropdown');
                var btn = document.getElementById('user-menu-trigger');
                if (menu && !menu.hasAttribute('hidden')) {
                    menu.setAttribute('hidden', '');
                    btn.setAttribute('aria-expanded', 'false');
                    btn.focus();
                }
            }
        });

        // Copy text to the clipboard. The async Clipboard API only exists in a secure
        // context (HTTPS or localhost); ORR is served over plain HTTP, so fall back to
        // the legacy execCommand path there. Returns a Promise so callers can show feedback.
        function orrCopyText(text) {
            if (navigator.clipboard && window.isSecureContext) {
                return navigator.clipboard.writeText(text);
            }
            return new Promise(function (resolve, reject) {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.left = '-9999px';
                ta.style.top = '0';
                document.body.appendChild(ta);
                ta.focus();
                ta.select();
                var ok = false;
                try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
                document.body.removeChild(ta);
                ok ? resolve() : reject(new Error('execCommand copy failed'));
            });
        }

        // Copy a model id from any "Copy Model ID" button (used on /models and /admin/models).
        // Both buttons carry a clipboard <svg>, so swap it to a checkmark as confirmation.
        var ORR_COPIED_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        function copyModelId(event) {
            event.preventDefault();
            event.stopPropagation();
            var btn = event.currentTarget;
            var id = btn.getAttribute('data-model-id');
            if (!id) return;
            orrCopyText(id).then(function () {
                var original = btn.innerHTML;
                btn.classList.add('copied');
                btn.innerHTML = ORR_COPIED_SVG;
                setTimeout(function () {
                    btn.innerHTML = original;
                    btn.classList.remove('copied');
                }, 1500);
            }).catch(function (err) { console.error('Copy failed:', err); });
        }

        // Show a loading state on submit buttons so async POSTs give feedback
        // and can't be double-submitted. Skips forms that handle submit themselves.
        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (e.defaultPrevented || form.hasAttribute('data-no-loading')) return;
            var btn = form.querySelector('button[type=submit].btn, input[type=submit].btn');
            if (!btn || btn.disabled) return;
            // Defer so the button's value is still included in the submission.
            setTimeout(function () { btn.classList.add('is-loading'); btn.disabled = true; }, 0);
        });
        // Re-enable when navigating back via the bfcache.
        window.addEventListener('pageshow', function () {
            document.querySelectorAll('.btn.is-loading').forEach(function (b) {
                b.classList.remove('is-loading');
                b.disabled = false;
            });
        });
    </script>
    @{
        // Conversion events set by page models (e.g. signup, email_verified). Fired once per
        // page view into whichever counter is configured; nothing is emitted when the list is
        // empty or no analytics is configured.
        var analyticsEvents = ViewData["AnalyticsEvents"] as IEnumerable<string>;
        var analyticsEventScript = "";
        if (analyticsEvents is { } evts && evts.Any())
        {
            var eventsJson = System.Text.Json.JsonSerializer.Serialize(evts);
            var calls = new List<string>();
            if (!string.IsNullOrWhiteSpace(googleTagId))
                calls.Add("gtag('event', name);");
            if (!string.IsNullOrWhiteSpace(yandexCounterId))
                calls.Add($"ym({yandexCounterId}, 'reachGoal', name);");
            if (calls.Count > 0)
            {
                analyticsEventScript =
                    "<script>(function () { var events = " + eventsJson + "; " +
                    "events.forEach(function (name) { " + string.Join(" ", calls) + " }); })();</script>";
            }
        }
    }
    @Html.Raw(analyticsEventScript)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
