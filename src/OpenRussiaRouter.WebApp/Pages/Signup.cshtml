@page "/signup"
@model SignupModel
@{
    ViewData["Title"] = Localizer["Signup_Title"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
}

<div class="auth-container">
    <div class="auth-header">
        <div class="auth-wordmark">OPENRUSSIAROUTER</div>
        <div class="auth-title">@Localizer["Signup_Title"]</div>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-message" aria-live="polite"></div>
        <div class="form-group">
            <label asp-for="Input.Email" class="form-label">@Localizer["Signup_Email"]</label>
            <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="validation-message" aria-live="polite"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Password" class="form-label">@Localizer["Signup_Password"]</label>
            <div class="input-with-toggle">
                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" id="signup-password" />
                <button type="button" class="password-toggle" onclick="togglePassword('signup-password', this)" aria-label="@Localizer["A11y_ShowPassword"]">
                    <svg class="eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-closed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="validation-message" aria-live="polite"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.ConfirmPassword" class="form-label">@Localizer["Signup_ConfirmPassword"]</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="validation-message" aria-live="polite"></span>
        </div>
        <div class="form-group legal-consent">
            <div class="form-check">
                <input asp-for="Input.AcceptLegal" class="form-check-input" type="checkbox" required />
                <label asp-for="Input.AcceptLegal" class="form-check-label">
                    @Localizer["Consent_Prefix"] <a href="/legal/offer" target="_blank" rel="noopener noreferrer">@Localizer["Consent_OfferLink"]</a> @Localizer["Consent_And"] <a href="/legal/privacy" target="_blank" rel="noopener noreferrer">@Localizer["Consent_PrivacyLink"]</a>.
                </label>
            </div>
            <span asp-validation-for="Input.AcceptLegal" class="validation-message" aria-live="polite"></span>
        </div>
        @if (Model.StartBalanceEnabled)
        {
            <div class="alert alert-info" style="font-size: 13px; margin-bottom: var(--spacing-lg);">
                После подтверждения email вы получите стартовый баланс <strong>$@Model.StartBalanceAmountUsd</strong> для первого тестового запроса.
            </div>
        }
        <button type="submit" id="signup-submit" class="btn btn-primary w-100">@Localizer["Signup_Submit"]</button>
    </form>
    @if (Model.YandexEnabled)
    {
        <div class="auth-divider">@Localizer["Signup_Divider"]</div>
        <form method="post" asp-page-handler="Yandex">
            <button type="submit" class="btn btn-secondary w-100 btn-oauth">
                <img class="oauth-icon" src="/icons/yandex.svg" alt="Yandex" width="20" height="20" />
                @Localizer["Signup_Yandex"]
            </button>
        </form>
    }
    <div class="auth-alt">@Localizer["Signup_AltLogin"] <a href="/login">@Localizer["Signup_LoginLink"]</a></div>
</div>

<style>
    .auth-container { max-width: 400px; margin: 0 auto; padding: var(--spacing-section) 0; }
    .auth-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .auth-wordmark { font-size: 16px; font-weight: 500; letter-spacing: 2px; color: var(--color-ink); margin-bottom: var(--spacing-lg); }
    .auth-title { font-size: 38px; font-weight: 400; color: var(--color-ink); }
    .form-group { margin-bottom: var(--spacing-lg); }
    .auth-alt { text-align: center; margin-top: var(--spacing-lg); color: var(--color-body-mid); font-size: 13px; }
    .btn:disabled { opacity: .5; cursor: not-allowed; }
    .input-with-toggle { position: relative; }
    .input-with-toggle .form-control { padding-right: 44px; }
    .password-toggle {
        position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
        width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
        border: none; background: transparent; color: var(--color-body); cursor: pointer;
        border-radius: var(--radius-sm);
    }
    .password-toggle:hover { color: var(--color-ink); background: var(--color-canvas-mid); }
    .auth-divider { text-align: center; margin: var(--spacing-lg) 0; color: var(--color-body-mid); font-size: 13px; }
    .btn-oauth { display: inline-flex; align-items: center; justify-content: center; gap: 10px; }
    .oauth-icon { flex-shrink: 0; border-radius: 2px; }
</style>

@section Scripts {
<script>
    // Keep the Sign up button disabled until the legal consent box is ticked. The checkbox also
    // carries `required` and the server re-checks AcceptLegal, so no-JS users stay protected too.
    (function () {
        var consent = document.getElementById('Input_AcceptLegal');
        var submit = document.getElementById('signup-submit');
        if (!consent || !submit) return;
        function sync() { submit.disabled = !consent.checked; }
        consent.addEventListener('change', sync);
        sync();
    })();

    function togglePassword(inputId, btn) {
        var input = document.getElementById(inputId);
        var open = btn.querySelector('.eye-open');
        var closed = btn.querySelector('.eye-closed');
        if (input.type === 'password') {
            input.type = 'text'; open.style.display = 'none'; closed.style.display = '';
        } else {
            input.type = 'password'; open.style.display = ''; closed.style.display = 'none';
        }
    }
</script>
}
