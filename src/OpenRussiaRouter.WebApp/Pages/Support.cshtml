@page "/support"
@model SupportModel
@{ ViewData["Title"] = Localizer["Support_Title"]; }

<div class="support-container">
    <div class="support-header">
        <h1 class="support-title">@Localizer["Support_Title"]</h1>
        <p class="support-intro">@Localizer["Support_Intro"]</p>
    </div>

    @if (Model.Sent)
    {
        <div class="alert alert-success" role="alert">
            <strong>@Localizer["Support_SentTitle"]</strong>
            <div>@Localizer["Support_Sent"]</div>
        </div>
        <div class="support-alt"><a href="/support">@Localizer["Support_SendAnother"]</a></div>
    }
    else
    {
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }

        <form method="post" novalidate>
            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">@Localizer["Support_Email"]</label>
                <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="validation-message" aria-live="polite"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Subject" class="form-label">@Localizer["Support_Subject"]</label>
                <input asp-for="Input.Subject" class="form-control" maxlength="200" />
                <span asp-validation-for="Input.Subject" class="validation-message" aria-live="polite"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Message" class="form-label">@Localizer["Support_Message"]</label>
                <textarea asp-for="Input.Message" class="form-control" rows="7" maxlength="5000"></textarea>
                <span asp-validation-for="Input.Message" class="validation-message" aria-live="polite"></span>
            </div>

            @* Honeypot: hidden from humans, tempting to bots. Kept in normal flow but visually
               removed and out of the tab order. A non-empty value => silently dropped server-side. *@
            <div class="support-hp" aria-hidden="true">
                <label for="Input_Website">Website</label>
                <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-primary w-100">@Localizer["Support_Submit"]</button>
        </form>
    }

    @if (Model.TelegramUrl != null)
    {
        <div class="support-telegram">
            <span class="support-telegram-hint">@Localizer["Support_TelegramHint"]</span>
            <a href="@Model.TelegramUrl" class="btn btn-outline-primary w-100" target="_blank" rel="noopener noreferrer">
                @Localizer["Support_Telegram"]
            </a>
        </div>
    }
</div>

<style>
    .support-container { max-width: 520px; margin: 0 auto; padding: var(--spacing-section) 0; }
    .support-header { margin-bottom: var(--spacing-xl); }
    .support-title { font-size: 32px; font-weight: 400; color: var(--color-ink); margin-bottom: var(--spacing-sm); }
    .support-intro { color: var(--color-body-mid); font-size: 15px; }
    .form-group { margin-bottom: var(--spacing-lg); }
    .support-alt { margin-top: var(--spacing-lg); font-size: 14px; }
    .support-telegram { margin-top: var(--spacing-xl); padding-top: var(--spacing-lg); border-top: 1px solid var(--color-border, #e5e5e5); text-align: center; }
    .support-telegram-hint { display: block; color: var(--color-body-mid); font-size: 13px; margin-bottom: var(--spacing-sm); }
    /* Keep the honeypot reachable to bots (not display:none) but invisible to people. */
    .support-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>
