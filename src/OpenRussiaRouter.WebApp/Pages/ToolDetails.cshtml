@page "/tools/{id}"
@model ToolDetailsModel
@{
    var toolSeoName = Model.Tool?.DisplayName ?? Localizer["ToolDetails_Title"].Value;
    ViewData["Title"] = toolSeoName;
    ViewData["MetaDescription"] = string.IsNullOrWhiteSpace(Model.Tagline)
        ? Localizer["MetaDescriptionNoTagline", toolSeoName]
        : Localizer["MetaDescription", toolSeoName, Model.Tagline];
}

<div class="tool-details-page">
    @if (Model.Tool is null)
    {
        <div class="catalog-state error" role="alert">
            <strong>@(Model.ErrorMessage ?? Localizer["ToolDetails_NotFound"].Value)</strong>
            <span><a href="/tools">@Localizer["ToolDetails_BackToList"]</a></span>
        </div>
    }
    else
    {
        <nav class="tool-breadcrumb" aria-label="breadcrumb">
            <a href="/tools">@Localizer["Tools_Title"]</a>
            <span aria-hidden="true">/</span>
            <span>@Model.Tool.DisplayName</span>
        </nav>

        <header class="tool-header">
            <img class="tool-header-logo" src="@Model.LogoUrl" alt="@Model.Tool.DisplayName" />
            <div class="tool-header-body">
                <h1>@Model.Tool.DisplayName</h1>
                @if (!string.IsNullOrEmpty(Model.Tagline))
                {
                    <p class="tool-header-tagline">@Model.Tagline</p>
                }
                <div class="tool-header-meta">
                    @if (Model.CategoryName != null)
                    {
                        <span class="tool-tag">@Model.CategoryName</span>
                    }
                    @foreach (var tag in Model.Tool.Tags ?? [])
                    {
                        <span class="tool-tag">@tag</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.Tool.WebsiteUrl))
                {
                    <p class="tool-header-link">
                        <a href="@Model.Tool.WebsiteUrl" rel="noopener noreferrer nofollow" target="_blank">
                            @Localizer["ToolDetails_Website"]
                        </a>
                    </p>
                }
            </div>
        </header>

        @if (!string.IsNullOrEmpty(Model.DescriptionHtml))
        {
            <section class="tool-section" aria-labelledby="tool-about">
                <h2 id="tool-about">@Localizer["ToolDetails_About"]</h2>
                <div class="markdown-body">@Html.Raw(Model.DescriptionHtml)</div>
            </section>
        }

        @if (!string.IsNullOrEmpty(Model.SetupHtml))
        {
            <section class="tool-section tool-setup" aria-labelledby="tool-setup">
                <h2 id="tool-setup">@Localizer["ToolDetails_HowToConnect"]</h2>
                <div class="markdown-body">@Html.Raw(Model.SetupHtml)</div>
            </section>
        }
    }
</div>

<style>
    .tool-details-page { width: 100%; max-width: 860px; margin: 0 auto; padding-bottom: var(--spacing-3xl); }
    .tool-breadcrumb { display: flex; gap: var(--spacing-sm); align-items: center; font-size: 13px; color: var(--color-body); padding: var(--spacing-lg) 0; }
    .tool-breadcrumb a { color: var(--color-body); text-decoration: none; }
    .tool-breadcrumb a:hover { color: var(--color-ink); }
    .tool-header { display: flex; gap: var(--spacing-lg); align-items: flex-start; padding-bottom: var(--spacing-xl); border-bottom: 1px solid var(--color-hairline); }
    .tool-header-logo { width: 72px; height: 72px; border-radius: var(--radius-md); object-fit: contain; border: 1px solid var(--color-hairline); background: var(--color-canvas-soft); flex-shrink: 0; }
    .tool-header-body h1 { margin: 0 0 6px; font-size: 28px; }
    .tool-header-tagline { margin: 0 0 var(--spacing-md); color: var(--color-body); font-size: 16px; line-height: 24px; }
    .tool-header-meta { display: flex; flex-wrap: wrap; gap: 6px; }
    .tool-tag { font-size: 12px; color: var(--color-body); border: 1px solid var(--color-hairline); border-radius: 999px; padding: 2px 10px; }
    .tool-header-link { margin: var(--spacing-md) 0 0; font-size: 14px; }
    .tool-section { padding-top: var(--spacing-2xl); }
    .tool-section h2 { font-size: 20px; margin: 0 0 var(--spacing-lg); }
    .tool-setup { border-top: 1px solid var(--color-hairline); margin-top: var(--spacing-2xl); }
    .markdown-body { color: var(--color-body); font-size: 15px; line-height: 26px; }
    .markdown-body h1, .markdown-body h2, .markdown-body h3 { color: var(--color-ink); line-height: 1.3; margin: var(--spacing-xl) 0 var(--spacing-md); }
    .markdown-body h1 { font-size: 22px; }
    .markdown-body h2 { font-size: 19px; }
    .markdown-body h3 { font-size: 16px; }
    .markdown-body p { margin: 0 0 var(--spacing-md); }
    .markdown-body ul, .markdown-body ol { margin: 0 0 var(--spacing-md); padding-left: 22px; }
    .markdown-body li { margin-bottom: 6px; }
    .markdown-body a { color: var(--color-ink); }
    .markdown-body code { font-family: var(--font-mono); font-size: 13px; background: var(--color-canvas-mid); padding: 2px 6px; border-radius: var(--radius-sm); }
    .markdown-body pre { background: var(--color-canvas-mid); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: var(--spacing-lg); overflow-x: auto; margin: 0 0 var(--spacing-lg); }
    .markdown-body pre code { background: none; padding: 0; }
    .markdown-body img { max-width: 100%; height: auto; display: block; margin: var(--spacing-lg) 0; border: 1px solid var(--color-hairline); border-radius: var(--radius-md); }
    .markdown-body blockquote { margin: 0 0 var(--spacing-md); padding-left: var(--spacing-lg); border-left: 3px solid var(--color-hairline); color: var(--color-body); }
    .markdown-body table { width: 100%; border-collapse: collapse; margin: 0 0 var(--spacing-lg); font-size: 14px; }
    .markdown-body th, .markdown-body td { border: 1px solid var(--color-hairline); padding: 8px 12px; text-align: left; }
    .catalog-state { border: 1px solid var(--color-hairline); color: var(--color-body); display: grid; gap: var(--spacing-xs); padding: var(--spacing-xl); margin-top: var(--spacing-2xl); }
    .catalog-state strong { color: var(--color-ink); }
    .catalog-state.error { border-color: rgba(255,59,48,.45); }
    @@media (max-width: 600px) {
        .tool-header { flex-direction: column; }
        .tool-header-body h1 { font-size: 24px; }
    }
</style>
