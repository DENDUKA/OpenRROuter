@page
@model Workspace.ActivityModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = Localizer["Nav_Activity"]; }

<div class="ws-section-header">
    <h2>@Localizer["Nav_Activity"]</h2>
    <p class="ws-section-desc">@Localizer["Activity_Desc"]</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="tabs">
    <a class="tab @(Model.Tab == "details" ? "active" : "")" href="/workspace/activity?tab=details">@Localizer["Activity_TabDetails"]</a>
    <a class="tab @(Model.Tab == "overview" ? "active" : "")" href="/workspace/activity?tab=overview">@Localizer["Activity_TabOverview"]</a>
</div>

@if (Model.Tab == "overview")
{
    <div class="act-period-bar">
        <a class="act-period-btn @(Model.Period == "today" ? "act-period-btn--active" : "")" href="@Model.BuildOverviewUrl("today")">@Localizer["Activity_PeriodToday"]</a>
        <a class="act-period-btn @(Model.Period == "24h" ? "act-period-btn--active" : "")" href="@Model.BuildOverviewUrl("24h")">@Localizer["Activity_Period24h"]</a>
        <a class="act-period-btn @(Model.Period == "7d" ? "act-period-btn--active" : "")" href="@Model.BuildOverviewUrl("7d")">@Localizer["Activity_Period7d"]</a>
        <a class="act-period-btn @(Model.Period == "30d" ? "act-period-btn--active" : "")" href="@Model.BuildOverviewUrl("30d")">@Localizer["Activity_Period30d"]</a>
    </div>

    @if (Model.Summary != null)
    {
        <div class="act-stat-row">
            <div class="act-stat-card">
                <div class="act-stat-label">@Localizer["Activity_StatRequests"]</div>
                <div class="act-stat-value">@Model.Summary.TotalRequests.ToString("N0")</div>
            </div>
            <div class="act-stat-card">
                <div class="act-stat-label">@Localizer["Activity_StatInput"]</div>
                <div class="act-stat-value">@Model.Summary.TotalInputTokens.ToString("N0")</div>
            </div>
            <div class="act-stat-card">
                <div class="act-stat-label">@Localizer["Activity_StatOutput"]</div>
                <div class="act-stat-value">@Model.Summary.TotalOutputTokens.ToString("N0")</div>
            </div>
            <div class="act-stat-card">
                <div class="act-stat-label">@Localizer["Activity_StatCost"]</div>
                <div class="act-stat-value">@Model.Summary.TotalCostUsd.ToString("N4") $</div>
            </div>
        </div>

        <div class="ws-panel">
            <div class="ws-panel-header">@Localizer["Activity_ByModel"]</div>
            <div class="ws-panel-body table-scroll" style="padding:0">
                @if (Model.Summary.Models.Count == 0)
                {
                    <p class="text-muted" style="padding:16px">@Localizer["Activity_NoData"]</p>
                }
                else
                {
                    <table class="table act-summary-table">
                        <colgroup>
                            <col class="col-text" /><col class="col-num" /><col class="col-num" /><col class="col-num" /><col class="col-num" /><col class="col-num" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>@Localizer["Activity_Th_Model"]</th><th class="num">@Localizer["Activity_Th_Requests"]</th><th class="num">@Localizer["Activity_Th_Input"]</th><th class="num">@Localizer["Activity_Th_Output"]</th><th class="num">@Localizer["Activity_Th_Cache"]</th><th class="num">@Localizer["Activity_Th_Cost"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Summary.Models)
                            {
                                <tr>
                                    <td><code>@m.ModelId</code></td>
                                    <td class="num">@m.Requests.ToString("N0")</td>
                                    <td class="num">@m.InputTokens.ToString("N0")</td>
                                    <td class="num">@m.OutputTokens.ToString("N0")</td>
                                    <td class="num">@m.CacheTokens.ToString("N0")</td>
                                    <td class="num">@m.CostUsd.ToString("N4") $</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="ws-panel">
            <div class="ws-panel-header">@Localizer["Activity_ByKey"]</div>
            <div class="ws-panel-body table-scroll" style="padding:0">
                @if (Model.Summary.Keys.Count == 0)
                {
                    <p class="text-muted" style="padding:16px">@Localizer["Activity_NoData"]</p>
                }
                else
                {
                    <table class="table act-summary-table">
                        <colgroup>
                            <col class="col-text" /><col class="col-text" /><col class="col-num" /><col class="col-num" /><col class="col-num" /><col class="col-num" /><col class="col-num" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>@Localizer["Activity_Th_KeyName"]</th><th>@Localizer["Activity_Th_Key"]</th><th class="num">@Localizer["Activity_Th_Requests"]</th><th class="num">@Localizer["Activity_Th_Input"]</th><th class="num">@Localizer["Activity_Th_Output"]</th><th class="num">@Localizer["Activity_Th_Cache"]</th><th class="num">@Localizer["Activity_Th_Cost"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var keyNames = Model.ApiKeys.ToDictionary(a => a.Id, a => a.Name); }
                            @foreach (var k in Model.Summary.Keys)
                            {
                                var keyName = keyNames.TryGetValue(k.ApiKeyId, out var name) ? name : k.ApiKeyPrefix;
                                <tr>
                                    <td>@keyName</td>
                                    <td><code>@($"{k.ApiKeyPrefix}***")</code></td>
                                    <td class="num">@k.Requests.ToString("N0")</td>
                                    <td class="num">@k.InputTokens.ToString("N0")</td>
                                    <td class="num">@k.OutputTokens.ToString("N0")</td>
                                    <td class="num">@k.CacheTokens.ToString("N0")</td>
                                    <td class="num">@k.CostUsd.ToString("N4") $</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}
else
{
    <div class="ws-panel">
        <div class="ws-panel-header">@Localizer["Activity_Filters"]</div>
        <div class="ws-panel-body">
            <form method="get" action="/workspace/activity" class="act-filter-form">
                <input type="hidden" name="tab" value="details" />
                <div class="act-filter-row">
                    <div class="act-filter-field">
                        <label class="form-label" for="f-from">@Localizer["Activity_From"]</label>
                        <input type="date" id="f-from" name="from" class="form-control act-filter-date" value="@Model.FromDate" />
                    </div>
                    <div class="act-filter-field">
                        <label class="form-label" for="f-to">@Localizer["Activity_To"]</label>
                        <input type="date" id="f-to" name="to" class="form-control act-filter-date" value="@Model.ToDate" />
                    </div>
                    <div class="act-filter-field act-filter-field--wide">
                        <label class="form-label" for="f-model">@Localizer["Activity_ModelFilter"]</label>
                        <select id="f-model" name="model" class="form-select">
                            <option value="">@Localizer["Activity_AllModels"]</option>
                            @foreach (var m in Model.AvailableModels)
                            {
                                <option value="@m" selected="@(Model.ModelFilter == m ? "selected" : null)">@m</option>
                            }
                        </select>
                    </div>
                    <div class="act-filter-field act-filter-field--wide">
                        <label class="form-label" for="f-key">@Localizer["Activity_KeyFilter"]</label>
                        <select id="f-key" name="key" class="form-select">
                            <option value="">@Localizer["Activity_AllKeys"]</option>
                            @{ var activeKeys = Model.ApiKeys.Where(k => k.DisabledAtUtc == null && !k.IsDeleted).ToList();
                               var disabledKeys = Model.ApiKeys.Where(k => k.DisabledAtUtc != null && !k.IsDeleted).ToList(); }
                            @if (activeKeys.Count > 0)
                            {
                                <optgroup label="@Localizer["Activity_OptGroupActive"]">
                                    @foreach (var k in activeKeys)
                                    {
                                        <option value="@k.Id" selected="@(Model.KeyFilter == k.Id ? "selected" : null)">@($"{k.Prefix}*** — {k.Name}")</option>
                                    }
                                </optgroup>
                            }
                            @if (disabledKeys.Count > 0)
                            {
                                <optgroup label="@Localizer["Activity_OptGroupDisabled"]">
                                    @foreach (var k in disabledKeys)
                                    {
                                        <option value="@k.Id" selected="@(Model.KeyFilter == k.Id ? "selected" : null)">@($"{k.Prefix}*** — {k.Name}")</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="act-filter-actions">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-flex" style="gap:8px">
                            <button type="submit" class="btn btn-primary btn-sm">@Localizer["Activity_Apply"]</button>
                            <a href="/workspace/activity?tab=details" class="btn btn-secondary btn-sm">@Localizer["Activity_Reset"]</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="ws-panel">
        <div class="ws-panel-header">@Localizer["Activity_UsageRecords"]</div>
        <div class="ws-panel-body table-scroll" style="padding:0">
            @if (Model.Activity.Count == 0)
            {
                <p class="text-muted" style="padding:16px">@Localizer["Activity_NoRecords"]</p>
            }
            else
            {
                <table class="table act-usage-table">
                    <colgroup>
                        <col /><col /><col /><col /><col /><col /><col /><col />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>@Localizer["Activity_Th_Date"]</th><th>@Localizer["Activity_Th_Key"]</th><th>@Localizer["Activity_Th_Model"]</th><th class="num">@Localizer["Activity_Th_Input"]</th><th class="num">@Localizer["Activity_Th_Output"]</th><th class="num">@Localizer["Activity_Th_Cache"]</th><th class="num">@Localizer["Activity_Th_Cost"]</th><th>@Localizer["Activity_Th_Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Activity)
                        {
                            <tr>
                                <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td><code>@($"{r.ApiKeyPrefix}***")</code></td>
                                <td><code>@r.ModelId</code></td>
                                <td class="num">@r.InputTokens.ToString("N0")</td>
                                <td class="num">@r.OutputTokens.ToString("N0")</td>
                                <td class="num">@r.CacheTokens.ToString("N0")</td>
                                <td class="num">@r.CostUsd.ToString("N4") $</td>
                                <td>
                                    <span class="badge @(r.Status == "completed" ? "badge-success" : "badge-warning")">@r.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.HasMore && Model.NextCursor != null)
                {
                    <div class="act-pagination">
                        <a class="btn btn-secondary btn-sm" href="@Model.BuildDetailsUrl(Model.NextCursor)">@Localizer["Activity_NextPage"]</a>
                    </div>
                }
            }
        </div>
    </div>
}
