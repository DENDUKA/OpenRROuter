@page
@model Workspace.ActivityModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = "Activity"; }

<div class="ws-section-header">
    <h2>Activity</h2>
    <p class="ws-section-desc">Recent API usage and token consumption.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="ws-panel">
    <div class="ws-panel-header">Recent Usage</div>
    <div class="ws-panel-body">
        @if (Model.Usage.Count == 0)
        {
            <p class="text-muted">No usage records yet.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th><th>Model</th><th>Input</th><th>Output</th><th>Cache</th><th>Cost (RUB)</th><th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Usage)
                    {
                        <tr>
                            <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td><code>@r.ModelId</code></td>
                            <td class="num">@r.InputTokens.ToString("N0")</td>
                            <td class="num">@r.OutputTokens.ToString("N0")</td>
                            <td class="num">@r.CacheTokens.ToString("N0")</td>
                            <td class="num">@r.CostRub.ToString("N4")</td>
                            <td>
                                <span class="badge @(r.Status == "completed" ? "badge-success" : "badge-warning")">@r.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
