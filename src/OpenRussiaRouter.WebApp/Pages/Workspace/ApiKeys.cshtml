@page
@model Workspace.ApiKeysModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = "API Keys"; }

<div class="ws-section-header">
    <h2>API Keys</h2>
    <p class="ws-section-desc">Manage API keys for programmatic access. Keys are shown only once at creation.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.NewKeyValue != null)
{
    <div class="ws-panel">
        <div class="ws-panel-header">New API Key Created</div>
        <div class="ws-panel-body">
            <div class="alert alert-success">
                <strong>Save your key — it won't be shown again!</strong>
                <div class="ws-key-copy-row">
                    <div class="ws-key-preview" id="newKeyValue" data-testid="new-key-value">@Model.NewKeyValue</div>
                    <button type="button" class="btn btn-sm btn-secondary ws-key-copy-btn" data-testid="btn-copy-key"
                            onclick="copyApiKey(this, 'newKeyValue')" title="Copy to clipboard">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                        </svg>
                        <span>Copy</span>
                    </button>
                </div>
            </div>
            <a class="btn btn-primary" href="/workspace/apikeys" data-testid="btn-done-create">Done</a>
        </div>
    </div>

    <script>
        function copyApiKey(btn, elementId) {
            var text = document.getElementById(elementId).textContent.trim();
            navigator.clipboard.writeText(text).then(function () {
                var span = btn.querySelector('span');
                span.textContent = 'Copied!';
                btn.disabled = true;
                setTimeout(function () { span.textContent = 'Copy'; btn.disabled = false; }, 2000);
            });
        }
    </script>
}

@if (Model.Action == "create" && Model.NewKeyValue == null)
{
    <div class="ws-panel">
        <div class="ws-panel-header">New API Key</div>
        <div class="ws-panel-body">
            <form method="post" asp-page-handler="Create">
                <div class="mb-3">
                    <label asp-for="Create.Name" class="form-label" for="kn">Key Name</label>
                    <input asp-for="Create.Name" id="kn" class="form-control" data-testid="input-key-name" />
                    <span asp-validation-for="Create.Name" class="validation-message"></span>
                </div>
                <div class="ws-btn-row">
                    <button type="submit" class="btn btn-primary" data-testid="btn-submit-create">Create</button>
                    <a class="btn btn-secondary" href="/workspace/apikeys">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Action == "rename" && Model.ActionKeyId != null)
{
    <div class="ws-panel">
        <div class="ws-panel-header">Rename API Key</div>
        <div class="ws-panel-body">
            <form method="post" asp-page-handler="Rename">
                <input type="hidden" name="keyId" value="@Model.ActionKeyId" />
                <div class="mb-3">
                    <label asp-for="Rename.Name" class="form-label">New Name</label>
                    <input asp-for="Rename.Name" class="form-control" data-testid="input-rename" />
                    <span asp-validation-for="Rename.Name" class="validation-message"></span>
                </div>
                <div class="ws-btn-row">
                    <button type="submit" class="btn btn-primary" data-testid="btn-save-rename">Save</button>
                    <a class="btn btn-secondary" href="/workspace/apikeys">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

<div class="ws-panel">
    <div class="ws-panel-header ws-panel-header--split">
        <span>Your API Keys</span>
        <a class="btn btn-sm btn-primary" href="?action=create" data-testid="btn-create-key">Create Key</a>
    </div>
    <div class="ws-panel-body">
        @if (Model.Keys.Count == 0)
        {
            <p class="text-muted">No API keys yet. Create one to get started.</p>
        }
        else
        {
            <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th><th>Prefix</th><th>Created</th><th>Last Used</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Keys)
                    {
                        <tr data-testid="key-row" data-key-name="@k.Name">
                            <td data-testid="key-name">@k.Name</td>
                            <td><code>@k.Prefix***</code></td>
                            <td>@k.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>@(k.LastUsedAtUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                            <td>
                                <span class="badge @(k.DisabledAtUtc == null ? "badge-success" : "badge-secondary")" data-testid="key-status">
                                    @(k.DisabledAtUtc == null ? "Active" : "Disabled")
                                </span>
                            </td>
                                <td>
                                  <div class="d-flex gap-2">
                                      @if (k.DisabledAtUtc == null)
                                      {
                                          <form method="post" asp-page-handler="DisableKey">
                                              <input type="hidden" name="keyId" value="@k.Id" />
                                              <button type="submit" class="btn btn-sm btn-outline-warning">Disable</button>
                                          </form>
                                      }
                                      else
                                      {
                                          <form method="post" asp-page-handler="EnableKey">
                                              <input type="hidden" name="keyId" value="@k.Id" />
                                              <button type="submit" class="btn btn-sm btn-outline-success">Enable</button>
                                          </form>
                                      }
                                      
                                      <form method="post" asp-page-handler="Delete" style="display:inline">
                                          <input type="hidden" name="keyId" value="@k.Id" />
                                          <button type="submit" class="btn-icon btn-icon-danger" title="Delete" aria-label="Delete"
                                                  data-testid="btn-delete"
                                                  onclick="return confirm('Remove key &quot;@k.Name&quot; from the list? This cannot be undone.')">
                                              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                  <line x1="18" y1="6" x2="6" y2="18"/>
                                                  <line x1="6" y1="6" x2="18" y2="18"/>
                                              </svg>
                                          </button>
                                      </form>
                                  </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>
