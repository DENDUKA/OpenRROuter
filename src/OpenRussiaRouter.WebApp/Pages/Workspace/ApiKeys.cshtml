@page
@model Workspace.ApiKeysModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = "API Keys"; }

<div class="ws-section-header">
    <h2>API Keys</h2>
    <p class="ws-section-desc">Manage API keys for programmatic access. Keys are shown only once at creation.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.NewKeyValue != null)
{
    <div class="ws-panel">
        <div class="ws-panel-header">New API Key Created</div>
        <div class="ws-panel-body">
            <div class="alert alert-success">
                <strong>Save your key — it won't be shown again!</strong>
                <div class="ws-key-copy-row">
                    <div class="ws-key-preview" id="newKeyValue" data-testid="new-key-value">@Model.NewKeyValue</div>
                    <button type="button" class="btn btn-sm btn-secondary ws-key-copy-btn" data-testid="btn-copy-key"
                            onclick="copyApiKey(this, 'newKeyValue')" title="Copy to clipboard">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                        </svg>
                        <span>Copy</span>
                    </button>
                </div>
            </div>
            <a class="btn btn-primary" href="/workspace/apikeys" data-testid="btn-done-create">Done</a>
        </div>
    </div>

    <script>
        function copyApiKey(btn, elementId) {
            var text = document.getElementById(elementId).textContent.trim();
            // orrCopyText is defined globally in _Layout.cshtml (HTTP-safe fallback).
            orrCopyText(text).then(function () {
                var span = btn.querySelector('span');
                span.textContent = 'Copied!';
                btn.disabled = true;
                setTimeout(function () { span.textContent = 'Copy'; btn.disabled = false; }, 2000);
            }).catch(function (err) { console.error('Copy failed:', err); });
        }
    </script>
}

@if (Model.Action == "create" && Model.NewKeyValue == null)
{
    <div class="ws-panel">
        <div class="ws-panel-header">New API Key</div>
        <div class="ws-panel-body">
            <form method="post" asp-page-handler="Create">
                <div class="mb-3">
                    <label asp-for="Create.Name" class="form-label" for="kn">Key Name</label>
                    <input asp-for="Create.Name" id="kn" class="form-control" data-testid="input-key-name" />
                    <span asp-validation-for="Create.Name" class="validation-message"></span>
                </div>
                <div class="ws-btn-row">
                    <button type="submit" class="btn btn-primary" data-testid="btn-submit-create">Create</button>
                    <a class="btn btn-secondary" href="/workspace/apikeys">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Action == "rename" && Model.ActionKeyId != null)
{
    <div class="ws-panel">
        <div class="ws-panel-header">Rename API Key</div>
        <div class="ws-panel-body">
            <form method="post" asp-page-handler="Rename">
                <input type="hidden" name="keyId" value="@Model.ActionKeyId" />
                <div class="mb-3">
                    <label asp-for="Rename.Name" class="form-label">New Name</label>
                    <input asp-for="Rename.Name" class="form-control" data-testid="input-rename" />
                    <span asp-validation-for="Rename.Name" class="validation-message"></span>
                </div>
                <div class="ws-btn-row">
                    <button type="submit" class="btn btn-primary" data-testid="btn-save-rename">Save</button>
                    <a class="btn btn-secondary" href="/workspace/apikeys">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

<div class="ws-panel">
    <div class="ws-panel-header ws-panel-header--split">
        <span>Your API Keys</span>
        <a class="btn btn-sm btn-primary" href="?action=create" data-testid="btn-create-key">Create Key</a>
    </div>
    <div class="ws-panel-body">
        @if (Model.Keys.Count == 0)
        {
            <p class="text-muted">No API keys yet. Create one to get started.</p>
        }
        else
        {
            <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th><th>Prefix</th><th>Created</th><th>Last Used</th><th>Status</th><th>Daily Limit</th><th>Weekly Limit</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Keys)
                    {
                        <tr data-testid="key-row" data-key-name="@k.Name">
                            <td data-testid="key-name">@k.Name</td>
                            <td><code>@k.Prefix***</code></td>
                            <td>@k.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>@(k.LastUsedAtUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                            <td>
                                <span class="badge @(k.DisabledAtUtc == null ? "badge-success" : "badge-secondary")" data-testid="key-status">
                                    @(k.DisabledAtUtc == null ? "Active" : "Disabled")
                                </span>
                            </td>
                            <td>
                                <div class="ws-limit-cell">@Model.FormatDailyLimit(k)</div>
                                @if (Model.HasDailyLimit(k))
                                {
                                    var dailyPercent = Model.DailyRemainingPercent(k);
                                    <div class="ws-limit-progress" role="progressbar" aria-label="Daily limit remaining" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@dailyPercent">
                                        <div class="ws-limit-progress-bar @(dailyPercent == 0 ? "is-empty" : "")" style="width: @dailyPercent%"></div>
                                    </div>
                                    <div class="ws-limit-percent">@dailyPercent% left</div>
                                }
                                @if (Model.IsDailyLimitReached(k))
                                {
                                    <span class="badge badge-warning">Limit reached</span>
                                }
                            </td>
                            <td>
                                <div class="ws-limit-cell">@Model.FormatWeeklyLimit(k)</div>
                                @if (Model.HasWeeklyLimit(k))
                                {
                                    var weeklyPercent = Model.WeeklyRemainingPercent(k);
                                    <div class="ws-limit-progress" role="progressbar" aria-label="Weekly limit remaining" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@weeklyPercent">
                                        <div class="ws-limit-progress-bar @(weeklyPercent == 0 ? "is-empty" : "")" style="width: @weeklyPercent%"></div>
                                    </div>
                                    <div class="ws-limit-percent">@weeklyPercent% left</div>
                                }
                                @if (Model.IsWeeklyLimitReached(k))
                                {
                                    <span class="badge badge-warning">Limit reached</span>
                                }
                            </td>
                                <td>
                                  <div class="d-flex gap-2">
                                      <a class="btn btn-sm btn-outline-primary ws-toggle-btn" href="/workspace/apikeys/limits?keyId=@Uri.EscapeDataString(k.Id)">Limits</a>

                                      @if (k.DisabledAtUtc == null)
                                      {
                                          <form method="post" asp-page-handler="DisableKey" onsubmit="orrToggleSubmitting(this)">
                                              <input type="hidden" name="keyId" value="@k.Id" />
                                              <button type="submit" class="btn btn-sm btn-outline-warning ws-toggle-btn">Disable</button>
                                          </form>
                                      }
                                      else
                                      {
                                          <form method="post" asp-page-handler="EnableKey" onsubmit="orrToggleSubmitting(this)">
                                              <input type="hidden" name="keyId" value="@k.Id" />
                                              <button type="submit" class="btn btn-sm btn-outline-success ws-toggle-btn">Enable</button>
                                          </form>

                                          <form method="post" asp-page-handler="Delete" style="display:inline">
                                              <input type="hidden" name="keyId" value="@k.Id" />
                                              <button type="submit" class="btn btn-sm btn-outline-danger ws-toggle-btn" title="Delete" aria-label="Delete"
                                                      data-testid="btn-delete"
                                                      onclick="return confirm('Remove key &quot;@k.Name&quot; from the list? This cannot be undone.')">
                                                  Delete
                                              </button>
                                          </form>
                                      }
                                  </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>

<style>
    /* Фиксированная ширина — Enable/Disable не прыгают при смене статуса и во время сабмита */
    .ws-toggle-btn {
        min-width: 84px;
        text-align: center;
    }
    .ws-toggle-btn[disabled] {
        opacity: 0.65;
        cursor: progress;
    }
    .ws-limit-cell {
        min-width: 160px;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }
    .ws-limit-progress {
        width: 160px;
        height: 6px;
        margin-top: 6px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(148, 163, 184, .22);
    }
    .ws-limit-progress-bar {
        height: 100%;
        min-width: 2px;
        border-radius: inherit;
        background: var(--color-success);
    }
    .ws-limit-progress-bar.is-empty {
        min-width: 0;
        background: var(--color-warning);
    }
    .ws-limit-percent {
        margin-top: 2px;
        color: var(--color-text-muted);
        font-size: .78rem;
        font-variant-numeric: tabular-nums;
    }
</style>

<script>
    function orrToggleSubmitting(form) {
        var btn = form.querySelector('button[type="submit"]');
        if (!btn) return;
        // Зафиксировать текущую ширину, чтобы текст "…" не менял габариты
        btn.style.width = btn.offsetWidth + 'px';
        btn.disabled = true;
        btn.textContent = '…';
    }
</script>
