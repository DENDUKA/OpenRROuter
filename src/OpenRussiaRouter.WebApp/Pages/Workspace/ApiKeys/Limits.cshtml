@page
@model Workspace.ApiKeys.LimitsModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = Localizer["Limits_Title"]; }

<div class="ws-section-header">
    <h2>@Localizer["Limits_Title"]</h2>
    <p class="ws-section-desc">@Localizer["Limits_Desc"]</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Key != null)
{
    <div class="ws-panel">
        <div class="ws-panel-header">@Localizer["Limits_Header", Model.Key.Name]</div>
        <div class="ws-panel-body">
            <div class="mb-3">
                <div class="text-muted">@Localizer["Limits_PrefixLabel"]</div>
                <code>@Model.Key.Prefix***</code>
            </div>

            <form method="post" asp-page-handler="Save">
                <input type="hidden" asp-for="Form.ApiKeyId" />

                <div class="mb-3">
                    <label asp-for="Form.DailyLimitUsd" class="form-label">@Localizer["Limits_DailyLabel"]</label>
                    <input asp-for="Form.DailyLimitUsd" class="form-control" type="number" min="0" step="0.000001" />
                    <span asp-validation-for="Form.DailyLimitUsd" class="validation-message"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.WeeklyLimitUsd" class="form-label">@Localizer["Limits_WeeklyLabel"]</label>
                    <input asp-for="Form.WeeklyLimitUsd" class="form-control" type="number" min="0" step="0.000001" />
                    <span asp-validation-for="Form.WeeklyLimitUsd" class="validation-message"></span>
                </div>

                <div class="ws-btn-row">
                    <button type="submit" class="btn btn-primary">@Localizer["ApiKeys_Save"]</button>
                    <a class="btn btn-secondary" href="/workspace/apikeys">@Localizer["ApiKeys_Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <a class="btn btn-secondary" href="/workspace/apikeys">@Localizer["Limits_Back"]</a>
}

