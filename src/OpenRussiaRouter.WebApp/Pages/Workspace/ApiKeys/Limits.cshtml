@page
@model Workspace.ApiKeys.LimitsModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = "API Key Limits"; }

<div class="ws-section-header">
    <h2>API Key Limits</h2>
    <p class="ws-section-desc">Set daily and weekly spend limits for this API key. Empty fields disable the limit.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Key != null)
{
    <div class="ws-panel">
        <div class="ws-panel-header">Limits for @Model.Key.Name</div>
        <div class="ws-panel-body">
            <div class="mb-3">
                <div class="text-muted">Prefix</div>
                <code>@Model.Key.Prefix***</code>
            </div>

            <form method="post" asp-page-handler="Save">
                <input type="hidden" asp-for="Form.ApiKeyId" />

                <div class="mb-3">
                    <label asp-for="Form.DailyLimitUsd" class="form-label">Daily limit, USD</label>
                    <input asp-for="Form.DailyLimitUsd" class="form-control" type="number" min="0" step="0.000001" />
                    <span asp-validation-for="Form.DailyLimitUsd" class="validation-message"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.WeeklyLimitUsd" class="form-label">Weekly limit, USD</label>
                    <input asp-for="Form.WeeklyLimitUsd" class="form-control" type="number" min="0" step="0.000001" />
                    <span asp-validation-for="Form.WeeklyLimitUsd" class="validation-message"></span>
                </div>

                <div class="ws-btn-row">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a class="btn btn-secondary" href="/workspace/apikeys">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <a class="btn btn-secondary" href="/workspace/apikeys">Back to API Keys</a>
}

