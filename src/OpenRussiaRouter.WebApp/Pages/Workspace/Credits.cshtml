@page
@model Workspace.CreditsModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = Localizer["WsNav_Credits"]; }

<div class="ws-section-header">
    <h2>@Localizer["WsNav_Credits"]</h2>
    <p class="ws-section-desc">@Localizer["Credits_Desc"]</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Credits_BalanceHeader"]</div>
    <div class="ws-panel-body">
        @if (Model.Balance == null)
        {
            <p class="text-muted">@Localizer["Credits_BalanceUnavailable"]</p>
        }
        else
        {
            <div class="ws-balance-amount">
                @Model.FormatAmount(Model.Balance.Amount)
            </div>
        }
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Credits_TopUpHeader"]</div>
    <div class="ws-panel-body">
        @if (Model.FirstTopUpBonusAvailable)
        {
            <div class="alert alert-info" style="font-size: 13px; margin-bottom: var(--spacing-md);">
                Первое пополнение получает бонус <strong>+@Model.FirstTopUpBonusPercent%</strong> к сумме.
            </div>
        }
        <form method="post" asp-page-handler="TopUp">
            <div class="mb-3 d-flex gap-2 align-items-end">
                <div>
                    <label class="form-label" asp-for="TopUpAmountRaw">@Localizer["Credits_AmountLabel"]</label>
                    @* TS-010: bind the raw form string so we can parse under InvariantCulture.
                       The default decimal binder would honor the request culture and mis-parse
                       "10.50" as 1050 under "ru". *@
                    <input type="text" name="TopUpAmount" id="TopUpAmountRaw" class="form-control"
                           inputmode="decimal" autocomplete="off" placeholder="0.00" required style="width: 160px;" />
                </div>
                <div>
                    <label class="form-label" asp-for="SelectedCurrency">@Localizer["Credits_CurrencyLabel"]</label>
                    <select asp-for="SelectedCurrency" class="form-select" style="width: 100px;">
                        <option value="RUB">RUB</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">@Localizer["Credits_TopUpSubmit"]</button>
                </div>
            </div>
            <div class="form-group legal-consent">
                <div class="form-check">
                    <input asp-for="AcceptLegal" class="form-check-input" type="checkbox" required />
                    <label asp-for="AcceptLegal" class="form-check-label">
                        @Localizer["Consent_Prefix"] <a href="/legal/offer" target="_blank" rel="noopener noreferrer">@Localizer["Consent_OfferLink"]</a> @Localizer["Consent_And"] <a href="/legal/privacy" target="_blank" rel="noopener noreferrer">@Localizer["Consent_PrivacyLink"]</a>.
                    </label>
                </div>
                <span asp-validation-for="AcceptLegal" class="validation-message"></span>
            </div>
            <p class="text-muted" style="font-size: 13px;">@Localizer["Credits_MinTopUp", Model.MinTopUpUsd.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)]</p>
        </form>
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Credits_HistoryHeader"]</div>
    <div class="ws-panel-body">
        @if (Model.TopUps.Count == 0)
        {
            <p class="text-muted">@Localizer["Credits_NoTopUps"]</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>@Localizer["Credits_Th_Date"]</th>
                        <th>@Localizer["Credits_Th_Amount"]</th>
                        <th>@Localizer["Credits_Th_Reason"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var topUp in Model.TopUps)
                    {
                        <tr>
                            <td>@topUp.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>@Model.FormatAmount(topUp.Amount)</td>
                            <td>@topUp.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
