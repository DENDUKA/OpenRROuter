@page
@model Workspace.CreditsModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = "Credits"; }

<div class="ws-section-header">
    <h2>Credits</h2>
    <p class="ws-section-desc">Your current balance used for API request billing.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="ws-panel">
    <div class="ws-panel-header">Current Balance</div>
    <div class="ws-panel-body">
        @if (Model.Balance == null)
        {
            <p class="text-muted">Unable to load balance.</p>
        }
        else
        {
            <div class="ws-balance-amount">
                @Model.FormatAmount(Model.Balance.Amount)
            </div>
        }
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">Top Up</div>
    <div class="ws-panel-body">
        <form method="post" asp-page-handler="TopUp">
            <div class="mb-3 d-flex gap-2 align-items-end">
                <div>
                    <label class="form-label" asp-for="TopUpAmount">Amount</label>
                    <input type="number" asp-for="TopUpAmount" class="form-control"
                           min="0.01" step="0.01" placeholder="0.00" required style="width: 160px;" />
                </div>
                <div>
                    <label class="form-label" asp-for="SelectedCurrency">Currency</label>
                    <select asp-for="SelectedCurrency" class="form-select" style="width: 100px;">
                        <option value="RUB">RUB</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">Top Up</button>
                </div>
            </div>
            <div class="form-group legal-consent">
                <div class="form-check">
                    <input asp-for="AcceptLegal" class="form-check-input" type="checkbox" required />
                    <label asp-for="AcceptLegal" class="form-check-label">
                        Я принимаю <a href="/legal/offer" target="_blank" rel="noopener noreferrer">Публичную оферту</a> и <a href="/legal/privacy" target="_blank" rel="noopener noreferrer">Политику конфиденциальности</a>.
                    </label>
                </div>
                <span asp-validation-for="AcceptLegal" class="validation-message"></span>
            </div>
            <p class="text-muted" style="font-size: 13px;">Minimum: $@Model.MinTopUpUsd USD. Authoritative limit enforced server-side.</p>
        </form>
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">Top-Up History</div>
    <div class="ws-panel-body">
        @if (Model.TopUps.Count == 0)
        {
            <p class="text-muted">No top-ups yet.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var topUp in Model.TopUps)
                    {
                        <tr>
                            <td>@topUp.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>@Model.FormatAmount(topUp.Amount)</td>
                            <td>@topUp.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
