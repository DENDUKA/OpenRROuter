@page
@model Workspace.CreditsModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = Localizer["WsNav_Credits"]; }

<div class="ws-section-header">
    <h2>@Localizer["WsNav_Credits"]</h2>
    <p class="ws-section-desc">@Localizer["Credits_Desc"]</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Credits_BalanceHeader"]</div>
    <div class="ws-panel-body">
        @if (Model.Balance == null)
        {
            <p class="text-muted">@Localizer["Credits_BalanceUnavailable"]</p>
        }
        else
        {
            <div class="ws-balance-amount">
                @Model.FormatAmount(Model.Balance.Amount)
            </div>
        }
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Credits_TopUpHeader"]</div>
    <div class="ws-panel-body">
        @if (Model.FirstTopUpBonusAvailable)
        {
            <div class="alert alert-info ws-topup-bonus">
                Первое пополнение получает бонус <strong>+@Model.FirstTopUpBonusPercent%</strong> к сумме.
            </div>
        }
        <form method="post" asp-page-handler="TopUp" class="ws-topup-form">
            <div class="ws-topup-fields">
                <div class="ws-topup-field ws-topup-field--amount">
                    <label class="form-label" asp-for="TopUpAmountRaw">@Localizer["Credits_AmountLabel"]</label>
                    @* TS-010: bind the raw form string so we can parse under InvariantCulture.
                       The default decimal binder would honor the request culture and mis-parse
                       "10.50" as 1050 under "ru". *@
                    <input type="text" name="TopUpAmount" id="TopUpAmountRaw" class="form-control"
                           inputmode="decimal" autocomplete="off" placeholder="0.00" required />
                </div>
                <div class="ws-topup-field ws-topup-field--currency">
                    <label class="form-label" asp-for="SelectedCurrency">@Localizer["Credits_CurrencyLabel"]</label>
                    <select asp-for="SelectedCurrency" class="form-select">
                        <option value="RUB">RUB</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </select>
                </div>
            </div>
            <div class="form-group legal-consent">
                <div class="form-check">
                    <input asp-for="AcceptLegal" class="form-check-input" type="checkbox" required />
                    <label asp-for="AcceptLegal" class="form-check-label">
                        @Localizer["Consent_Prefix"] <a href="/legal/offer" target="_blank" rel="noopener noreferrer">@Localizer["Consent_OfferLink"]</a> @Localizer["Consent_And"] <a href="/legal/privacy" target="_blank" rel="noopener noreferrer">@Localizer["Consent_PrivacyLink"]</a>.
                    </label>
                </div>
                <span asp-validation-for="AcceptLegal" class="validation-message"></span>
            </div>
            @* Both checkout buttons live in one row inside the form: the Yandex Pay one is
               type="button" and posts its own JSON, so it never submits this form. *@
            <div class="ws-topup-actions">
                @if (Model.IsAdmin && Model.YandexPayEnabled)
                {
                    <button type="button" class="btn-yapay" id="yandexPayBtn" data-goal="checkout_started"
                            title="Оплатить через Yandex Pay" aria-label="Оплатить через Yandex Pay"
                            onclick="yandexPayCheckout()">
                        <img class="btn-yapay-logo" src="~/icons/yandex-pay.png" alt="Yandex Pay" width="90" height="30" />
                        <span class="btn-yapay-status" hidden>Создание платежа…</span>
                    </button>
                }
                <button type="submit" class="btn btn-primary" data-goal="checkout_started">@Localizer["Credits_TopUpSubmit"]</button>
            </div>
            @* Show the limit in the user's own currency first: it is enforced in USD, so someone
               typing rubles cannot tell from "$1.00" that 50 ₽ will bounce. *@
            <p class="ws-topup-hint">@Localizer["Credits_MinTopUp", Model.FormatAmount(Model.MinTopUpUsd), Model.MinTopUpUsd.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)]</p>
        </form>

        @if (Model.IsAdmin && Model.YandexPayEnabled)
        {
            @* _WorkspaceLayout has no Scripts section — the Yandex Pay script has to be inline. *@
            <script>
                function yandexPayCheckout() {
                    var btn = document.getElementById('yandexPayBtn');
                    var status = btn.querySelector('.btn-yapay-status');
                    var amountInput = document.getElementById('TopUpAmountRaw');
                    var currencySelect = document.getElementById('SelectedCurrency');
                    var consent = document.getElementById('AcceptLegal');
                    var amount = parseFloat((amountInput.value || '').replace(',', '.'));
                    var currency = currencySelect ? currencySelect.value : 'RUB';
                    if (!amount || amount <= 0) { alert('Введите сумму'); return; }
                    // type="button" skips the form's native validation, so the consent checkbox
                    // has to be enforced here — otherwise the checkout would post legalConsent
                    // without the user ever ticking it.
                    if (!consent || !consent.checked) {
                        if (consent && typeof consent.reportValidity === 'function') { consent.reportValidity(); }
                        else { alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_AcceptLegal"].Value))); }
                        if (consent) { consent.focus(); }
                        return;
                    }
                    function setBusy(busy) {
                        btn.disabled = busy;
                        btn.dataset.busy = busy ? 'true' : 'false';
                        status.hidden = !busy;
                    }
                    setBusy(true);
                    fetch('/workspace/credits/yandexpay/checkout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ amount: amount, currency: currency, legalConsent: consent.checked })
                    }).then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
                    .then(function(res) {
                        if (res.ok && res.data.payUrl) { window.location.href = res.data.payUrl; }
                        else { alert(res.data.detail || res.data.error || 'Ошибка создания платежа'); setBusy(false); }
                    }).catch(function() {
                        alert('Сетевая ошибка'); setBusy(false);
                    });
                }
            </script>
        }
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Credits_HistoryHeader"]</div>
    <div class="ws-panel-body">
        @if (Model.TopUps.Count == 0)
        {
            <p class="text-muted">@Localizer["Credits_NoTopUps"]</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@Localizer["Credits_Th_Date"]</th>
                            <th>@Localizer["Credits_Th_Amount"]</th>
                            <th>@Localizer["Credits_Th_Reason"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var topUp in Model.TopUps)
                        {
                            <tr>
                                <td>@topUp.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                <td>@Model.FormatAmount(topUp.Amount)</td>
                                <td>@topUp.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
