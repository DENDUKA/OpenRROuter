@page
@model Workspace.SettingsModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = Localizer["Nav_Settings"]; }

<div class="ws-section-header">
    <h2>@Localizer["Nav_Settings"]</h2>
    <p class="ws-section-desc">@Localizer["Settings_Desc"]</p>
</div>

@if (Model.SaveMessage != null)
{
    <div class="alert alert-success">@Model.SaveMessage</div>
}
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Settings_AccountHeader"]</div>
    <div class="ws-panel-body">
        <div class="ws-info-row">
            <span class="ws-info-label">@Localizer["Settings_DisplayName"]</span>
            <span>@(Model.CurrentUser?.DisplayName ?? Localizer["Settings_Empty"].Value)</span>
        </div>
        <div class="ws-info-row">
            <span class="ws-info-label">@Localizer["Settings_UserId"]</span>
            <code>@(Model.CurrentUser?.UserId ?? Localizer["Settings_Empty"].Value)</code>
        </div>
        <div class="ws-info-row">
            <span class="ws-info-label">@Localizer["Settings_Role"]</span>
            <span>@(Model.CurrentUser?.Role ?? Localizer["Settings_Empty"].Value)</span>
        </div>
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Settings_DisplayPrefHeader"]</div>
    <div class="ws-panel-body">
        <form method="post" asp-page-handler="SaveCurrency">
            <div class="mb-3">
                <label class="form-label" asp-for="SelectedCurrency">@Localizer["Settings_CurrencyLabel"]</label>
                <select asp-for="SelectedCurrency" class="form-select" style="max-width: 260px;">
                    <option value="RUB">@Localizer["Currency_RUB"]</option>
                    <option value="USD">@Localizer["Currency_USD"]</option>
                    <option value="EUR">@Localizer["Currency_EUR"]</option>
                </select>
                <div class="text-muted mt-1" style="font-size: 13px;">@Localizer["Settings_CurrencyHelp"]</div>
            </div>
            <button type="submit" class="btn btn-primary">@Localizer["ApiKeys_Save"]</button>
        </form>
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">@Localizer["Settings_ChangePasswordHeader"]</div>
    <div class="ws-panel-body">
        @if (Model.PasswordMessage != null)
        {
            <div class="alert alert-success">@Model.PasswordMessage</div>
        }
        @if (Model.PasswordErrorMessage != null)
        {
            <div class="alert alert-danger">@Model.PasswordErrorMessage</div>
        }
        <form method="post" asp-page-handler="ChangePassword" style="max-width: 420px;">
            <div class="mb-3">
                <label class="form-label" asp-for="PasswordInput.CurrentPassword">@Localizer["Settings_CurrentPassword"]</label>
                <input asp-for="PasswordInput.CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                <span asp-validation-for="PasswordInput.CurrentPassword" class="validation-message" aria-live="polite"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="PasswordInput.NewPassword">@Localizer["Settings_NewPassword"]</label>
                <input asp-for="PasswordInput.NewPassword" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="PasswordInput.NewPassword" class="validation-message" aria-live="polite"></span>
                <div class="text-muted mt-1" style="font-size: 13px;">@Localizer["Settings_PasswordHelp"]</div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="PasswordInput.ConfirmNewPassword">@Localizer["Settings_ConfirmNewPassword"]</label>
                <input asp-for="PasswordInput.ConfirmNewPassword" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="PasswordInput.ConfirmNewPassword" class="validation-message" aria-live="polite"></span>
            </div>
            <button type="submit" class="btn btn-primary">@Localizer["Settings_ChangePasswordSubmit"]</button>
        </form>
    </div>
</div>
