@page
@model Workspace.SettingsModel
@{ Layout = "~/Pages/Shared/_WorkspaceLayout.cshtml"; ViewData["Title"] = "Settings"; }

<div class="ws-section-header">
    <h2>Settings</h2>
    <p class="ws-section-desc">Account information and preferences.</p>
</div>

@if (Model.SaveMessage != null)
{
    <div class="alert alert-success">@Model.SaveMessage</div>
}
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="ws-panel">
    <div class="ws-panel-header">Account</div>
    <div class="ws-panel-body">
        <div class="ws-info-row">
            <span class="ws-info-label">Display Name</span>
            <span>@(Model.CurrentUser?.DisplayName ?? "—")</span>
        </div>
        <div class="ws-info-row">
            <span class="ws-info-label">User ID</span>
            <code>@(Model.CurrentUser?.UserId ?? "—")</code>
        </div>
        <div class="ws-info-row">
            <span class="ws-info-label">Role</span>
            <span>@(Model.CurrentUser?.Role ?? "—")</span>
        </div>
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">Display Preferences</div>
    <div class="ws-panel-body">
        <form method="post" asp-page-handler="SaveCurrency">
            <div class="mb-3">
                <label class="form-label" asp-for="SelectedCurrency">Display Currency</label>
                <select asp-for="SelectedCurrency" class="form-select" style="max-width: 260px;">
                    <option value="RUB">RUB — Russian Ruble</option>
                    <option value="USD">USD — US Dollar</option>
                    <option value="EUR">EUR — Euro</option>
                </select>
                <div class="text-muted mt-1" style="font-size: 13px;">Balance, prices, and history will be shown in this currency.</div>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>

<div class="ws-panel">
    <div class="ws-panel-header">Change Password</div>
    <div class="ws-panel-body">
        @if (Model.PasswordMessage != null)
        {
            <div class="alert alert-success">@Model.PasswordMessage</div>
        }
        @if (Model.PasswordErrorMessage != null)
        {
            <div class="alert alert-danger">@Model.PasswordErrorMessage</div>
        }
        <form method="post" asp-page-handler="ChangePassword" style="max-width: 420px;">
            <div class="mb-3">
                <label class="form-label" asp-for="PasswordInput.CurrentPassword">Current password</label>
                <input asp-for="PasswordInput.CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                <span asp-validation-for="PasswordInput.CurrentPassword" class="validation-message"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="PasswordInput.NewPassword">New password</label>
                <input asp-for="PasswordInput.NewPassword" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="PasswordInput.NewPassword" class="validation-message"></span>
                <div class="text-muted mt-1" style="font-size: 13px;">At least 12 characters.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="PasswordInput.ConfirmNewPassword">Confirm new password</label>
                <input asp-for="PasswordInput.ConfirmNewPassword" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="PasswordInput.ConfirmNewPassword" class="validation-message"></span>
            </div>
            <button type="submit" class="btn btn-primary">Change password</button>
        </form>
    </div>
</div>
